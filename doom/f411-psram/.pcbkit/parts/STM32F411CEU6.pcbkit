    PC15: io.bidirectional(),
    PH0: io.bidirectional(),
    PH1: io.bidirectional(),
    NRST: io.input(pull = .up),
    VSSA: .ground,
    VDDA: io.powerIn(min = 1.7V, max = 4V),
    PA0: io.bidirectional(),
    PA1: io.bidirectional(),
    PA2: io.bidirectional(),
    PA3: io.bidirectional(),
    PA4: io.bidirectional(),
    PA5: io.bidirectional(),
    PA6: io.bidirectional(),
    PA7: io.bidirectional(),
    PB0: io.bidirectional(),
    PB1: io.bidirectional(),
    PB2: io.bidirectional(),
    PB10: io.bidirectional(),
    VCAP1: .powerOut,
    VSS: .ground,
    VDD: io.powerIn(min = 1.7V, max = 4V),
    PB12: io.bidirectional(),
    PB13: io.bidirectional(),
    PB14: io.bidirectional(),
    PB15: io.bidirectional(),
    PA8: io.bidirectional(),
    PA9: io.bidirectional(),
    PA10: io.bidirectional(),
    PA11: io.bidirectional(),
    PA12: io.bidirectional(),
    PA13: io.bidirectional(),
    PA14: io.bidirectional(),
    PA15: io.bidirectional(),
    PB3: io.bidirectional(),
    PB4: io.bidirectional(),
    PB5: io.bidirectional(),
    PB6: io.bidirectional(),
    PB7: io.bidirectional(),
    BOOT0: io.input(),
    PB8: io.bidirectional(),
    PB9: io.bidirectional(),
  },
) with {
