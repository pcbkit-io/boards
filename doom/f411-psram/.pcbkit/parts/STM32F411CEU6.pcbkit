    Status: "verified",
    PinoutSource: "verified: STM32_open_pin_data STM32F411C(C-E)Ux (7d1f1514ed55); pad 49 (the exposed die pad, to ground) from the datasheet note to the UFQFPN48 outline; STM32F411xC/xE datasheet DocID026289 Rev 4: power supply scheme, VCAP1, UFQFPN48 mechanical data and exposed pad note",
    Datasheet: "https://www.st.com/resource/en/datasheet/stm32f411ce.pdf",
  }
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "stm32f411ce"
      ports = {
        "PA0": ["10"],
