let Y1Crystal = crystal(25MHz, load = crystalLoad(10pF), package = "3225")

let Y2Crystal = crystal(32.768kHz, load = crystalLoad(12.5pF), package = "3225")

/// The support circuit of the STM32F411CEU6 as its datasheet shows it (6.1.6 power supply scheme
/// (figure 17), 6.3.2 VCAP1 external capacitor (table 16), 6.1.1x HSE): every part next to the pin
/// it serves. Add it next to the part: `U1 = STM32F411CEU6.Part { … }`, `U1Support =
/// STM32F411CEU6.Support(U1) {}`.
///
/// - VDDA must be at the same potential as VDD: to VDD through a ferrite bead or directly, with 100
/// nF + 1 uF next to the pin.
///
/// - VCAP1 is the internal regulator's output: only its 4.7 uF low-ESR ceramic, never a load or
/// another supply.
///
/// - USB device: PA11 = D-, PA12 = D+ straight to the connector (the OTG FS PHY has its own
/// pull-up); USB needs the HSE crystal for a 48 MHz clock.
///
/// - SWD programming: PA13 SWDIO, PA14 SWCLK, NRST, 3V3, GND on a header.
block Support(
  /// The STM32F411CEU6 this circuit serves (`STM32F411CEU6.Support(U1)`).
  chip: Any,
  /// The 25MHz crystal.
  crystal: Bool = true,
  /// The 32.768 kHz crystal.
  lse: Bool = false,
) {
  /// HSE crystal, load capacitors per its CL; its CL: 10pF here, change `load` to the chosen
  /// crystal's
  Y1 =
    if crystal then Y1Crystal {
      place = [soft(near(chip, max = 4mm), weight = 2)]
      pins { X1: chip.pin.PH0, X2: chip.pin.PH1, GND: chip.pin.VSSA }
    }
    else null
  Y1_C1 =
    if crystal then cap(loadCapacitor(crystalLoad(10pF), stray = 3pF), package = "0402") {
      place = [soft(near(Y1.pin.X1, max = 2.5mm), weight = 2)]
      pins { a: chip.pin.PH0, b: chip.pin.VSSA }
    }
    else null
  Y1_C2 =
    if crystal then cap(loadCapacitor(crystalLoad(10pF), stray = 3pF), package = "0402") {
      place = [soft(near(Y1.pin.X2, max = 2.5mm), weight = 2)]
      pins { a: chip.pin.PH1, b: chip.pin.VSSA }
    }
    else null
  /// optional LSE for the RTC; its CL: 12.5pF here, change `load` to the chosen crystal's
  Y2 =
    if lse then Y2Crystal {
      place = [soft(near(chip, max = 4mm), weight = 2)]
      pins { X1: chip.pin.PC14, X2: chip.pin.PC15, GND: chip.pin.VSSA }
    }
    else null
  Y2_C1 =
    if lse then cap(loadCapacitor(crystalLoad(12.5pF), stray = 3pF), package = "0402") {
      place = [soft(near(Y2.pin.X1, max = 2.5mm), weight = 2)]
      pins { a: chip.pin.PC14, b: chip.pin.VSSA }
    }
    else null
  Y2_C2 =
    if lse then cap(loadCapacitor(crystalLoad(12.5pF), stray = 3pF), package = "0402") {
      place = [soft(near(Y2.pin.X2, max = 2.5mm), weight = 2)]
      pins { a: chip.pin.PC15, b: chip.pin.VSSA }
    }
    else null
  /// X7R, one per VDD pin (24, 36, 48)
  C1_C3_24 = cap(100nF, package = "0402", dielectric = .X7R) {
    place = [soft(near(chip["24"], max = 2mm), weight = 2)]
    pins { a: chip["24"], b: chip.pin.VSS }
  }
  /// X7R, one per VDD pin (24, 36, 48)
  C1_C3_36 = cap(100nF, package = "0402", dielectric = .X7R) {
    place = [soft(near(chip["36"], max = 2mm), weight = 2)]
    pins { a: chip["36"], b: chip.pin.VSS }
  }
  /// X7R, one per VDD pin (24, 36, 48)
  C1_C3_48 = cap(100nF, package = "0402", dielectric = .X7R) {
    place = [soft(near(chip["48"], max = 2mm), weight = 2)]
    pins { a: chip["48"], b: chip.pin.VSS }
  }
  /// ceramic, on one VDD pin
  C4 = cap(4.7uF, package = "0805") {
    place = [soft(near(chip.pin.VDD, max = 4mm), weight = 2)]
    pins { a: chip.pin.VDD, b: chip.pin.VSS }
  }
  /// ceramic, ESR < 1 ohm
  C5 = cap(4.7uF, package = "0805") {
    place = [soft(near(chip.pin.VCAP1, max = 4mm), weight = 2)]
    pins { a: chip.pin.VCAP1, b: chip.pin.VSS }
  }
  C6 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDDA, max = 2mm), weight = 2)]
    pins { a: chip.pin.VDDA, b: chip.pin.VSSA }
  }
  C7 = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.VDDA, max = 2mm), weight = 2)]
    pins { a: chip.pin.VDDA, b: chip.pin.VSSA }
  }
  /// optional, reset filter
  C8 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.NRST, max = 2mm), weight = 2)]
    pins { a: chip.pin.NRST, b: chip.pin.VSS }
  }
  R1 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.BOOT0, max = 5mm), weight = 1)]
    pins { a: chip.pin.BOOT0, b: chip.pin.VSS }
  }
}
