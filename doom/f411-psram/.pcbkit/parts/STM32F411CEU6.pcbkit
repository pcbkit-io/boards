pcbkit 1

// STM32F411CEU6 (STMicroelectronics): Arm Cortex-M4 MCU with FPU, 100 MHz, 512 KB flash, 128 KB
// RAM, USB OTG full speed, 12-bit ADC, 3 USART, 5 SPI/I2S, 3 I2C, SDIO, 1.7-3.6 V, UFQFPN48 (the
// WeAct Black Pill chip)
// Compiled from the part sheet `parts/STM32F411CEU6.json` (`parts.create`); status: verified.
// Datasheet: https://www.st.com/resource/en/datasheet/stm32f411ce.pdf (DocID026289 Rev 4 (February
// 2015))
// Pins: STM32_open_pin_data STM32F411C(C-E)Ux (7d1f1514ed55); pad 49 (the exposed die pad, to
// ground) from the datasheet note to the UFQFPN48 outline; STM32F411xC/xE datasheet DocID026289
// Rev 4: power supply scheme, VCAP1, UFQFPN48 mechanical data and exposed pad note (verified)
// Footprint: as given
// Symbol: partreel 727317920912f655720376db0d4dfe6ed7aa06bd antmicro_stm32f411ceu6:STM32F411CEU6
// (MIT), https://github.com/mingyo186/partreel
// Parameters: stm32-open-pin-data mcu/STM32F411C(C-E)Ux.xml (BSD-3-Clause),
// https://github.com/STMicroelectronics/STM32_open_pin_data
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: Each VDD pin gets its own 100 nF next to it, one 4.7 uF for all; solder the exposed pad to
// ground.
// Note: BOOT0 low boots from flash; BOOT0 high at reset starts the ROM bootloader (USART1
// PA9/PA10, USB DFU on PA11/PA12), the Black Pill's BOOT button.
// Note: PC13, PC14, PC15 sink or source 3 mA at most: an LED at most.
// Note: Most I/Os are 5 V tolerant (FT); the analog-capable pins are not when used as analog.
// Note: The WeAct Black Pill uses a 25 MHz HSE and a 32.768 kHz LSE.

/// STM32F411CEU6 — Arm Cortex-M4 MCU with FPU, 100 MHz, 512 KB flash, 128 KB RAM, USB OTG full
/// speed, 12-bit ADC, 3 USART, 5 SPI/I2S, 3 I2C, SDIO, 1.7-3.6 V, UFQFPN48 (the WeAct Black Pill
/// chip)
part Part = device(
  footprint = qfn(48, size = (7mm, 7mm), ep = (5.6mm, 5.6mm)),
  prefix = "U",
  mpn = "STM32F411CEU6",
  manufacturer = "STMicroelectronics",
  pinout = {
    VBAT: "1",
    PC13: "2",
    PC14: "3",
    PC15: "4",
    PH0: "5",
    PH1: "6",
    NRST: "7",
    VSSA: "8",
    VDDA: "9",
    PA0: "10",
    PA1: "11",
    PA2: "12",
    PA3: "13",
    PA4: "14",
    PA5: "15",
    PA6: "16",
    PA7: "17",
    PB0: "18",
    PB1: "19",
    PB2: "20",
    PB10: "21",
    VCAP1: "22",
    VSS: ["23", "35", "47", "49"],
    VDD: ["24", "36", "48"],
    PB12: "25",
    PB13: "26",
    PB14: "27",
    PB15: "28",
    PA8: "29",
    PA9: "30",
    PA10: "31",
    PA11: "32",
    PA12: "33",
