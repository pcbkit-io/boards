        "GP28": ["34"],
        "GP3": ["5"],
        "GP4": ["6"],
        "GP5": ["7"],
        "GP6": ["9"],
        "GP7": ["10"],
        "GP8": ["11"],
        "GP9": ["12"],
        "power": ["39", "38"],
      }
      parameters = { "flash_mib": 2, "xosc_hz": 12000000 }
      height = 9mm
    }
    parameters = []
  }
}
