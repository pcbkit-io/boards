pcbkit 1

// PCM5102APWR (Texas Instruments): PCM5102A stereo audio DAC, I2S / left-justified up to 384 kHz
// 32-bit, 2.1 Vrms ground-centred line outputs (charge pump), 112 dB, hardware controlled, 3.3 V,
// TSSOP-20
// Compiled from the part sheet `parts/PCM5102APWR.json` (`parts.create`); status: checked.
// Datasheet: https://www.ti.com/lit/ds/symlink/pcm5102a.pdf (SLAS859C, revised May 2015)
// Pins: PCM510xA datasheet SLAS859C: pin functions (p. 5), 8.1 absolute maximum ratings, 8.3
// recommended operating conditions, Figure 33 typical application, 11.1
// Footprint: the standard package `TSSOP-20 (PW)`
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: PCM5101A (lower SNR) and PCM5100A share the pinout. All digital inputs are failsafe
// Schmitt-trigger inputs: 3.3 V I2S from an ESP32 or a Pi works directly.

/// PCM5102APWR — PCM5102A stereo audio DAC, I2S / left-justified up to 384 kHz 32-bit, 2.1 Vrms
/// ground-centred line outputs (charge pump), 112 dB, hardware controlled, 3.3 V, TSSOP-20
part Part = device(footprint = tssop(
  20,
), prefix = "U", mpn = "PCM5102APWR", manufacturer = "Texas Instruments", pinout = {
  CPVDD: "1",
  CAPP: "2",
  CPGND: "3",
  CAPM: "4",
  VNEG: "5",
  OUTL: "6",
  OUTR: "7",
  AVDD: "8",
  AGND: "9",
  DEMP: "10",
  FLT: "11",
  SCK: "12",
  BCK: "13",
  DIN: "14",
  LRCK: "15",
  FMT: "16",
  XSMT: "17",
  LDOO: "18",
  DGND: "19",
  DVDD: "20",
}, pinTypes = {
  CPVDD: io.powerIn(min = 3.1V, max = 3.9V),
  CAPP: .passive,
  CPGND: .ground,
  CAPM: .passive,
  VNEG: .powerOut,
  OUTL: .output,
  OUTR: .output,
  AVDD: io.powerIn(min = 3V, max = 3.9V),
  AGND: .ground,
  DEMP: io.input(max = 3.9V),
  FLT: io.input(max = 3.9V),
  SCK: io.input(max = 3.9V),
  BCK: io.input(max = 3.9V),
  DIN: io.input(max = 3.9V),
  LRCK: io.input(max = 3.9V),
  FMT: io.input(max = 3.9V),
  XSMT: io.input(max = 3.9V),
  LDOO: .powerOut,
  DGND: .ground,
  DVDD: io.powerIn(min = 1.65V, max = 3.9V),
}) with {
  fields {
    Status: "checked",
    PinoutSource: "PCM510xA datasheet SLAS859C: pin functions (p. 5), 8.1 absolute maximum ratings, 8.3 recommended operating conditions, Figure 33 typical application, 11.1",
    Datasheet: "https://www.ti.com/lit/ds/symlink/pcm5102a.pdf",
  }
  simulation = SimulationParameters {
    parameters = [
      SimulationParameter {
        id = "idd-total-48khz-3v3"
        quantity = .supplyCurrent
        typ = 30mA
        conditions = "Playback, 1 kHz -1 dBFS data, fS=48 kHz, 24-bit, AVDD=CPVDD=DVDD=3.3 V, TA=25 degC: sum of AVDD/CPVDD 22 mA and DVDD 8 mA (typ rows (6)); consistent with 99 mW power dissipation row"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/pcm5102a.pdf"
          revision = "SLAS859C, revised May 2015"
          location = "p. 9-10, Electrical Characteristics, Power Supply Requirements IDD rows (6)"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "rthjb-pw"
        quantity = .thetaJb
        typ = 42K/W
        conditions = "RthetaJB junction-to-board, PW 20-pin TSSOP, JEDEC board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/pcm5102a.pdf"
          revision = "SLAS859C, revised May 2015"
          location = "p. 6, section 8.4 Thermal Information"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "tj-operating"
        quantity = .junctionOperatingTemperature
        min = -40degC
        max = 130degC
        conditions = "TJ operating junction temperature range"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/pcm5102a.pdf"
          revision = "SLAS859C, revised May 2015"
          location = "p. 6, section 8.3 Recommended Operating Conditions"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "tj-absolute"
        quantity = .junctionAbsoluteTemperature
        max = 130degC
        conditions = "Operating junction temperature range listed in Absolute Maximum Ratings (-40 to 130 degC)"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/pcm5102a.pdf"
          revision = "SLAS859C, revised May 2015"
          location = "p. 6, section 8.1 Absolute Maximum Ratings"
          confidence = .datasheet
        }
      },
    ]
  }
}

/// The support circuit of the PCM5102APWR as its datasheet shows it (Figure 33 simplified
/// schematic, hardware-controlled subsystem; 10.1.1.2; 11.1 power supply pin descriptions): every
/// part next to the pin it serves. Add it next to the part: `U1 = PCM5102APWR.Part { … }`,
/// `U1Support = PCM5102APWR.Support(U1) {}`.
///
/// - Hardware mode: FLT, DEMP and FMT low (normal latency filter, no de-emphasis, I2S); SCK to
/// ground uses the internal PLL from BCK (3-wire I2S: BCK, LRCK, DIN).
///
/// - XSMT high to play: a pull-up to 3.3 V (10 kΩ) or a GPIO; pulling it low before power is
/// removed avoids a pop.
///
/// - The outputs are ground-centred (charge pump): no DC-blocking capacitors; the 470 Ω + 2.2 nF
/// RC on each output filters out-of-band noise.
///
/// - Separate AGND and DGND near the part, joined under it on one ground plane.
block Support(
  /// The PCM5102APWR this circuit serves (`PCM5102APWR.Support(U1)`).
  chip: Any,
  /// The board's LINE_L. (`null`: its parts are left out)
  lineL: Endpoint? = null,
  /// The board's LINE_R. (`null`: its parts are left out)
  lineR: Endpoint? = null,
) {
  C1 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.AVDD, max = 2mm), weight = 2)]
    pins { a: chip.pin.AVDD, b: chip.pin.AGND }
  }
  C2 = cap(10uF, package = "0805") {
    place = [soft(near(chip.pin.AVDD, max = 4mm), weight = 2)]
    pins { a: chip.pin.AVDD, b: chip.pin.AGND }
  }
  C3 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.CPVDD, max = 2mm), weight = 2)]
    pins { a: chip.pin.CPVDD, b: chip.pin.CPGND }
  }
  C4 = cap(10uF, package = "0805") {
    place = [soft(near(chip.pin.CPVDD, max = 4mm), weight = 2)]
    pins { a: chip.pin.CPVDD, b: chip.pin.CPGND }
  }
  C5 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.DVDD, max = 2mm), weight = 2)]
    pins { a: chip.pin.DVDD, b: chip.pin.DGND }
  }
  C6 = cap(10uF, package = "0805") {
    place = [soft(near(chip.pin.DVDD, max = 4mm), weight = 2)]
    pins { a: chip.pin.DVDD, b: chip.pin.DGND }
  }
  /// charge pump flying capacitor
  C7 = cap(2.2uF, package = "0805") {
    place = [soft(near(chip.pin.CAPP, max = 4mm), weight = 2)]
    pins { a: chip.pin.CAPP, b: chip.pin.CAPM }
  }
  /// negative rail decoupling
  C8 = cap(2.2uF, package = "0805") {
    place = [soft(near(chip.pin.VNEG, max = 4mm), weight = 2)]
    pins { a: chip.pin.VNEG, b: chip.pin.AGND }
  }
  /// internal LDO decoupling
  C9 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.LDOO, max = 2mm), weight = 2)]
    pins { a: chip.pin.LDOO, b: chip.pin.DGND }
  }
  /// output RC filter, left
  R1 =
    if lineL != null then res(470ohm, package = "0402") {
      place = [soft(near(chip.pin.OUTL, max = 5mm), weight = 1)]
      pins { a: chip.pin.OUTL, b: lineL }
    }
    else null
  /// output RC filter, left
  C10 =
    if lineL != null then cap(2.2nF, package = "0402") {
      place = [soft(near(chip, max = 8mm), weight = 1)]
      pins { a: lineL, b: chip.pin.AGND }
    }
    else null
  /// output RC filter, right
  R2 =
    if lineR != null then res(470ohm, package = "0402") {
      place = [soft(near(chip.pin.OUTR, max = 5mm), weight = 1)]
      pins { a: chip.pin.OUTR, b: lineR }
    }
    else null
  /// output RC filter, right
  C11 =
    if lineR != null then cap(2.2nF, package = "0402") {
      place = [soft(near(chip, max = 8mm), weight = 1)]
      pins { a: lineR, b: chip.pin.AGND }
    }
    else null
}
