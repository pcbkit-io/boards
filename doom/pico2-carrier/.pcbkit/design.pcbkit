pcbkit 2

// Doom device 06: the reference device of PCBKit's machine work, as an orderable carrier. A
// Pimoroni Pico Plus 2 (RP2350B, 16 MB flash, 8 MB PSRAM on QMI chip select 1, GPIO47: the full
// game's data and heap; a plain Pico 2 has neither room) on the Pico's sockets, a 2.8"
// 240 x 320 ILI9341 TFT with resistive touch (MSP2807) on SPI0, ten buttons, and a PCM5102A
// I2S DAC (driven by a PIO program) into a 3.5 mm headphone jack. Power: two 18650 cells in
// parallel, charged from the module's USB by a BQ24075 with power path into the module's VSYS.
// Front (top): display, ten buttons, charger. Back (bottom): the module, the cells, the DAC, the
// jack.

use ./parts/PIMORONI_PICO_PLUS_2 as Pico
use ./parts/ILI9341_TFT_2_8_TOUCH as ILI9341_TFT_2_8_TOUCH
use ./parts/PCM5102APWR as PCM5102APWR
use ./parts/SJ1_3525N as SJ1_3525N
use ./parts/KEYSTONE_1042 as Holder
use ./parts/BQ24075RGT as Charger
use ./parts/DW01A as Protection
use ./parts/D_1N5819HW as Schottky
use ./parts/MSK12C02 as Slide
use ./parts/AO3401A as Pfet
use ./parts/PCBKIT_LOGO as Logo

// Power: USB 5 V (the module's VBUS) into the charger; its power path (SYS: the input when there
// is one, else the cells) through a Schottky into the module's VSYS, beside the module's own VBUS
// diode. The two cells in parallel (1S2P, 3.0-4.2 V) behind one protection circuit; the pack's
// minus is the board's ground.
net VBUS { voltage = 5V }
// SYS feeds the module (RP2350, PSRAM, flash), the screen's backlight and the DAC: about 150 mA.
net SYS {
  voltage = 5V
  current = 300mA
}
net VSYS { voltage = 4.2V }
net BAT {
  voltage = 4.2V
  current = 800mA
}
net BAT_IN {
  voltage = 4.2V
  current = 800mA
}
net CELL_N { current = 800mA }
// Each cell's + joins BAT_IN through its own resettable fuse (F1, F2): a cell put in the wrong
// way round, or one at another charge, drives the other through the two fuses, which trip in
// milliseconds (one cell alone carries all of it).
net CELL1_P {
  voltage = 4.2V
  current = 800mA
}
net CELL2_P {
  voltage = 4.2V
  current = 800mA
}
net V3 { voltage = 3.3V }
net GND { voltage = 0V }
// The DAC's own rails: its charge pump's negative supply and its digital core's LDO.
net DAC_VNEG { voltage = -3.3V }
net DAC_LDO {
  voltage = 1.8V
  current = 10mA
}
// The power paths: wide tracks, vias that carry an ampere.
powerClass = NetClass {
  name = "power"
  trackWidth = 0.6mm
  viaDiameter = 0.8mm
  viaDrill = 0.4mm
  nets = [VBUS, SYS, VSYS, BAT, BAT_IN, CELL1_P, CELL2_P, CELL_N]
}
net PWR_EN, CHG_N, PG_N, CHG_LED, PG_LED, ISET, ILIM, TS
net SCK, MOSI, MISO, LCD_CS, LCD_DC, LCD_RST, LCD_BL, T_CS, T_IRQ
net I2S_BCK, I2S_LRCK, I2S_DIN, DAC_MUTE, LINE_L, LINE_R
net UP, DOWN, LEFT, RIGHT, FIRE, USE, STRAFE_L, STRAFE_R, MENU, ENTER

board = Board {
  name = "doom-06-pico2-carrier"
  description = "Pico Plus 2 carrier (RP2350) · 2.8in ILI9341 touch · 10 buttons · PCM5102A · 2 x 18650, USB charging"
  outline = rect(160mm, 100mm, radius = 6mm)
}
laboratory = Laboratory { world = "input.js" }

// ---- processor (back): the module on two 20-pin sockets under the display, USB at the top edge ----
// The program is doom/; the game's data, id Software's shareware DOOM1.WAD (free to share
// unmodified), is linked into its flash from where it is published.
U1 = Pico.PIMORONI_PICO_PLUS_2 with {
  simulation = Pico.PIMORONI_PICO_PLUS_2.simulation with {
    behavior = Pico.PIMORONI_PICO_PLUS_2.simulation.behavior with {
      firmware = "doom"
      data = {
        "DOOM1.WAD" = FirmwareData {
          url = "https://raw.githubusercontent.com/Akbar30Bill/DOOM_wads/9b384dc68add3eb2f5eb7754654cafeeaea5103b/doom1.wad"
          sha256 = "1d7d43be501e67d927e415e0b8f3e29c3bf33075e859721816f652a526cac771"
          bytes = 4196020
        }
      }
    }
  }
} {
  at = (48mm, 73.2mm)
  rotation = 0deg
  side = .bottom
  // The two 1x20 sockets it plugs into (the module itself: Pimoroni PIM724, bought separately).
  orderCode = "C2905423"

  GND -- GND
  AGND -- GND
  P3V3 -- V3
  VSYS -- VSYS
  VBUS -- VBUS
  P3V3_EN -- PWR_EN
  RUN -- .nc
  ADC_VREF -- .nc
  GP18 -- SCK
  GP19 -- MOSI
  GP16 -- MISO
  GP17 -- LCD_CS
  GP20 -- LCD_DC
  GP21 -- LCD_RST
  GP22 -- LCD_BL
  GP13 -- T_CS
  GP14 -- T_IRQ
  GP10 -- I2S_BCK
  GP11 -- I2S_LRCK
  GP12 -- I2S_DIN
  GP15 -- DAC_MUTE
  GP0 -- UP
  GP1 -- DOWN
  GP2 -- LEFT
  GP3 -- RIGHT
  GP4 -- FIRE
  GP5 -- USE
  GP6 -- STRAFE_L
  GP7 -- STRAFE_R
  GP8 -- MENU
  GP9 -- ENTER
}

// ---- display (front): the LCD and the touch controller share SPI0 -------------------------------
DS1 = ILI9341_TFT_2_8_TOUCH.ILI9341_TFT_2_8_TOUCH {
  at = (122mm, 69mm)
  rotation = 90deg
  // The 1x14 socket it plugs into (the module: an MSP2807, bought separately).
  orderCode = "C2905420"

  VCC -- V3
  GND -- GND
  CS -- LCD_CS
  RESET -- LCD_RST
  DC -- LCD_DC
  SDI -- MOSI
  SCK -- SCK
  LED -- LCD_BL
  SDO -- MISO
  T_CLK -- SCK
  T_CS -- T_CS
  T_DIN -- MOSI
  T_DO -- MISO
  T_IRQ -- T_IRQ
}
R1 = res(10kohm, package = "0603") {
  side = .bottom
  orderCode = "C25804"
  a -- T_CS
  b -- V3
}
R2 = res(10kohm, package = "0603") {
  side = .bottom
  orderCode = "C25804"
  a -- LCD_CS
  b -- V3
}
R3 = res(10kohm, package = "0603") {
  side = .bottom
  orderCode = "C25804"
  a -- T_IRQ
  b -- V3
}

// ---- audio (back): PCM5102A in hardware mode (I2S, PLL from BCK) -> headphone jack --------------
U2 = PCM5102APWR.PCM5102APWR {
  side = .bottom
  orderCode = "C107671"

  AVDD -- V3
  CPVDD -- V3
  DVDD -- V3
  AGND -- GND
  CPGND -- GND
  DGND -- GND
  VNEG -- DAC_VNEG
  LDOO -- DAC_LDO
  BCK -- I2S_BCK
  LRCK -- I2S_LRCK
  DIN -- I2S_DIN
  SCK -- GND
  FLT -- GND
  DEMP -- GND
  FMT -- GND
  XSMT -- DAC_MUTE
}
U2Support = PCM5102APWR.Support {
  chip = U2
  lineL -- LINE_L
  lineR -- LINE_R
  side = .bottom
}
R4 = res(10kohm, package = "0603") {
  side = .bottom
  orderCode = "C25804"
  a -- DAC_MUTE
  b -- V3
}
J1 = SJ1_3525N.SJ1_3525N {
  side = .bottom
  orderCode = "C4991936"
  place = [edge(.right)]
  SLEEVE -- GND
  TIP -- LINE_L
  RING -- LINE_R
  TIP_SW -- .nc
  RING_SW -- .nc
}

// ---- power: two 18650 cells on the back, side by side along the bottom, in parallel -------------
// The holders are not polarized: put each cell's + at the end the silkscreen marks.
BT1 = Holder.KEYSTONE_1042 {
  orderCode = "C5249310"
  at = (80mm, 13mm)
  side = .bottom
  C2 -- CELL1_P
  C1 -- CELL_N
}
BT2 = Holder.KEYSTONE_1042 {
  orderCode = "C5249310"
  at = (80mm, 35mm)
  side = .bottom
  C2 -- CELL2_P
  C1 -- CELL_N
}
// Per-cell protection: a 2 A resettable fuse (16 V, 100 A interrupt) at each holder's + contact.
F1 = fuse(2A, package = "1812", mpn = "1812L200/16GR") {
  orderCode = "C18198340"
  side = .bottom
  place = [soft(near(BT1.pin.C2, max = 20mm), weight = 3)]
  a -- CELL1_P
  b -- BAT_IN
}
F2 = fuse(2A, package = "1812", mpn = "1812L200/16GR") {
  orderCode = "C18198340"
  side = .bottom
  place = [soft(near(BT2.pin.C2, max = 20mm), weight = 3)]
  a -- CELL2_P
  b -- BAT_IN
}
cellMarks = [
  Text { text = "+", at = (33mm, 13mm), size = 2.5mm, layer = Silk.bottom },
  Text { text = "-", at = (127mm, 13mm), size = 2.5mm, layer = Silk.bottom },
  Text { text = "+", at = (33mm, 35mm), size = 2.5mm, layer = Silk.bottom },
  Text { text = "-", at = (127mm, 35mm), size = 2.5mm, layer = Silk.bottom },
  Text {
    text = "2 x 18650 Li-ion 3.7 V"
    at = (136mm, 24mm)
    size = 1.5mm
    rotation = 90deg
    layer = Silk.bottom
  },
]

// A cell put in the wrong way round: a P-MOSFET in the plus line, its gate at the cells' minus,
// on (both ways: charging too) only when the cells are the right way round.
reversed = ReversePolarity {
  vin = BAT_IN
  vout = BAT
  gnd = CELL_N
  inputVoltage = 4.2V
  current = 800mA
  rdsOn = 60mohm
  maxGateVoltage = 12V
  fet = Pfet.AO3401A with { orderCode = "C15127" }
}

// Protection: over-charge 4.3 V, over-discharge 2.4 V, over-current about 3 A, in the pack's minus.
U3 = Protection.DW01A {
  orderCode = "C351410"
  GND -- CELL_N
}
U3Support = Protection.Support {
  chip = U3
  batteryPlus -- BAT
  packMinus -- GND
}

// The charger (BQ24075, datasheet SLUS810): USB500 mode (EN1 high, EN2 low: at most 500 mA from
// any port), 800 mA fast charge (RISET = 890 AΩ / 0.8 A), its current-based termination; SYSOFF
// low (the cells always connected); the safety timers off (TMR to VSS): two cells charge longer
// than its longest timer. TS: 10 kΩ without an NTC.
U4 = Charger.BQ24075RGT {
  at = (80mm, 30mm)
  IN -- VBUS
  OUT -- SYS
  BAT -- BAT
  VSS -- GND
  nCE -- GND
  EN1 -- SYS
  EN2 -- GND
  TMR -- GND
  ISET -- ISET
  ILIM -- ILIM
  SYSOFF -- GND
  TS -- TS
  nCHG -- CHG_N
  nPGOOD -- PG_N
}
cIn = cap(1uF, package = "0603", ratedVoltage = 16V) {
  orderCode = "C15849"
  at = (81.55mm, 33mm)
  rotation = 180deg
  place = [near(U4.pin.IN, max = 3.5mm)]
  a -- VBUS
  b -- GND
}
cSys = cap(4.7uF, package = "0805", ratedVoltage = 10V) {
  orderCode = "C1779"
  place = [soft(near(U4.pin.OUT, max = 4mm), weight = 2)]
  a -- SYS
  b -- GND
}
cBat = cap(4.7uF, package = "0805", ratedVoltage = 10V) {
  orderCode = "C1779"
  place = [soft(near(U4.pin.BAT, max = 4mm), weight = 2)]
  a -- BAT
  b -- GND
}
rIset = res(1.13kohm, package = "0402", tolerance = 1%) {
  orderCode = "C67014"
  place = [soft(near(U4.pin.ISET, max = 5mm))]
  a -- ISET
  b -- GND
}
rIlim = res(1.18kohm, package = "0402", tolerance = 1%) {
  orderCode = "C270651"
  place = [soft(near(U4.pin.ILIM, max = 5mm))]
  a -- ILIM
  b -- GND
}
rTs = res(10kohm, package = "0402") {
  orderCode = "C25744"
  place = [soft(near(U4.pin.TS, max = 5mm))]
  a -- TS
  b -- GND
}
// Charging (red) and USB present (green), each through 1.5 kΩ.
ledChg = led(package = "0603", color = .red) {
  orderCode = "C2286"
  at = (75mm, 36.5mm)
  A -- SYS
  K -- CHG_LED
}
rChg = res(1.5kohm, package = "0402") {
  orderCode = "C25867"
  place = [soft(near(ledChg, max = 3mm))]
  a -- CHG_LED
  b -- CHG_N
}
ledPg = led(package = "0603", color = .green) {
  orderCode = "C12624"
  at = (85mm, 36.5mm)
  A -- SYS
  K -- PG_LED
}
rPg = res(1.5kohm, package = "0402") {
  orderCode = "C25867"
  place = [soft(near(ledPg, max = 3mm))]
  a -- PG_LED
  b -- PG_N
}
chargeLabel = Text {
  text = "CHG    USB"
  at = (80mm, 43mm)
  size = 1mm
}

// The power path into the module's VSYS, beside its own VBUS diode.
D1 = Schottky.D_1N5819HW {
  orderCode = "C82544"
  place = [soft(near(U1.pin.VSYS, max = 15mm))]
  A -- SYS
  K -- VSYS
}

// On/off: the switch holds the module's 3V3_EN low (its regulator off, the cells still charging).
SW11 = Slide.MSK12C02 {
  at = (1.9mm, 30mm)
  rotation = 90deg
  COM -- PWR_EN
  A -- GND
  SHELL -- GND
}
switchLabel = Text {
  text = "ON / OFF"
  at = (6mm, 34mm)
  size = 1mm
  rotation = 90deg
}

// ---- input (front): d-pad, strafe pair above it, fire/use, menu/enter ----------------------------
// A tactile switch that pulls its line to ground, operated by `code` while the device runs.
fn key(code: String) -> Part = button("6x6") with {
  orderCode = "C221880"
  simulation = SimulationParameters {
    behavior = Behavior { model = "button", ports = { output = ["1"] }, key = code }
  }
}
SW1 = key("ArrowUp") {
  at = (20mm, 76mm)
  a -- UP
  b -- GND
}
SW2 = key("ArrowDown") {
  at = (20mm, 56mm)
  a -- DOWN
  b -- GND
}
SW3 = key("ArrowLeft") {
  at = (10mm, 66mm)
  a -- LEFT
  b -- GND
}
SW4 = key("ArrowRight") {
  at = (30mm, 66mm)
  a -- RIGHT
  b -- GND
}
SW5 = key("Comma") {
  at = (13mm, 90mm)
  a -- STRAFE_L
  b -- GND
}
SW6 = key("Period") {
  at = (27mm, 90mm)
  a -- STRAFE_R
  b -- GND
}
SW7 = key("KeyF") {
  at = (151mm, 71mm)
  a -- FIRE
  b -- GND
}
SW8 = key("Space") {
  at = (140mm, 61mm)
  a -- USE
  b -- GND
}
SW9 = key("KeyM") {
  at = (138mm, 88mm)
  a -- MENU
  b -- GND
}
SW10 = key("Enter") {
  at = (151mm, 88mm)
  a -- ENTER
  b -- GND
}

// Bring-up: the cells, the power path, 3.3 V and ground on test pads.
tpBat = testPoint() {
  at = (125mm, 38mm)
  pins = [BAT]
}
tpSys = testPoint() {
  at = (131mm, 38mm)
  pins = [SYS]
}
tpV3 = testPoint() {
  at = (137mm, 38mm)
  pins = [V3]
}
tpGnd = testPoint() {
  at = (143mm, 38mm)
  pins = [GND]
}
tpLabel = Text {
  text = "BAT SYS 3V3 GND"
  at = (134mm, 34.5mm)
  size = 1mm
}

// Four M3 holes for a back plate or a case.
H1 = hole("M3") { at = (5mm, 5mm) }
H2 = hole("M3") { at = (155mm, 5mm) }
H3 = hole("M3") { at = (5mm, 95mm) }
H4 = hole("M3") { at = (155mm, 95mm) }

gndPour = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}

// PCBKit's mark and pcbkit.io, where the board has room.
logo = Logo.PCBKIT_LOGO {}

reversed.Rg.orderCode = "C25741"
U2Support.C1.orderCode = "C1525"
U2Support.C2.orderCode = "C15850"
U2Support.C3.orderCode = "C1525"
U2Support.C4.orderCode = "C15850"
U2Support.C5.orderCode = "C1525"
U2Support.C6.orderCode = "C15850"
U2Support.C7.orderCode = "C87994"
U2Support.C8.orderCode = "C87994"
U2Support.C9.orderCode = "C1525"
U2Support.R1.orderCode = "C25117"
U2Support.C10.orderCode = "C1531"
U2Support.R2.orderCode = "C25117"
U2Support.C11.orderCode = "C1531"
// The DAC's three supplies decoupled at their pins.
U2Support.C1.place = [near(U2.pin.AVDD, max = 2.5mm)]
U2Support.C3.place = [near(U2.pin.CPVDD, max = 2.5mm)]
U2Support.C5.place = [near(U2.pin.DVDD, max = 2.5mm)]

// The screen module stands on its socket above the pins and pegs that come through the board under
// it: KiCad's pth/npth_inside_courtyard waived between them.
ScreenOverBack = Rule {
  select = ofComponent(DS1) and onB(anyOf([ofComponent(U1), ofComponent(BT2)]))
  reason = "the screen module stands on its socket above the pins and pegs that come through the board under it"
  limits = { courtyardClearance = limit(min = -100mm) }
}
