(version 1)
(rule "ScreenOverBack"
	(constraint courtyard_clearance (min -100mm))
	(condition "(A.Reference == 'DS1') && ((B.Reference == 'BZ1') || (B.Reference == 'BT2'))"))
(rule "J1: pads by its own holes"
	(constraint hole_clearance (min 0mm))
	(condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')"))
