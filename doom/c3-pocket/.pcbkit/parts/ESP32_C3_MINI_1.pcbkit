/// The support circuit of the ESP32-C3-MINI-1-N4X as its datasheet shows it (9 Peripheral
/// Schematics (p. 34)): every part next to the pin it serves. Add it next to the part: `U1 =
/// ESP32_C3_MINI_1.ESP32_C3_MINI_1 { … }`, `U1Support = ESP32_C3_MINI_1.Support(U1) {}`.
///
/// - EN RC delay (10 kohm to 3V3, 1 uF to GND); a reset button may pull EN to GND.
///
/// - USB: IO18 = D-, IO19 = D+ to a USB connector (USB Serial/JTAG: flashing and console without a
/// bridge chip).
///
/// - Optional 32.768 kHz crystal on IO0/IO1 with 12 pF load capacitors.
block Support {
  /// The ESP32-C3-MINI-1-N4X this circuit serves (`ESP32_C3_MINI_1.Support(U1)`).
  chip: Any
  /// A RESET button pulling EN to GND.
  resetButton: Bool = true
  /// A BOOT button pulling IO9 to GND.
  bootButton: Bool = true

  /// bulk at the 3V3 pin
  C1 = cap(10uF, package = "0805") {
    place = [soft(near(chip.pin.P3V3, max = 4mm), weight = 2)]
    a -- chip.pin.P3V3
    b -- chip.pin.GND
  }
  C2 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.P3V3, max = 2mm), weight = 2)]
    a -- chip.pin.P3V3
    b -- chip.pin.GND
  }
  /// EN RC delay
  R1 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.EN, max = 5mm), weight = 1)]
    a -- chip.pin.EN
    b -- chip.pin.P3V3
  }
  /// EN RC delay
  C3 = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.EN, max = 2mm), weight = 2)]
    a -- chip.pin.EN
    b -- chip.pin.GND
  }
  /// strapping pin pulled up
  R_IO2 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.IO2, max = 5mm), weight = 1)]
    a -- chip.pin.IO2
    b -- chip.pin.P3V3
  }
  /// strapping pin pulled up
  R_IO8 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.IO8, max = 5mm), weight = 1)]
    a -- chip.pin.IO8
    b -- chip.pin.P3V3
  }
  SW1 = if resetButton then button("6x6") { a -- chip.pin.EN, b -- chip.pin.GND } else null
  /// held at reset: download mode
  SW2 = if bootButton then button("6x6") { a -- chip.pin.IO9, b -- chip.pin.GND } else null
}
