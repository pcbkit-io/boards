pcbkit 1

// Doom device 03: a pocket handheld on an ESP32-C3-MINI-1 module (single-core RISC-V RV32IMC at
// 160 MHz, 400 KB SRAM, 4 MB flash in the module): the RP2040-style cut-down Doom (compressed
// WAD in flash, tables in flash, a single-buffered 8-bit frame). A 1.3" 240 x 240 ST7789 IPS on
// SPI, eight buttons, a piezo, two 18650 cells in parallel behind DW01A/FS8205A protection, a
// BQ24075 charger with power path from the USB-C port, and an AP2112K LDO switched by its enable.
// USB-C goes straight to the C3's USB Serial/JTAG: esptool flashes it, no bridge chip. Portrait,
// Game Boy style. Front (top): display, buttons, USB-C, charger. Back (bottom): the cells, the
// module (top edge, antenna away from the hand), the piezo.

use "parts/ESP32_C3_MINI_1.pcbkit" as ESP32_C3_MINI_1
use "parts/ST7789_TFT_1_3.pcbkit" as ST7789_TFT_1_3
use "parts/AP2112K_3_3.pcbkit" as AP2112K_3_3
use "parts/GPC12075YB_5V.pcbkit" as GPC12075YB_5V
use "parts/KEYSTONE_1042.pcbkit" as Holder
use "parts/BQ24075RGT.pcbkit" as Charger
use "parts/DW01A.pcbkit" as Protection
use "parts/MSK12C02.pcbkit" as Slide
use "parts/AO3401A.pcbkit" as Pfet
use "parts/PCBKIT_LOGO.pcbkit" as Logo

// Power: USB-C 5 V into the charger; its power path (SYS: the input when there is one, else the
// cells) into the 3.3 V LDO. The two cells in parallel (1S2P, 3.0-4.2 V) behind one protection
// circuit; the pack's minus is the board's ground.
net VBUS { voltage = 5V; current = 500mA }
// SYS feeds the LDO: the C3 and the screen draw about 60 mA (Wi-Fi off; 350 mA peaks with it).
net SYS { voltage = 5V; current = 350mA }
// The cells' current: a linear charger passes on at most what it takes in, and USB500 mode takes
// at most 500 mA, so the 800 mA ISET sets is never reached from USB.
net BAT { voltage = 4.2V; current = 500mA }
net BAT_IN { voltage = 4.2V; current = 500mA }
net CELL_N { current = 500mA }
// Each cell's + joins BAT_IN through its own resettable fuse (F2, F3): a cell put in the wrong
// way round, or one at another charge, drives the other through the two fuses, which trip in
// milliseconds (one cell alone carries all of it).
net CELL1_P { voltage = 4.2V; current = 500mA }
net CELL2_P { voltage = 4.2V; current = 500mA }
net V3 { voltage = 3.3V }
net GND { voltage = 0V }
// The power paths: wide tracks, vias that carry an ampere.
powerClass = NetClass {
  name = "power"
  trackWidth = 0.6mm
  viaDiameter = 0.8mm
  viaDrill = 0.4mm
  nets = [VBUS, SYS, BAT, BAT_IN, CELL1_P, CELL2_P, CELL_N]
}
// Ground carries the charge current back to the cells' minus (with the pours on both sides): its
// vias 0.5 mm.
groundClass = NetClass {
  name = "ground"
  viaDiameter = 1mm
  viaDrill = 0.5mm
  nets = [GND]
}
net LDO_EN, CHG_N, PG_N, CHG_LED, PG_LED, ISET, ILIM, TS
net DP, DN, EN
net SCK, MOSI, LCD_DC, LCD_RST, BUZZ
net UP, DOWN, LEFT, RIGHT, FIRE, USE, STRAFE, MENU

board = Board {
  name = "doom-03-c3-pocket"
  description = "ESP32-C3 RISC-V · 1.3in ST7789 240x240 · 2 x 18650, USB-C charging"
  outline = rect(52mm, 128mm, radius = 5mm)
}
laboratory = Laboratory { world = "input.js" }

// ---- processor (back, top edge: the antenna past the edge, away from the hand) ----------------
// The program is doom/ (rp2040-doom's engine); its data, rp2040-doom's compressed shareware WAD
// (DOOM1.WHX, id Software's data, free to share unmodified), is linked into the module's 4 MB flash.
U1 = ESP32_C3_MINI_1.Part with {
  mpn = "ESP32-C3-MINI-1-H4"
  simulation = ESP32_C3_MINI_1.Part.simulation with { behavior = ESP32_C3_MINI_1.Part.simulation.behavior with {
    firmware = "doom"
    data = { "DOOM1.WHX": FirmwareData {
      url = "https://raw.githubusercontent.com/kilograham/rp2040-doom/29a453c980918a03e40fc8b69b024e7a3bdb5dc2/doom1.whx"
      sha256 = "87ea79020578fa2e72fc204f67ff2ce45bd73a266a369670da7a019028b0d893"
      bytes = 1800344
    } }
  } }
} {
  side = .bottom
  at = (42.5mm, 119.2mm)
  // The -H4: the same module with the same 4 MB flash, rated to 105 °C (the -N4 is out of stock).
  orderCode = "C2934569"
  pins {
    GND: GND, P3V3: V3, EN: EN, NC: .nc,
    IO18: DN, IO19: DP,
    IO6: SCK, IO7: MOSI, IO5: LCD_DC, IO4: LCD_RST, IO8: BUZZ,
    IO0: UP, IO1: DOWN, IO2: LEFT, IO3: RIGHT, IO10: FIRE, RXD0: USE, TXD0: STRAFE, IO9: MENU,
  }
}
// The datasheet's peripheral circuit: decoupling, the EN RC, pull-ups on IO2 and IO8, RESET.
// BOOT is the MENU button on the front (IO9 low at reset = download mode).
U1Support = ESP32_C3_MINI_1.Support(U1, bootButton = false) { side = .bottom }
override U1Support.C2.place = [near(U1.pin.P3V3, max = 2.5mm)]

// ---- display (front, upper part) ---------------------------------------------------------------
DS1 = ST7789_TFT_1_3.Part {
  at = (25mm, 118mm)
  // The 1x7 socket it plugs into (the module: a 1.3" 240 x 240 ST7789 SPI IPS board, bought separately).
  orderCode = "C2932672"
  pins { GND: GND, VCC: V3, SCL: SCK, SDA: MOSI, RES: LCD_RST, DC: LCD_DC, BLK: V3 }
}

// ---- USB-C (front, left edge, near the top): VBUS to the charger, D+/D- to the C3 ---------------
usb = UsbC2(vbus = VBUS, gnd = GND, dp = DP, dn = DN, fuseHold = 750mA, tvsPackage = "SOD-123") {}
override usb.power.J.at = (8.15mm, 108mm)
override usb.power.J.rotation = 270deg
override usb.power.J.orderCode = "C165948"
override usb.power.F.orderCode = "C70078"
override usb.power.D.orderCode = "C284108"
override usb.power.R1.orderCode = "C25905"
override usb.power.R2.orderCode = "C25905"
override usb.Esd.orderCode = "C7519"

// ---- power: 2 x 18650 (back) -> protection -> BQ24075 power path -> AP2112K 3.3 V -----------
// Two 18650 cells on the back, upright side by side, in parallel. The holders are not polarized:
// put each cell's + at the end the silkscreen marks.
BT1 = Holder.Part { orderCode = "C5249310"; at = (15mm, 51mm); rotation = 270deg; side = .bottom; pins { C2: CELL1_P, C1: CELL_N } }
BT2 = Holder.Part { orderCode = "C5249310"; at = (37mm, 51mm); rotation = 270deg; side = .bottom; pins { C2: CELL2_P, C1: CELL_N } }
// Per-cell protection: a 2 A resettable fuse (16 V, 100 A interrupt) at each holder's + contact.
F2 = fuse(2A, package = "1812", mpn = "1812L200/16GR") { orderCode = "C18198340"; side = .bottom; place = [soft(near(BT1.pin.C2, max = 20mm), weight = 3)]; pins { a: CELL1_P, b: BAT_IN } }
F3 = fuse(2A, package = "1812", mpn = "1812L200/16GR") { orderCode = "C18198340"; side = .bottom; place = [soft(near(BT2.pin.C2, max = 20mm), weight = 3)]; pins { a: CELL2_P, b: BAT_IN } }
cellMarks = [
  Text { text = "-"; at = (8mm, 4mm); size = 2mm; layer = Silk.bottom },
  Text { text = "+"; at = (8mm, 98mm); size = 2mm; layer = Silk.bottom },
  Text { text = "-"; at = (44mm, 4mm); size = 2mm; layer = Silk.bottom },
  Text { text = "+"; at = (44mm, 98mm); size = 2mm; layer = Silk.bottom },
  Text { text = "2 x 18650 Li-ion 3.7 V"; at = (26mm, 97mm); size = 1.2mm; layer = Silk.bottom },
]

// A cell put in the wrong way round: a P-MOSFET in the plus line, its gate at the cells' minus,
// on (both ways: charging too) only when the cells are the right way round.
reversed = ReversePolarity(vin = BAT_IN, vout = BAT, gnd = CELL_N, inputVoltage = 4.2V, current = 500mA, rdsOn = 60mohm, maxGateVoltage = 12V, fet = Pfet.Part with { orderCode = "C15127" }) {}

// Protection: over-charge 4.3 V, over-discharge 2.4 V, over-current about 3 A, in the pack's minus.
U3 = Protection.Part { orderCode = "C351410"; pins { GND: CELL_N } }
U3Support = Protection.Support(U3, batteryPlus = BAT, packMinus = GND) {}
override U3Support.C1.place = [near(U3.pin.VCC, max = 2mm)]

// The charger (BQ24075, datasheet SLUS810): USB500 mode (EN1 high, EN2 low: at most 500 mA from
// any port), ISET for 800 mA (RISET = 890 AΩ / 0.8 A), its current-based termination; SYSOFF
// low (the cells always connected); the safety timers off (TMR to VSS): two cells charge longer
// than its longest timer. TS: 10 kΩ without an NTC.
U2 = Charger.Part {
  at = (5.5mm, 92mm)
  pins { IN: VBUS, OUT: SYS, BAT: BAT, VSS: GND, nCE: GND, EN1: SYS, EN2: GND, TMR: GND, ISET: ISET, ILIM: ILIM, SYSOFF: GND, TS: TS, nCHG: CHG_N, nPGOOD: PG_N }
}
cIn = cap(1uF, package = "0603", ratedVoltage = 16V) { orderCode = "C15849"; at = (7.05mm, 95mm); rotation = 180deg; place = [near(U2.pin.IN, max = 3.5mm)]; pins { a: VBUS, b: GND } }
cSys = cap(4.7uF, package = "0805", ratedVoltage = 10V) { orderCode = "C1779"; place = [soft(near(U2.pin.OUT, max = 4mm), weight = 2)]; pins { a: SYS, b: GND } }
cBat = cap(4.7uF, package = "0805", ratedVoltage = 10V) { orderCode = "C1779"; place = [soft(near(U2.pin.BAT, max = 4mm), weight = 2)]; pins { a: BAT, b: GND } }
rIset = res(1.13kohm, package = "0402", tolerance = 1pct) { orderCode = "C67014"; place = [soft(near(U2.pin.ISET, max = 5mm))]; pins { a: ISET, b: GND } }
rIlim = res(1.18kohm, package = "0402", tolerance = 1pct) { orderCode = "C270651"; place = [soft(near(U2.pin.ILIM, max = 5mm))]; pins { a: ILIM, b: GND } }
rTs = res(10kohm, package = "0402") { orderCode = "C25744"; place = [soft(near(U2.pin.TS, max = 5mm))]; pins { a: TS, b: GND } }
// Charging (red) and USB present (green), each through 1.5 kΩ.
ledChg = led(package = "0603", color = .red) { orderCode = "C2286"; at = (3.5mm, 82mm); pins { A: SYS, K: CHG_LED } }
rChg = res(1.5kohm, package = "0402") { orderCode = "C25867"; place = [soft(near(ledChg, max = 3mm))]; pins { a: CHG_LED, b: CHG_N } }
ledPg = led(package = "0603", color = .green) { orderCode = "C12624"; at = (8.5mm, 82mm); pins { A: SYS, K: PG_LED } }
rPg = res(1.5kohm, package = "0402") { orderCode = "C25867"; place = [soft(near(ledPg, max = 3mm))]; pins { a: PG_LED, b: PG_N } }
chargeLabel = Text { text = "CHG  USB"; at = (6mm, 79.3mm); size = 1mm }

// 3.3 V from SYS (3.0-5 V): an LDO (250 mV dropout at 600 mA, about 25 mV at this board's 60 mA);
// the slide switch drives its enable: off, the board draws only the charger's and the
// protection's few µA.
U4 = AP2112K_3_3.Part { orderCode = "C51118"; pins { VIN: SYS, VOUT: V3, GND: GND, EN: LDO_EN, NC: .nc } }
U4Support = AP2112K_3_3.Support(U4, alwaysOn = false) {}
override U4Support.CIN.place = [near(U4.pin.VIN, max = 2mm)]
R1 = res(1Mohm, package = "0402") { orderCode = "C26083"; pins { a: LDO_EN, b: GND } }
SW9 = Slide.Part { at = (50.1mm, 95mm); rotation = 270deg; pins { COM: LDO_EN, A: SYS, B: .nc, SHELL: GND } }
switchLabel = Text { text = "ON / OFF"; at = (46mm, 95mm); size = 1mm; rotation = 90deg }

// ---- sound (back) --------------------------------------------------------------------------------
BZ1 = GPC12075YB_5V.Part { side = .bottom; orderCode = "C252948"; at = (22mm, 104mm); pins { A: BUZZ, B: GND } }

// ---- input (front) --------------------------------------------------------------------------------
// A tactile switch that pulls its line to ground, operated by `code` while the device runs.
fn key(code: String): Part = button("5.1x5.1") with {
  orderCode = "C318884"
  simulation = SimulationParameters { behavior = Behavior { model = "button"; ports = { output: ["1"] }; key = code } }
}
SW1 = key("ArrowUp") { at = (13mm, 54mm); pins { a: UP, b: GND } }
SW2 = key("ArrowDown") { at = (13mm, 38mm); pins { a: DOWN, b: GND } }
SW3 = key("ArrowLeft") { at = (5mm, 46mm); pins { a: LEFT, b: GND } }
SW4 = key("ArrowRight") { at = (21mm, 46mm); pins { a: RIGHT, b: GND } }
SW5 = key("KeyF") { at = (44mm, 50mm); pins { a: FIRE, b: GND } }
SW6 = key("Space") { at = (35mm, 42mm); pins { a: USE, b: GND } }
SW7 = key("KeyS") { at = (8mm, 30.5mm); pins { a: STRAFE, b: GND } }
SW8 = key("KeyM") { at = (44mm, 26mm); pins { a: MENU, b: GND } }

// Bring-up: the cells, the power path, 3.3 V and ground on test pads.
tpBat = testPoint() { at = (16mm, 61.5mm); pins = [BAT] }
tpSys = testPoint() { at = (22mm, 61.5mm); pins = [SYS] }
tpV3 = testPoint() { at = (28mm, 61.5mm); pins = [V3] }
tpGnd = testPoint() { at = (34mm, 61.5mm); pins = [GND] }
tpLabel = Text { text = "BAT SYS 3V3 GND"; at = (25mm, 64.3mm); size = 1mm }

// Four M3 holes for a back plate or a case, none under the cells' holders: the fourth in the
// middle of the top edge (the module has the corner).
H1 = hole("M3") { at = (4mm, 4mm) }
H2 = hole("M3") { at = (48mm, 4mm) }
H3 = hole("M3") { at = (4mm, 124mm) }
H4 = hole("M3") { at = (26mm, 124mm) }

gndPour = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}

// PCBKit's mark and pcbkit.io, where the board has room.
logo = Logo.Part { at = (26mm, 72mm) }

override reversed.Rg.orderCode = "C25741"
// The support blocks' parts: JLCPCB Basic passives, the reset button as the others' kind.
override U1Support.C1.orderCode = "C15850"
override U1Support.C2.orderCode = "C1525"
override U1Support.C3.orderCode = "C52923"
override U1Support.R1.orderCode = "C25744"
override U1Support.R_IO2.orderCode = "C25744"
override U1Support.R_IO8.orderCode = "C25744"
override U1Support.SW1.orderCode = "C221880"
override U4Support.CIN.orderCode = "C52923"
override U4Support.COUT.orderCode = "C52923"

// The screen module stands on its socket above the pins and pegs that come through the board under
// it: KiCad's pth/npth_inside_courtyard waived between them.
rule ScreenOverBack {
  select = ofComponent(DS1) and onB(anyOf([ofComponent(BZ1), ofComponent(BT2)]))
  reason = "the screen module stands on its socket above the pins and pegs that come through the board under it"
  limits { courtyardClearance: limit(min = -100mm) }
}
