pcbkit 2

// Doom device 07: the bare RP2350A (two Cortex-M33 or two Hazard3 RISC-V cores, chosen by the
// image, 150 MHz, 520 KB SRAM) with a 16 MB W25Q128 on the QSPI chip select 0 and an 8 MB
// APS6404L PSRAM on QMI chip select 1 (GPIO8): both memory-mapped through the XIP cache, so Doom
// runs unmodified with its zone heap in PSRAM. A 2.0" 240 x 320 ST7789 IPS on SPI0, a microSD
// slot on SPI1, ten buttons, a MAX98357A I2S speaker amplifier, and two 18650 cells in parallel
// with reverse-cell and DW01A protection, a BQ24075 charger with power path from the USB-C (the
// game runs from USB with flat or missing cells), a MAX17048 fuel gauge on I2C, a TLV75533 LDO
// enabled by the power switch. Flashing: UF2 over USB (BOOT + RESET), or SWD. Four layers.

use ./parts/RP2350A as RP2350A
use ./parts/W25Q128JVSIQ as W25Q128JVSIQ
use ./parts/APS6404L_3SQR as APS6404L_3SQR
use ./parts/ST7789_TFT_2_0 as ST7789_TFT_2_0
use ./parts/DM3AT_SF_PEJM5 as DM3AT_SF_PEJM5
use ./parts/MAX98357AETE as MAX98357AETE
use ./parts/MAX17048G as MAX17048G
use ./parts/TLV75533PDBV as TLV75533PDBV
use ./parts/S2B_PH_K_S as S2B_PH_K_S
use ./parts/KEYSTONE_1042 as Holder
use ./parts/BQ24075RGT as Charger
use ./parts/DW01A as Protection
use ./parts/MSK12C02 as Slide
use ./parts/AO3401A as Pfet
use ./parts/PCBKIT_LOGO as Logo

// Power: USB-C 5 V into the charger; its power path (SYS: the input when there is one, else the
// cells) feeds the 3.3 V LDO and the amplifier. The two cells in parallel (1S2P, 3.0-4.2 V) behind
// one protection circuit; the pack's minus is the board's ground.
net VBUS {
  voltage = 5V
  current = 500mA
}
// SYS feeds the LDO (RP2350, memories, display, card: about 150 mA) and the amplifier (to ~400 mA).
net SYS {
  voltage = 5V
  current = 600mA
}
net BAT {
  voltage = 4.2V
  current = 800mA
}
net BAT_IN {
  voltage = 4.2V
  current = 800mA
}
net CELL_N { current = 800mA }
// Each cell's + joins BAT_IN through its own resettable fuse (F2, F3): a cell put in the wrong
// way round, or one at another charge, drives the other through the two fuses, which trip in
// milliseconds (one cell alone carries all of it).
net CELL1_P {
  voltage = 4.2V
  current = 800mA
}
net CELL2_P {
  voltage = 4.2V
  current = 800mA
}
net V3 {
  voltage = 3.3V
  current = 200mA
}
// The RP2350's core, from its own switching regulator: about 40 mA at 150 MHz.
net V1V1 {
  voltage = 1.1V
  current = 40mA
}
net CHG_N, PG_N, CHG_LED, PG_LED, ISET, ILIM, TS
net GND { voltage = 0V }
net LDO_EN, DP, DN, BOOTSEL, RUN, SWDIO, SWCLK
net QSPI_SCLK, QSPI_SD0, QSPI_SD1, QSPI_SD2, QSPI_SD3, QSPI_SS, PSRAM_CS
net SCK, MOSI, LCD_CS, LCD_DC, LCD_RST, LCD_BL
net SD_SCK, SD_MOSI, SD_MISO, SD_CS, SD_CD
net I2S_BCK, I2S_LRCK, I2S_DIN, SPK_P, SPK_N
net SDA, SCL, FUEL_ALRT
net UP, DOWN, LEFT, RIGHT, FIRE, USE, STRAFE_L, STRAFE_R, MENU, ENTER

board = Board {
  name = "doom-07-rp2350-psram"
  description = "RP2350A (Cortex-M33 / Hazard3) · 16 MB flash + 8 MB PSRAM · 2.0in ST7789 · 2 x 18650, USB-C charging, fuel gauge"
  outline = rect(144mm, 110mm, radius = 6mm)
  layers = [
    signal(Cu.top),
    plane(Cu.inner[1], label = "GND"),
    signal(Cu.inner[2]),
    signal(Cu.bottom),
  ]
}
laboratory = Laboratory { world = "input.js" }

// ---- processor (back) --------------------------------------------------------------------------
// The program is doom/; the game's data, id Software's shareware DOOM1.WAD (free to share
// unmodified), is linked into its flash from where it is published.
U1 = RP2350A.RP2350A with {
  simulation = RP2350A.RP2350A.simulation with {
    behavior = RP2350A.RP2350A.simulation.behavior with {
      // The W25Q128 on chip select 0, the APS6404L on QMI chip select 1 (GPIO8).
      parameters = { "flash_mib" = 16, "psram_mib" = 8, "psram_cs" = 8, "gpios" = 30 }
      firmware = "doom"
      data = {
        "DOOM1.WAD" = FirmwareData {
          url = "https://raw.githubusercontent.com/Akbar30Bill/DOOM_wads/9b384dc68add3eb2f5eb7754654cafeeaea5103b/doom1.wad"
          sha256 = "1d7d43be501e67d927e415e0b8f3e29c3bf33075e859721816f652a526cac771"
          bytes = 4196020
        }
      }
    }
  }
} {
  at = (72mm, 22mm)
  side = .bottom
  orderCode = "C42411118"

  IOVDD -- V3
  QSPI_IOVDD -- V3
  ADC_AVDD -- V3
  USB_OTP_VDD -- V3
  VREG_VIN -- V3
  DVDD -- V1V1
  VREG_FB -- V1V1
  GND -- GND
  VREG_PGND -- GND
  RUN -- RUN
  SWDIO -- SWDIO
  SWCLK -- SWCLK
  QSPI_SCLK -- QSPI_SCLK
  QSPI_SD0 -- QSPI_SD0
  QSPI_SD1 -- QSPI_SD1
  QSPI_SD2 -- QSPI_SD2
  QSPI_SD3 -- QSPI_SD3
  QSPI_SS -- QSPI_SS
  GPIO8 -- PSRAM_CS
  GPIO18 -- SCK
  GPIO19 -- MOSI
  GPIO17 -- LCD_CS
  GPIO16 -- LCD_DC
  GPIO20 -- LCD_RST
  GPIO21 -- LCD_BL
  GPIO10 -- SD_SCK
  GPIO11 -- SD_MOSI
  GPIO12 -- SD_MISO
  GPIO13 -- SD_CS
  GPIO14 -- SD_CD
  GPIO22 -- I2S_BCK
  GPIO23 -- I2S_LRCK
  GPIO24 -- I2S_DIN
  GPIO6 -- SDA
  GPIO7 -- SCL
  GPIO29_ADC3 -- FUEL_ALRT
  GPIO0 -- UP
  GPIO1 -- DOWN
  GPIO2 -- LEFT
  GPIO3 -- RIGHT
  GPIO4 -- FIRE
  GPIO5 -- USE
  GPIO9 -- STRAFE_L
  GPIO15 -- STRAFE_R
  GPIO25 -- MENU
  GPIO26_ADC0 -- ENTER
}
// Raspberry Pi's minimal design: decoupling, the core switching regulator (L1, 3.3 uH), the
// 12 MHz crystal, the 27 ohm USB resistors, BOOTSEL through 1 kohm on QSPI_SS.
U1Support = RP2350A.Support {
  chip = U1
  connectorDP -- DP
  connectorDN -- DN
  bootsel -- BOOTSEL
  side = .bottom
}
// Each supply pin's capacitor within 3 mm of it, leaving room between them for the pins' escape.
// (Positions in the block's frame: the block is on the back, so x is mirrored.)
U1Support.C1_C6_1.at = (-78.0mm, 24.8mm)
U1Support.C1_C6_1.rotation = 180deg
U1Support.C1_C6_1.place = [near(U1["1"], max = 2.9mm)]
U1Support.C7_C9_6.at = (-78.0mm, 22.8mm)
U1Support.C7_C9_6.rotation = 180deg
U1Support.C7_C9_6.place = [near(U1["6"], max = 2.9mm)]
U1Support.C1_C6_11.at = (-78.0mm, 20.8mm)
U1Support.C1_C6_11.rotation = 180deg
U1Support.C1_C6_11.place = [near(U1["11"], max = 2.9mm)]
U1Support.C1_C6_20.at = (-74.0mm, 16.0mm)
U1Support.C1_C6_20.rotation = 270deg
U1Support.C1_C6_20.place = [near(U1["20"], max = 2.9mm)]
U1Support.C7_C9_23.at = (-71.4mm, 16.0mm)
U1Support.C7_C9_23.rotation = 270deg
U1Support.C7_C9_23.place = [near(U1["23"], max = 2.9mm)]
U1Support.C1_C6_30.at = (-69.2mm, 16.0mm)
U1Support.C1_C6_30.rotation = 270deg
U1Support.C1_C6_30.place = [near(U1["30"], max = 2.9mm)]
U1Support.C1_C6_38.at = (-66.0mm, 21.6mm)
U1Support.C1_C6_38.rotation = 0deg
U1Support.C1_C6_38.place = [near(U1["38"], max = 2.9mm)]
U1Support.C7_C9_39.at = (-66.0mm, 22.7mm)
U1Support.C7_C9_39.rotation = 0deg
U1Support.C7_C9_39.place = [near(U1["39"], max = 2.9mm)]
U1Support.C11.at = (-66.0mm, 24.4mm)
U1Support.C11.rotation = 0deg
U1Support.C11.place = [near(U1.pin.ADC_AVDD, max = 2.9mm)]
U1Support.C1_C6_45.at = (-66.0mm, 25.5mm)
U1Support.C1_C6_45.rotation = 0deg
U1Support.C1_C6_45.place = [near(U1["45"], max = 2.9mm)]
U1Support.C14.at = (-67.6mm, 27.3mm)
U1Support.C14.rotation = 0deg
U1Support.C14.place = [near(U1.pin.VREG_AVDD, max = 2.9mm)]
U1Support.C12.at = (-70.3mm, 28.5mm)
U1Support.C12.rotation = 90deg
U1Support.C12.place = [near(U1.pin.VREG_VIN, max = 2.9mm)]
U1Support.C10.at = (-72.2mm, 27.6mm)
U1Support.C10.rotation = 90deg
U1Support.C10.place = [near(U1.pin.QSPI_IOVDD, max = 2.9mm)]

// BOOT (QSPI_SS through 1 kohm to ground) and RESET (RUN) on the front's lower edge, beside the
// USB-C: hold BOOT, tap RESET, and the boot ROM's USB drive (RP2350) appears.
part Btn = button("6x6") with { orderCode = "C221880" }
SW11 = Btn {
  at = (58mm, 6mm)
  a -- BOOTSEL
  b -- GND
}
reset = Btn {
  at = (86mm, 6mm)
  a -- RUN
  b -- GND
}
bootLabels = [
  Text { text = "BOOT", at = (58mm, 1.6mm), size = 1mm },
  Text { text = "RESET", at = (86mm, 1.6mm), size = 1mm },
]
R1 = res(10kohm, package = "0402") {
  side = .bottom
  orderCode = "C25744"
  a -- RUN
  b -- V3
}
// SWD for a debug probe (SWCLK, GND, SWDIO, RUN) on the back.
J3 = header(4) {
  side = .bottom
  orderCode = "C2691448"
  pins = [SWCLK, GND, SWDIO, RUN]
}

// ---- memory (back): flash on CS0, PSRAM on QMI CS1 sharing SCLK and SD0-SD3 ------------------------
U2 = W25Q128JVSIQ.W25Q128JVSIQ {
  side = .bottom
  orderCode = "C97521"
  nCS -- QSPI_SS
  CLK -- QSPI_SCLK
  DI -- QSPI_SD0
  DO -- QSPI_SD1
  nWP -- QSPI_SD2
  nHOLD -- QSPI_SD3
  VCC -- V3
  GND -- GND
}
U2Support = W25Q128JVSIQ.Support {
  chip = U2
  csPullUp = false
  ioPullUps = false
  side = .bottom
}
U3 = APS6404L_3SQR.APS6404L_3SQR {
  side = .bottom
  orderCode = "C5333729"
  CE -- PSRAM_CS
  SCLK -- QSPI_SCLK
  SIO0 -- QSPI_SD0
  SIO1 -- QSPI_SD1
  SIO2 -- QSPI_SD2
  SIO3 -- QSPI_SD3
  VDD -- V3
  VSS -- GND
}
U3Support = APS6404L_3SQR.Support {
  chip = U3
  side = .bottom
}

// ---- display (front) ----------------------------------------------------------------------------------
DS1 = ST7789_TFT_2_0.ST7789_TFT_2_0 {
  at = (42mm, 32mm)
  rotation = 90deg
  // The 1x8 socket it plugs into (the module: a 2.0" ST7789 SPI IPS, bought separately).
  orderCode = "C2905417"
  GND -- GND
  VCC -- V3
  SCL -- SCK
  SDA -- MOSI
  RES -- LCD_RST
  DC -- LCD_DC
  CS -- LCD_CS
  BLK -- LCD_BL
}

// ---- storage (back, right edge) --------------------------------------------------------------------------
J4 = DM3AT_SF_PEJM5.DM3AT_SF_PEJM5 {
  side = .bottom
  orderCode = "C114218"
  place = [edge(.right)]
  DAT2 -- .nc
  CD_DAT3 -- SD_CS
  CMD -- SD_MOSI
  VDD -- V3
  CLK -- SD_SCK
  VSS -- GND
  DAT0 -- SD_MISO
  DAT1 -- .nc
  CD_A -- SD_CD
  CD_B -- GND
  SH -- GND
}
R2 = res(10kohm, package = "0402") {
  side = .bottom
  orderCode = "C25744"
  a -- SD_CD
  b -- V3
}
R3 = res(10kohm, package = "0402") {
  side = .bottom
  orderCode = "C25744"
  a -- SD_CS
  b -- V3
}
R4 = res(10kohm, package = "0402") {
  side = .bottom
  orderCode = "C25744"
  a -- SD_MISO
  b -- V3
}
C1 = cap(10uF, package = "0603") {
  side = .bottom
  orderCode = "C19702"
  a -- V3
  b -- GND
}

// ---- audio (back) ---------------------------------------------------------------------------------------
U5 = MAX98357AETE.MAX98357AETE {
  side = .bottom
  orderCode = "C910544"
  BCLK -- I2S_BCK
  LRCLK -- I2S_LRCK
  DIN -- I2S_DIN
  VDD -- SYS
  GND -- GND
  EP -- GND
  GAIN_SLOT -- .nc
  OUTP -- SPK_P
  OUTN -- SPK_N
  NC5 -- .nc
  NC6 -- .nc
  NC12 -- .nc
  NC13 -- .nc
}
U5Support = MAX98357AETE.Support {
  chip = U5
  vio -- V3
  side = .bottom
}
U5Support.C1.place = [near(U5.pin.VDD, max = 2.5mm)]
U5Support.C2.place = [near(U5.pin.VDD, max = 2.5mm)]
// The speaker plugs in at the board's right edge.
J5 = S2B_PH_K_S.S2B_PH_K_S {
  side = .bottom
  orderCode = "C173752"
  place = [edge(.right)]
  C1 -- SPK_N
  C2 -- SPK_P
}

// ---- USB-C (front, bottom edge) ----------------------------------------------------------------------------
usb = UsbC2 {
  vbus = VBUS
  gnd = GND
  dp = DP
  dn = DN
  fuseHold = 750mA
  tvsPackage = "SOD-323"
}
usb.power.J.at = (72mm, 8.15mm)

// ---- power ---------------------------------------------------------------------------------------------
// Two 18650 cells on the back, side by side along the top, in parallel. The holders are not
// polarized: put each cell's + at the end the silkscreen marks.
BT1 = Holder.KEYSTONE_1042 {
  orderCode = "C5249310"
  at = (72mm, 75mm)
  side = .bottom
  C2 -- CELL1_P
  C1 -- CELL_N
}
BT2 = Holder.KEYSTONE_1042 {
  orderCode = "C5249310"
  at = (72mm, 97mm)
  side = .bottom
  C2 -- CELL2_P
  C1 -- CELL_N
}
// Per-cell protection: a 2 A resettable fuse (16 V, 100 A interrupt) at each holder's + contact.
F2 = fuse(2A, package = "1812", mpn = "1812L200/16GR") {
  orderCode = "C18198340"
  side = .bottom
  place = [soft(near(BT1.pin.C2, max = 20mm), weight = 3)]
  a -- CELL1_P
  b -- BAT_IN
}
F3 = fuse(2A, package = "1812", mpn = "1812L200/16GR") {
  orderCode = "C18198340"
  side = .bottom
  place = [soft(near(BT2.pin.C2, max = 20mm), weight = 3)]
  a -- CELL2_P
  b -- BAT_IN
}
cellMarks = [
  Text { text = "+", at = (25mm, 75mm), size = 2.5mm, layer = Silk.bottom },
  Text { text = "-", at = (119mm, 75mm), size = 2.5mm, layer = Silk.bottom },
  Text { text = "+", at = (25mm, 97mm), size = 2.5mm, layer = Silk.bottom },
  Text { text = "-", at = (119mm, 97mm), size = 2.5mm, layer = Silk.bottom },
  Text {
    text = "2 x 18650 Li-ion 3.7 V"
    at = (127mm, 86mm)
    size = 1.5mm
    rotation = 90deg
    layer = Silk.bottom
  },
]

// A cell put in the wrong way round: a P-MOSFET in the plus line, its gate at the cells' minus,
// on (both ways: charging too) only when the cells are the right way round.
reversed = ReversePolarity {
  vin = BAT_IN
  vout = BAT
  gnd = CELL_N
  inputVoltage = 4.2V
  current = 800mA
  rdsOn = 60mohm
  maxGateVoltage = 12V
  fet = Pfet.AO3401A with { orderCode = "C15127" }
  side = .bottom
}

// Protection: over-charge 4.3 V, over-discharge 2.4 V, over-current about 3 A, in the pack's minus.
U8 = Protection.DW01A {
  orderCode = "C351410"
  side = .bottom
  GND -- CELL_N
}
U8Support = Protection.Support {
  chip = U8
  batteryPlus -- BAT
  packMinus -- GND
  side = .bottom
}

// The charger (BQ24075, datasheet SLUS810): USB500 mode (EN1 high, EN2 low: at most 500 mA from
// any port), 800 mA fast charge (RISET = 890 AΩ / 0.8 A), its current-based termination; SYSOFF
// low (the cells always connected); the safety timers off (TMR to VSS): two cells charge longer
// than its longest timer. TS: 10 kΩ without an NTC.
U6 = Charger.BQ24075RGT {
  at = (44mm, 9mm)
  rotation = 180deg
  orderCode = "C15464"
  IN -- VBUS
  OUT -- SYS
  BAT -- BAT
  VSS -- GND
  nCE -- GND
  EN1 -- SYS
  EN2 -- GND
  TMR -- GND
  ISET -- ISET
  ILIM -- ILIM
  SYSOFF -- GND
  TS -- TS
  nCHG -- CHG_N
  nPGOOD -- PG_N
}
cIn = cap(1uF, package = "0603", ratedVoltage = 16V) {
  orderCode = "C15849"
  at = (43.5mm, 5.3mm)
  rotation = 270deg
  place = [near(U6.pin.IN, max = 2.9mm)]
  a -- VBUS
  b -- GND
}
cSys = cap(4.7uF, package = "0805", ratedVoltage = 10V) {
  orderCode = "C1779"
  place = [soft(near(U6.pin.OUT, max = 2mm), weight = 3)]
  a -- SYS
  b -- GND
}
cBat = cap(4.7uF, package = "0805", ratedVoltage = 10V) {
  orderCode = "C1779"
  place = [soft(near(U6.pin.BAT, max = 2mm), weight = 3)]
  a -- BAT
  b -- GND
}
rIset = res(1.13kohm, package = "0402", tolerance = 1%) {
  orderCode = "C67014"
  place = [soft(near(U6.pin.ISET, max = 5mm))]
  a -- ISET
  b -- GND
}
rIlim = res(1.18kohm, package = "0402", tolerance = 1%) {
  orderCode = "C270651"
  place = [soft(near(U6.pin.ILIM, max = 5mm))]
  a -- ILIM
  b -- GND
}
rTs = res(10kohm, package = "0402") {
  orderCode = "C25744"
  place = [soft(near(U6.pin.TS, max = 5mm))]
  a -- TS
  b -- GND
}
// Charging (red) and USB present (green), each through 1.5 kΩ, on the front by the USB-C.
ledChg = led(package = "0603", color = .red) {
  orderCode = "C2286"
  at = (100mm, 6mm)
  A -- SYS
  K -- CHG_LED
}
rChg = res(1.5kohm, package = "0402") {
  orderCode = "C25867"
  place = [soft(near(ledChg, max = 3mm))]
  a -- CHG_LED
  b -- CHG_N
}
ledPg = led(package = "0603", color = .green) {
  orderCode = "C12624"
  at = (106mm, 6mm)
  A -- SYS
  K -- PG_LED
}
rPg = res(1.5kohm, package = "0402") {
  orderCode = "C25867"
  place = [soft(near(ledPg, max = 3mm))]
  a -- PG_LED
  b -- PG_N
}
chargeLabel = Text {
  text = "CHG USB"
  at = (103mm, 9mm)
  size = 1mm
}

// The fuel gauge on the pack (after the protection): state of charge over I2C, an alert pin.
U7 = MAX17048G.MAX17048G {
  side = .bottom
  orderCode = "C2682616"
  VDD -- BAT
  CELL -- BAT
  GND -- GND
  CTG -- GND
  EP -- GND
  QSTRT -- GND
  SDA -- SDA
  SCL -- SCL
  ALRT -- FUEL_ALRT
}
U7Support = MAX17048G.Support {
  chip = U7
  side = .bottom
}
i2c = I2cPullups {
  sda = SDA
  scl = SCL
  vcc = V3
  speed = 400kHz
  side = .bottom
}
R5 = res(10kohm, package = "0402") {
  side = .bottom
  orderCode = "C25744"
  a -- FUEL_ALRT
  b -- V3
}

// 3.3 V: the LDO from SYS, enabled by the on/off switch (R6 holds it off when the switch is open).
U4 = TLV75533PDBV.TLV75533PDBV {
  side = .bottom
  orderCode = "C404027"
  IN -- SYS
  OUT -- V3
  GND -- GND
  EN -- LDO_EN
}
U4Support = TLV75533PDBV.Support {
  chip = U4
  alwaysOn = false
  side = .bottom
}
R6 = res(100kohm, package = "0402") {
  side = .bottom
  orderCode = "C25741"
  a -- LDO_EN
  b -- GND
}
SW12 = Slide.MSK12C02 {
  at = (1.9mm, 64mm)
  rotation = 90deg
  COM -- LDO_EN
  A -- SYS
  B -- .nc
  SHELL -- GND
}
switchLabel = Text {
  text = "ON / OFF"
  at = (6mm, 64mm)
  size = 1mm
  rotation = 90deg
}

// Bring-up: the cells, the power path, 3.3 V and ground on test pads (front).
tpBat = testPoint() {
  at = (112mm, 12mm)
  pins = [BAT]
}
tpSys = testPoint() {
  at = (116mm, 12mm)
  pins = [SYS]
}
tpV3 = testPoint() {
  at = (120mm, 12mm)
  pins = [V3]
}
tpGnd = testPoint() {
  at = (124mm, 12mm)
  pins = [GND]
}
tpLabel = Text {
  text = "BAT SYS 3V3 GND"
  at = (118mm, 15mm)
  size = 1mm
}

// ---- input (front) ------------------------------------------------------------------------------------------
// A tactile switch that pulls its line to ground, operated by `code` while the device runs.
fn key(code: String) -> Part = button("6x6") with {
  orderCode = "C221880"
  simulation = SimulationParameters {
    behavior = Behavior { model = "button", ports = { output = ["1"] }, key = code }
  }
}
SW1 = key("ArrowUp") {
  at = (16mm, 40mm)
  a -- UP
  b -- GND
}
SW2 = key("ArrowDown") {
  at = (16mm, 20mm)
  a -- DOWN
  b -- GND
}
SW3 = key("ArrowLeft") {
  at = (6.5mm, 30mm)
  a -- LEFT
  b -- GND
}
SW4 = key("ArrowRight") {
  at = (25.5mm, 30mm)
  a -- RIGHT
  b -- GND
}
SW5 = key("Comma") {
  at = (9mm, 52mm)
  a -- STRAFE_L
  b -- GND
}
SW6 = key("Period") {
  at = (9mm, 8mm)
  a -- STRAFE_R
  b -- GND
}
SW7 = key("KeyF") {
  at = (135mm, 34mm)
  a -- FIRE
  b -- GND
}
SW8 = key("Space") {
  at = (123mm, 24mm)
  a -- USE
  b -- GND
}
SW9 = key("KeyM") {
  at = (123mm, 47mm)
  a -- MENU
  b -- GND
}
SW10 = key("Enter") {
  at = (135mm, 47mm)
  a -- ENTER
  b -- GND
}

// Four M3 holes for a back plate or a case.
H1 = hole("M3") { at = (25mm, 4.5mm) }
H2 = hole("M3") { at = (139.5mm, 4.5mm) }
H3 = hole("M3") { at = (4.5mm, 105.5mm) }
H4 = hole("M3") { at = (139.5mm, 105.5mm) }

gndPour = pour(net = GND, layers = [Cu.top, Cu.inner[1], Cu.bottom]) {}

// Fine-pitch escape (QFN-60 at 0.4 mm): 0.15 mm tracks and gaps, 0.45 / 0.2 mm vias (standard
// 4-layer capabilities); supplies wider.
fineClass = NetClass {
  name = "fine"
  trackWidth = 0.15mm
  clearance = 0.15mm
  viaDiameter = 0.45mm
  viaDrill = 0.2mm
  default = true
}
supplyClass = NetClass {
  name = "supply"
  trackWidth = 0.3mm
  clearance = 0.15mm
  viaDiameter = 0.6mm
  viaDrill = 0.3mm
  nets = [V3, V1V1]
}
// The power paths: wide tracks, vias that carry an ampere.
powerClass = NetClass {
  name = "power"
  trackWidth = 0.6mm
  viaDiameter = 0.8mm
  viaDrill = 0.4mm
  nets = [VBUS, SYS, BAT, BAT_IN, CELL1_P, CELL2_P, CELL_N]
}
routing = Routing { timeLimit = 180s }
rules = Rules { vias { minDiameter = 0.45mm, minDrill = 0.2mm } }

// PCBKit's mark and pcbkit.io, where the board has room.
logo = Logo.PCBKIT_LOGO { at = (72mm, 86mm) }

