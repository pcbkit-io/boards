let Y1Crystal = crystal(12MHz, load = 10pF, package = "3225")

/// The support circuit of the RP2350A as its datasheet shows it (Hardware design with RP2350
/// (minimal design): 2.1 core regulator, 2.3 decoupling, 3 flash, 4 crystal, 5 USB; RP2350
/// datasheet 14.9.5 power supplies, 1.2.2 pin descriptions): every part next to the pin it serves.
/// Add it next to the part: `U1 = RP2350A.Part { … }`, `U1Support = RP2350A.Support(U1) {}`.
///
/// - The core regulator's layout matters: copy Raspberry Pi's reference layout (inductor
/// orientation, C12/C13 next to VREG_VIN/VREG_PGND, short LX node); VREG_PGND joins GND so the
/// switching current returns straight to the pin.
///
/// - DVDD pins all connect to the regulator's filtered output (the VREG_FB net): there is no
/// separate 1.1 V supply to provide.
///
/// - RP2350A has no internal flash (RP2354A has 2 MB): add a QSPI NOR flash on the six QSPI pins;
/// QSPI_SS low at reset enters BOOTSEL (USB mass storage).
///
/// - USB needs no pull-ups: only the 27 ohm series resistors next to the chip, 90 ohm differential
/// routing.
///
/// - Also in the datasheet's circuit: U2 W25Q128JVSIQ (or any W25Q QSPI flash) between QSPI_SS and
/// QSPI_SCLK and QSPI_SD0 and QSPI_SD1 and QSPI_SD2 and QSPI_SD3.
block Support(
  /// The RP2350A this circuit serves (`RP2350A.Support(U1)`).
  chip: Any,
  /// The board's connector D+. (`null`: its parts are left out)
  connectorDP: Endpoint? = null,
  /// The board's connector D-. (`null`: its parts are left out)
  connectorDN: Endpoint? = null,
  /// The board's BOOTSEL. (`null`: its parts are left out)
  bootsel: Endpoint? = null,
) {
  net XO
  /// in series between XOUT and the crystal
  R2 = res(1kohm, package = "0402") {
    place = [soft(near(chip.pin.XOUT, max = 5mm), weight = 1)]
    pins { a: chip.pin.XOUT, b: XO }
  }
  /// Abracon ABM8-272-T3 (10 pF CL, ESR 50 ohm max)
  Y1 = Y1Crystal {
    place = [soft(near(chip, max = 4mm), weight = 2)]
    pins { X1: chip.pin.XIN, X2: XO, GND: chip.pin.VREG_PGND }
  }
  Y1_C1 = cap(loadCapacitor(10pF, stray = 3pF), package = "0402") {
    place = [soft(near(Y1.pin.X1, max = 2.5mm), weight = 2)]
    pins { a: chip.pin.XIN, b: chip.pin.VREG_PGND }
  }
  Y1_C2 = cap(loadCapacitor(10pF, stray = 3pF), package = "0402") {
    place = [soft(near(Y1.pin.X2, max = 2.5mm), weight = 2)]
    pins { a: XO, b: chip.pin.VREG_PGND }
  }
  /// one per IOVDD pin (1, 11, 20, 30, 38, 45)
  C1_C6_1 = cap(100nF, package = "0402") {
    place = [soft(near(chip["1"], max = 2mm), weight = 2)]
    pins { a: chip["1"], b: chip.pin.GND }
  }
  /// one per IOVDD pin (1, 11, 20, 30, 38, 45)
  C1_C6_11 = cap(100nF, package = "0402") {
    place = [soft(near(chip["11"], max = 2mm), weight = 2)]
    pins { a: chip["11"], b: chip.pin.GND }
  }
  /// one per IOVDD pin (1, 11, 20, 30, 38, 45)
  C1_C6_20 = cap(100nF, package = "0402") {
    place = [soft(near(chip["20"], max = 2mm), weight = 2)]
    pins { a: chip["20"], b: chip.pin.GND }
  }
  /// one per IOVDD pin (1, 11, 20, 30, 38, 45)
  C1_C6_30 = cap(100nF, package = "0402") {
    place = [soft(near(chip["30"], max = 2mm), weight = 2)]
    pins { a: chip["30"], b: chip.pin.GND }
  }
  /// one per IOVDD pin (1, 11, 20, 30, 38, 45)
  C1_C6_38 = cap(100nF, package = "0402") {
    place = [soft(near(chip["38"], max = 2mm), weight = 2)]
    pins { a: chip["38"], b: chip.pin.GND }
  }
  /// one per IOVDD pin (1, 11, 20, 30, 38, 45)
  C1_C6_45 = cap(100nF, package = "0402") {
    place = [soft(near(chip["45"], max = 2mm), weight = 2)]
    pins { a: chip["45"], b: chip.pin.GND }
  }
  /// one per DVDD pin (6, 23, 39)
  C7_C9_6 = cap(100nF, package = "0402") {
    place = [soft(near(chip["6"], max = 2mm), weight = 2)]
    pins { a: chip["6"], b: chip.pin.GND }
  }
  /// one per DVDD pin (6, 23, 39)
  C7_C9_23 = cap(100nF, package = "0402") {
    place = [soft(near(chip["23"], max = 2mm), weight = 2)]
    pins { a: chip["23"], b: chip.pin.GND }
  }
  /// one per DVDD pin (6, 23, 39)
  C7_C9_39 = cap(100nF, package = "0402") {
    place = [soft(near(chip["39"], max = 2mm), weight = 2)]
    pins { a: chip["39"], b: chip.pin.GND }
  }
  /// QSPI_IOVDD and USB_OTP_VDD (pins 53, 54) may share it
  C10 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.QSPI_IOVDD, max = 2mm), weight = 2)]
    pins { a: chip.pin.QSPI_IOVDD, b: chip.pin.GND }
  }
  C11 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.ADC_AVDD, max = 2mm), weight = 2)]
    pins { a: chip.pin.ADC_AVDD, b: chip.pin.GND }
  }
  /// 0402, at the pins
  C12 = cap(4.7uF, package = "0805") {
    place = [soft(near(chip.pin.VREG_VIN, max = 4mm), weight = 2)]
    pins { a: chip.pin.VREG_VIN, b: chip.pin.VREG_PGND }
  }
  /// 0806 (2016) with a polarity dot, e.g. Abracon AOTA-B201610S3R3-101-T, in the orientation of the reference layout
  L1 = inductor(3.3uH, package = "6") {
    place = [soft(near(chip.pin.VREG_LX, max = 5mm), weight = 1)]
    pins { a: chip.pin.VREG_LX, b: chip.pin.VREG_FB }
  }
  /// regulator output, 0402
  C13 = cap(4.7uF, package = "0805") {
    place = [soft(near(chip.pin.VREG_FB, max = 4mm), weight = 2)]
    pins { a: chip.pin.VREG_FB, b: chip.pin.VREG_PGND }
  }
  /// VREG_AVDD RC filter from 3.3 V
  R1 = res(33ohm, package = "0402") {
    place = [soft(near(chip.pin.VREG_AVDD, max = 5mm), weight = 1)]
    pins { a: chip.pin.VREG_AVDD, b: chip.pin.IOVDD }
  }
  C14 = cap(4.7uF, package = "0805") {
    place = [soft(near(chip.pin.VREG_AVDD, max = 4mm), weight = 2)]
    pins { a: chip.pin.VREG_AVDD, b: chip.pin.GND }
  }
  R3 =
    if connectorDP != null then res(27ohm, package = "0402") {
      place = [soft(near(chip.pin.USB_DP, max = 5mm), weight = 1)]
      pins { a: chip.pin.USB_DP, b: connectorDP }
    }
    else null
  R4 =
    if connectorDN != null then res(27ohm, package = "0402") {
      place = [soft(near(chip.pin.USB_DM, max = 5mm), weight = 1)]
      pins { a: chip.pin.USB_DM, b: connectorDN }
    }
    else null
  /// to the BOOTSEL button (to GND)
  R5 =
    if bootsel != null then res(1kohm, package = "0402") {
      place = [soft(near(chip.pin.QSPI_SS, max = 5mm), weight = 1)]
      pins { a: chip.pin.QSPI_SS, b: bootsel }
    }
    else null
}
