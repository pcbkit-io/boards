  spanY = tolerance(7mm, 7mm),
  leadLength = tolerance(0.35mm, 0.45mm),
  leadWidth = tolerance(0.13mm, 0.23mm),
  bodyX = tolerance(7mm, 7mm),
  bodyY = tolerance(7mm, 7mm),
  bodyHeight = 0.9mm,
  exposedPad = (3.4mm, 3.4mm),
