let Y1Crystal = crystal(12MHz, load = 10pF, package = "3225")

/// The support circuit of the RP2040 as its datasheet shows it (Hardware design with RP2040
/// (minimal design example); datasheet 2.9 Power supplies, 2.16 Crystal oscillator): every part
/// next to the pin it serves. Add it next to the part: `U1 = RP2040.Part { … }`, `U1Support =
/// RP2040.Support(U1) {}`.
///
/// - The core regulator: VREG_VIN from 3.3 V, VREG_VOUT straight to both DVDD pins, 1 uF at its
/// input and output.
///
/// - Keep the flash next to the QSPI pins with short traces; QSPI_SS pulled low at reset (BOOTSEL)
/// starts the USB mass-storage bootloader.
block Support(
  /// The RP2040 this circuit serves (`RP2040.Support(U1)`).
  chip: Any,
  /// The USB connector's D+ (through 27 ohm). (`null`: its parts are left out)
  dp: Endpoint? = null,
  /// The USB connector's D- (through 27 ohm). (`null`: its parts are left out)
  dm: Endpoint? = null,
  /// VREG_VIN, USB_VDD and ADC_AVDD on the IOVDD rail (3.3 V).
  oneSupply: Bool = true,
  /// The BOOTSEL button: QSPI_SS through 1 kohm to GND, held at reset for the USB bootloader.
  bootButton: Bool = true,
) {
  net XO, BOOTSEL
  /// one per IOVDD pin (6)
  C_IOVDD_1 = cap(100nF, package = "0402") {
    place = [soft(near(chip["1"], max = 2mm), weight = 2)]
    pins { a: chip["1"], b: chip.pin.GND }
  }
  /// one per IOVDD pin (6)
  C_IOVDD_10 = cap(100nF, package = "0402") {
    place = [soft(near(chip["10"], max = 2mm), weight = 2)]
    pins { a: chip["10"], b: chip.pin.GND }
  }
  /// one per IOVDD pin (6)
  C_IOVDD_22 = cap(100nF, package = "0402") {
    place = [soft(near(chip["22"], max = 2mm), weight = 2)]
    pins { a: chip["22"], b: chip.pin.GND }
  }
  /// one per IOVDD pin (6)
  C_IOVDD_33 = cap(100nF, package = "0402") {
    place = [soft(near(chip["33"], max = 2mm), weight = 2)]
    pins { a: chip["33"], b: chip.pin.GND }
  }
  /// one per IOVDD pin (6)
  C_IOVDD_42 = cap(100nF, package = "0402") {
    place = [soft(near(chip["42"], max = 2mm), weight = 2)]
    pins { a: chip["42"], b: chip.pin.GND }
  }
  /// one per IOVDD pin (6)
  C_IOVDD_49 = cap(100nF, package = "0402") {
    place = [soft(near(chip["49"], max = 2mm), weight = 2)]
    pins { a: chip["49"], b: chip.pin.GND }
  }
  C_VIN = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.VREG_VIN, max = 2mm), weight = 2)]
    pins { a: chip.pin.VREG_VIN, b: chip.pin.GND }
  }
  C_VOUT = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.VREG_VOUT, max = 2mm), weight = 2)]
    pins { a: chip.pin.VREG_VOUT, b: chip.pin.GND }
  }
  /// one per DVDD pin (2)
  C_DVDD_23 = cap(100nF, package = "0402") {
    place = [soft(near(chip["23"], max = 2mm), weight = 2)]
    pins { a: chip["23"], b: chip.pin.GND }
  }
  /// one per DVDD pin (2)
  C_DVDD_50 = cap(100nF, package = "0402") {
    place = [soft(near(chip["50"], max = 2mm), weight = 2)]
    pins { a: chip["50"], b: chip.pin.GND }
  }
  C_USB = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.USB_VDD, max = 2mm), weight = 2)]
    pins { a: chip.pin.USB_VDD, b: chip.pin.GND }
  }
  C_ADC = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.ADC_AVDD, max = 2mm), weight = 2)]
    pins { a: chip.pin.ADC_AVDD, b: chip.pin.GND }
  }
  connect(chip.pin.VREG_VOUT, chip.pin.DVDD)
  connect(chip.pin.VREG_VIN, if oneSupply then chip.pin.IOVDD else chip.pin.VREG_VIN)
  connect(chip.pin.USB_VDD, if oneSupply then chip.pin.IOVDD else chip.pin.USB_VDD)
  connect(chip.pin.ADC_AVDD, if oneSupply then chip.pin.IOVDD else chip.pin.ADC_AVDD)
  connect(chip.pin.TESTEN, chip.pin.GND)
  /// ESR 50 ohm max, CL 10-15 pF (the minimal design's 15 pF load capacitors)
  Y1 = Y1Crystal {
    place = [soft(near(chip, max = 4mm), weight = 2)]
    pins { X1: chip.pin.XIN, X2: XO, GND: chip.pin.GND }
  }
  Y1_C1 = cap(loadCapacitor(10pF, stray = 3pF), package = "0402") {
    place = [soft(near(Y1.pin.X1, max = 2.5mm), weight = 2)]
    pins { a: chip.pin.XIN, b: chip.pin.GND }
  }
  Y1_C2 = cap(loadCapacitor(10pF, stray = 3pF), package = "0402") {
    place = [soft(near(Y1.pin.X2, max = 2.5mm), weight = 2)]
    pins { a: XO, b: chip.pin.GND }
  }
  /// series, limits crystal drive
  R_X = res(1kohm, package = "0402") {
    place = [soft(near(chip.pin.XOUT, max = 5mm), weight = 1)]
    pins { a: chip.pin.XOUT, b: XO }
  }
  R_DP =
    if dp != null then res(27ohm, package = "0402") {
      place = [soft(near(chip.pin.USB_DP, max = 5mm), weight = 1)]
      pins { a: chip.pin.USB_DP, b: dp }
    }
    else null
  R_DM =
    if dm != null then res(27ohm, package = "0402") {
      place = [soft(near(chip.pin.USB_DM, max = 5mm), weight = 1)]
      pins { a: chip.pin.USB_DM, b: dm }
    }
    else null
  /// QSPI NOR flash, 3.3 V, SOIC-8 208 mil
  U_FLASH = W25Q128JVSIQ.Part {
    place = [soft(near(chip, max = 8mm), weight = 1)]
    pins {
      nCS: chip.pin.QSPI_SS,
      nHOLD: chip.pin.QSPI_SD3,
      nWP: chip.pin.QSPI_SD2,
      CLK: chip.pin.QSPI_SCLK,
      DI: chip.pin.QSPI_SD0,
      DO: chip.pin.QSPI_SD1,
      GND: chip.pin.GND,
      VCC: chip.pin.IOVDD,
    }
  }
  U_FLASH_support = W25Q128JVSIQ.Support(U_FLASH, ioPullUps = false) {}
  /// boot select: hold low at reset for the USB bootloader
  R_BOOT =
    if bootButton then res(1kohm, package = "0402") {
      place = [soft(near(chip.pin.QSPI_SS, max = 5mm), weight = 1)]
      pins { a: chip.pin.QSPI_SS, b: BOOTSEL }
    }
    else null
  SW_BOOT = if bootButton then button("6x6") { pins { a: BOOTSEL, b: chip.pin.GND } } else null
  R_RUN = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.RUN, max = 5mm), weight = 1)]
    pins { a: chip.pin.RUN, b: chip.pin.IOVDD }
  }
}
