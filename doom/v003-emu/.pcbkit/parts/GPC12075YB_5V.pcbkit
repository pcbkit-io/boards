pcbkit 1

// GPC12075YB-5V4000 (Dongguan INGHAi Electronics): Passive piezo buzzer (externally driven), Ø12
// x 7.5 mm, through hole with pins 6.5 mm apart, 4 kHz resonance, 80 dB at 10 cm; pins A, B (no
// polarity)
// Compiled from the part sheet `parts/GPC12075YB_5V.json` (`parts.create`); status: checked.
// Datasheet: https://datasheet.lcsc.com/datasheet/pdf/aa9ae187e1f2138c02f137817cd80bf6.pdf (INGHAi
// GPC12075YB-5V4000 specification for approval V1.1 (2014-01-10))
// Pins: INGHAi GPC12075YB-5V4000 specification: A. dimensions (Ø12, 7.5 mm, pins Ø0.7 at 6.5
// mm), B. specifications
// Footprint: as given
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: Passive: it sounds only when driven with an AC signal: a square wave from a GPIO (PWM,
// `tone()`), loudest near 4 kHz. Directly from the pin (it draws under 5 mA, a 10 nF load) between
// A and GND, or louder from a transistor stage.
// Note: An active buzzer (a built-in oscillator, sounds on DC) has the same body: this one needs
// the signal.

/// GPC12075YB-5V4000 — Passive piezo buzzer (externally driven), Ø12 x 7.5 mm, through hole with
/// pins 6.5 mm apart, 4 kHz resonance, 80 dB at 10 cm; pins A, B (no polarity)
part Part = device(footprint = Footprint {
  let ps = [
    thtPad("1", (-3.25mm, 0mm), 1mm, (1.8mm, 1.8mm), square = true),
    thtPad("2", (3.25mm, 0mm), 1mm, (1.8mm, 1.8mm)),
  ]
  let b = centered(12mm, 12mm)
  name = "Buzzer_D12.0mm_H7.5mm_P6.50mm"
  description = "Buzzer Ø12 mm, 7.5 mm high, two pins 6.5 mm apart, 1.0 mm holes"
  tags = ["buzzer", "piezo", "THT"]
  pads = ps
  body = b
  height = 7.5mm
  silk = silkOf(ps, b, 0.25mm, path = [
    (0mm, 6.11mm),
    (-4.32mm, 4.32mm),
    (-6.11mm, 0mm),
    (-4.32mm, -4.32mm),
    (0mm, -6.11mm),
    (4.32mm, -4.32mm),
    (6.11mm, 0mm),
    (4.32mm, 4.32mm),
    (0mm, 6.11mm),
  ])
  package = Package { family = .other; body = (12mm, 12mm); height = 7.5mm }
  solids = [
    solid.cylinder(12mm, 7.5mm, at = (0mm, 0mm, 0mm), color = "#141414"),
    solid.cylinder(2mm, 0.05mm, at = (0mm, 0mm, 7.5mm), color = "#000000"),
  ]
}, prefix = "BZ", mpn = "GPC12075YB-5V4000", manufacturer = "Dongguan INGHAi Electronics", orderCode = "C252948", pinout = {
  A: "1",
  B: "2",
}, pinTypes = {
  A: .passive,
  B: .passive,
}) with {
  fields {
    Status: "checked",
    PinoutSource: "INGHAi GPC12075YB-5V4000 specification: A. dimensions (Ø12, 7.5 mm, pins Ø0.7 at 6.5 mm), B. specifications",
    Datasheet: "https://datasheet.lcsc.com/datasheet/pdf/aa9ae187e1f2138c02f137817cd80bf6.pdf",
  }
}
