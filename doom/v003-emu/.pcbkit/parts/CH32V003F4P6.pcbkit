pcbkit 2

// CH32V003F4P6 (WCH (Nanjing Qinheng Microelectronics)): CH32V003 32-bit RISC-V (QingKe V2A) MCU,
// 48 MHz, 16 KB flash, 2 KB SRAM, USART, SPI, I2C, 8-channel 10-bit ADC, op-amp, single-wire
// debug, 2.7-5.5 V, TSSOP-20
// Compiled from the part sheet `parts/CH32V003F4P6.json` (`parts.create`); status: checked.
// Datasheet: https://www.wch-ic.com/downloads/CH32V003DS0_PDF.html (CH32V003 datasheet V1.8
// (Chinese edition, via LCSC))
// Pins: WCH CH32V003 datasheet V1.8 (Chinese, from LCSC's mirror): 2.1 pin arrangement
// (CH32V003F4P6), 2.2 table 2-1 pin definitions, 3.1 figure 3-1, 3.2 table 3-1 absolute maximum,
// 3.3.1 table 3-2 operating conditions, 4.1 TSSOP20 package
// Footprint: the standard package `TSSOP-20`
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: Runs from 5 V or 3.3 V directly; I/Os follow VDD.
// Note: Peripherals remap (the `_` suffix in the function names is a remapped position): check
// AFIO before choosing pins.
// Note: One supply pin: a single 100 nF next to pins 7 and 9.

/// CH32V003F4P6 — CH32V003 32-bit RISC-V (QingKe V2A) MCU, 48 MHz, 16 KB flash, 2 KB SRAM, USART,
/// SPI, I2C, 8-channel 10-bit ADC, op-amp, single-wire debug, 2.7-5.5 V, TSSOP-20
part Part = device(
  footprint = tssop(20),
  prefix = "U",
  mpn = "CH32V003F4P6",
  manufacturer = "WCH (Nanjing Qinheng Microelectronics)",
  pinout = {
    PD4 = "1"
    PD5 = "2"
    PD6 = "3"
    PD7 = "4"
    PA1 = "5"
    PA2 = "6"
    VSS = "7"
    PD0 = "8"
    VDD = "9"
    PC0 = "10"
    PC1 = "11"
    PC2 = "12"
    PC3 = "13"
    PC4 = "14"
    PC5 = "15"
    PC6 = "16"
    PC7 = "17"
    PD1 = "18"
    PD2 = "19"
    PD3 = "20"
  },
  pinTypes = {
    PD4 = io.bidirectional()
    PD5 = io.bidirectional()
    PD6 = io.bidirectional()
    PD7 = io.bidirectional()
    PA1 = io.bidirectional()
    PA2 = io.bidirectional()
    VSS = .ground
    PD0 = io.bidirectional()
    VDD = io.powerIn(min = 2.7V, max = 5.5V)
    PC0 = io.bidirectional()
    PC1 = io.bidirectional()
    PC2 = io.bidirectional()
    PC3 = io.bidirectional()
    PC4 = io.bidirectional()
    PC5 = io.bidirectional()
    PC6 = io.bidirectional()
    PC7 = io.bidirectional()
    PD1 = io.bidirectional()
    PD2 = io.bidirectional()
    PD3 = io.bidirectional()
  },
) with {
  fields {
    Status = "checked"
    PinoutSource = "WCH CH32V003 datasheet V1.8 (Chinese, from LCSC's mirror): 2.1 pin arrangement (CH32V003F4P6), 2.2 table 2-1 pin definitions, 3.1 figure 3-1, 3.2 table 3-1 absolute maximum, 3.3.1 table 3-2 operating conditions, 4.1 TSSOP20 package"
    Datasheet = "https://www.wch-ic.com/downloads/CH32V003DS0_PDF.html"
  }
  simulation = SimulationParameters {
    // The chip in PCBKit's laboratory: its GPIOs by name; SPI1 and USART1 are carried by the pins
    // a board wires them to (their alternate functions).
    behavior = Behavior {
      model = "ch32v003"
      ports = {
        "power" = ["9", "7"]
        "PA1" = ["5"]
        "PA2" = ["6"]
        "PC0" = ["10"]
        "PC1" = ["11"]
        "PC2" = ["12"]
        "PC3" = ["13"]
        "PC4" = ["14"]
        "PC5" = ["15"]
        "PC6" = ["16"]
        "PC7" = ["17"]
        "PD0" = ["8"]
        "PD1" = ["18"]
        "PD2" = ["19"]
        "PD3" = ["20"]
        "PD4" = ["1"]
        "PD5" = ["2"]
        "PD6" = ["3"]
        "PD7" = ["4"]
      }
      height = 1.2mm
    }
    parameters = [
      SimulationParameter {
        id = "idd-run-48mhz-3v3"
        quantity = .supplyCurrent
        typ = 6.4mA
        conditions = "Run mode from internal Flash, 48 MHz from the high-speed internal RC (HSI), all peripherals enabled, VDD=3.3 V, room temperature; 4.0 mA with all peripherals disabled; at VDD=5 V 7.4 mA / 5.1 mA"
        source = SimulationEvidence {
          url = "https://www.electrokit.com/upload/quick/97/f1/422a_41036464-tds.pdf"
          revision = "CH32V003 Datasheet V1.8 (title page; the page footers of the copy read V1.7 from p. 14)"
          location = "p. 17, section 3.6, Table 3-6-1 Typical current consumption in Run mode (VDD = 3.3V)"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "tj-operating"
        quantity = .junctionOperatingTemperature
        min = -40degC
        max = 105degC
        conditions = "junction temperature range in the general operating conditions"
        source = SimulationEvidence {
          url = "https://www.electrokit.com/upload/quick/97/f1/422a_41036464-tds.pdf"
          revision = "CH32V003 Datasheet V1.8 (title page; the page footers of the copy read V1.7 from p. 14)"
          location = "p. 15, section 3.3.1, Table 3-2 General operating conditions"
          confidence = .datasheet
        }
      },
    ]
  }
}

/// The support circuit of the CH32V003F4P6 as its datasheet shows it (3.1 figure 3-1 typical supply
/// circuit; 3.3.x figure 3-11 analog supply decoupling; 2.2 table 2-1 pin definitions): every part
/// next to the pin it serves. Add it next to the part: `U1 = CH32V003F4P6.Part { … }`, `U1Support
/// = CH32V003F4P6.Support(U1) {}`.
///
/// - Programming and debug over one wire: PD1 (SWIO), VDD and GND to a WCH-LinkE; a 3-pin header is
/// enough.
///
/// - No crystal needed: the internal 24 MHz RC (48 MHz with the PLL); a 4-25 MHz crystal goes on
/// PA1/PA2 when timing must be precise.
block Support {
  /// The CH32V003F4P6 this circuit serves (`CH32V003F4P6.Support(U1)`).
  chip: Any

  /// next to pins 9 and 7
  C1 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD, max = 2mm), weight = 2)]
    a -- chip.pin.VDD
    b -- chip.pin.VSS
  }
}
