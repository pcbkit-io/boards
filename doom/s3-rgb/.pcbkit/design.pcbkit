U5Support.C7.orderCode = "C47339"
U6Support.CIN.orderCode = "C15849"
U6Support.COUT.orderCode = "C15849"
// The DAC's three supply pins each with its 100 nF right at the pin.
U4Support.C1.place = [near(U4.pin.AVDD, max = 2mm)]
U4Support.C3.place = [near(U4.pin.CPVDD, max = 2mm)]
U4Support.C5.place = [near(U4.pin.DVDD, max = 2mm)]

