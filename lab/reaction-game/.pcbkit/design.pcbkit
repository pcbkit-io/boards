pcbkit 1
// A reaction timer: start lights, a random wait, one button and a MAX7219 for the result.
// Board nets are the executable connections. Module envelopes need physical qualification.
net V5, GND, MOSI, SCK, LOAD, PRESS, RED, ORANGE, GREEN
board = Board {
  name = "Reaction game"
  description = "Start lights · random wait · millisecond timing · best score"
  outline = rect(92mm, 72mm, radius = 8mm)
  fab { mask = .red, finish = .enig }
}
U1 = labMcu(
  {
    power: ["4", "3"],
    spi0: ["15", "17"],
    PB2: ["14"],
    PD2: ["32"],
    PD5: ["9"],
    PD6: ["10"],
    PD7: ["11"],
  },
  firmware = "firmware",
) {
  at = (18mm, 28mm)
  pins {
    "4": V5,
    "3": GND,
    "15": MOSI,
    "17": SCK,
    "14": LOAD,
    "32": PRESS,
    "9": RED,
    "10": ORANGE,
    "11": GREEN,
  }
}
display = labDisplay() {
  at = (46mm, 58mm)
  pins = [V5, GND, MOSI, SCK, LOAD]
}
red = labIndicator(.red, 10mA) {
  at = (36mm, 44mm)
  pins = [V5, GND, RED]
}
orange = labIndicator(.orange, 10mA) {
  at = (46mm, 44mm)
  pins = [V5, GND, ORANGE]
}
green = labIndicator(.green, 10mA) {
  at = (56mm, 44mm)
  pins = [V5, GND, GREEN]
}
button = labButton() {
  at = (46mm, 24mm)
  pins = [V5, GND, PRESS]
}
battery = labBattery() {
  at = (80mm, 30mm)
  rotation = 90deg
  pins = [V5, GND]
}
gnd = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}
holes = MountingHoles(screw = "M2", corners = [.bottomLeft, .topLeft, .topRight]) {}
// A target round the button.
target = map([9mm, 11.5mm], fn(r) -> [
  Arc { center = (46mm, 24mm), radius = r, start = 0deg, angle = 180deg, width = 0.3mm },
  Arc { center = (46mm, 24mm), radius = r, start = 180deg, angle = 180deg, width = 0.3mm },
])
press = Text {
  text = "PRESS"
  at = (46mm, 9mm)
  size = 1.6mm
}
title = Text {
  text = "REACTION"
  at = (18mm, 42mm)
  size = 1.6mm
}
