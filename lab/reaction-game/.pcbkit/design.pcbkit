pcbkit 2
use ./parts/ARDUINO_NANO as ARDUINO_NANO
use ./parts/MAX7219_7SEG_MODULE as MAX7219_7SEG_MODULE
// A reaction timer: start lights, a random wait, one button and a MAX7219 for the result.
net V5, GND, MOSI, SCK, LOAD, PRESS, RED, ORANGE, GREEN, RED_K, ORANGE_K, GREEN_K
// The parts every lab board shares: a light (an LED from its pin through 1 kΩ, `.green` to
// `.white`), a key (a tactile switch to ground, the pin's pull-up on; in the lab the keyboard key
// named), a knob (a 10 kΩ pot between 5 V and ground into an ADC pin) and the FTDI header.
fn light(color: LedColor) -> Part = led(package = "1206", color = color) with {
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "indicator"
      ports = { input = ["2"] }
      parameters = { color = labColorIndex(color), milliamps = 3 }
    }
  }
}
fn key(code: String) -> Part = button("6x6") with {
  simulation = SimulationParameters {
    behavior = Behavior { model = "button", ports = { output = ["1"] }, key = code }
  }
}

board = Board {
  name = "Reaction game"
  description = "Start lights · random wait · millisecond timing · best score"
  outline = rect(92mm, 82mm, radius = 8mm)
  fab { mask = .red, finish = .enig }
}
// The processor: an Arduino Nano on two 15-pin sockets on the back, flashed over its USB (its
// bootloader); the program in firmware/ is plain C for its ATmega328P.
U1 = ARDUINO_NANO.ARDUINO_NANO with {
  simulation = ARDUINO_NANO.ARDUINO_NANO.simulation with {
    behavior = ARDUINO_NANO.ARDUINO_NANO.simulation.behavior with { firmware = "firmware" }
  }
} {
  at = (46mm, 40mm)
  rotation = 90deg
  side = .bottom
  P5V -- V5
  GND -- GND
  D11 -- MOSI
  D13 -- SCK
  D10 -- LOAD
  D2 -- PRESS
  D5 -- RED
  D6 -- ORANGE
  D7 -- GREEN
}
display = MAX7219_7SEG_MODULE.MAX7219_7SEG_MODULE {
  at = (46mm, 62mm)
  VCC -- V5
  GND -- GND
  DIN -- MOSI
  CS -- LOAD
  CLK -- SCK
}
red = light(.red) {
  at = (36mm, 44mm)
  A -- RED
  K -- RED_K
}
redR = res(1kohm, package = "0603") {
  place = [soft(near(red, max = 4mm))]
  a -- RED_K
  b -- GND
}
orange = light(.orange) {
  at = (46mm, 44mm)
  A -- ORANGE
  K -- ORANGE_K
}
orangeR = res(1kohm, package = "0603") {
  place = [soft(near(orange, max = 4mm))]
  a -- ORANGE_K
  b -- GND
}
green = light(.green) {
  at = (56mm, 44mm)
  A -- GREEN
  K -- GREEN_K
}
greenR = res(1kohm, package = "0603") {
  place = [soft(near(green, max = 4mm))]
  a -- GREEN_K
  b -- GND
}
pushbutton = key("Space") {
  at = (46mm, 24mm)
  a -- PRESS
  b -- GND
}
gnd = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}
holes = MountingHoles {
  screw = "M2"
  corners = [.bottomLeft, .topLeft, .topRight]
}
// A target round the button.
target = map([9mm, 11.5mm], r => [
  Arc { center = (46mm, 24mm), radius = r, start = 0deg, angle = 180deg, width = 0.3mm },
  Arc { center = (46mm, 24mm), radius = r, start = 180deg, angle = 180deg, width = 0.3mm },
])
press = Text {
  text = "PRESS"
  at = (46mm, 9mm)
  size = 1.6mm
}
title = Text {
  text = "REACTION"
  at = (18mm, 42mm)
  size = 1.6mm
}
