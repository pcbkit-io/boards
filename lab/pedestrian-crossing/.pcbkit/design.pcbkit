pcbkit 2
use ./parts/ARDUINO_NANO as ARDUINO_NANO
use ./parts/MAX7219_7SEG_MODULE as MAX7219_7SEG_MODULE
// A pedestrian crossing: a light for cars, one for people, a request button and a countdown.
net V5, GND, MOSI, SCK, LOAD, REQUEST, CAR_RED, CAR_AMBER, CAR_GREEN, WALK_RED, WALK_GREEN,
  CAR_RED_K, CAR_AMBER_K, CAR_GREEN_K, WALK_RED_K, WALK_GREEN_K
// The parts every lab board shares: a light (an LED from its pin through 1 kΩ, `.green` to
// `.white`), a key (a tactile switch to ground, the pin's pull-up on; in the lab the keyboard key
// named), a knob (a 10 kΩ pot between 5 V and ground into an ADC pin) and the FTDI header.
fn light(color: LedColor) -> Part = led(package = "1206", color = color) with {
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "indicator"
      ports = { input = ["2"] }
      parameters = { color = labColorIndex(color), milliamps = 3 }
    }
  }
}
fn key(code: String) -> Part = button("6x6") with {
  simulation = SimulationParameters {
    behavior = Behavior { model = "button", ports = { output = ["1"] }, key = code }
  }
}

board = Board {
  name = "Pedestrian crossing"
  description = "State machine · request button · countdown · flashing walk"
  outline = rect(92mm, 110mm, radius = 6mm)
  fab { mask = .yellow, silk = .black, finish = .enig }
}
// The processor: an Arduino Nano on two 15-pin sockets on the back, flashed over its USB (its
// bootloader); the program in firmware/ is plain C for its ATmega328P.
U1 = ARDUINO_NANO.ARDUINO_NANO with {
  simulation = ARDUINO_NANO.ARDUINO_NANO.simulation with {
    behavior = ARDUINO_NANO.ARDUINO_NANO.simulation.behavior with { firmware = "firmware" }
  }
} {
  at = (24mm, 40mm)
  rotation = 90deg
  side = .bottom
  P5V -- V5
  GND -- GND
  D11 -- MOSI
  D13 -- SCK
  D10 -- LOAD
  D2 -- REQUEST
  D5 -- CAR_RED
  D6 -- CAR_AMBER
  D7 -- CAR_GREEN
  D8 -- WALK_RED
  D9 -- WALK_GREEN
}
carRed = light(.red) {
  at = (22mm, 98mm)
  A -- CAR_RED
  K -- CAR_RED_K
}
carRedR = res(1kohm, package = "0603") {
  place = [soft(near(carRed, max = 4mm))]
  a -- CAR_RED_K
  b -- GND
}
carAmber = light(.orange) {
  at = (22mm, 88mm)
  A -- CAR_AMBER
  K -- CAR_AMBER_K
}
carAmberR = res(1kohm, package = "0603") {
  place = [soft(near(carAmber, max = 4mm))]
  a -- CAR_AMBER_K
  b -- GND
}
carGreen = light(.green) {
  at = (22mm, 78mm)
  A -- CAR_GREEN
  K -- CAR_GREEN_K
}
carGreenR = res(1kohm, package = "0603") {
  place = [soft(near(carGreen, max = 4mm))]
  a -- CAR_GREEN_K
  b -- GND
}
walkRed = light(.red) {
  at = (58mm, 98mm)
  A -- WALK_RED
  K -- WALK_RED_K
}
walkRedR = res(1kohm, package = "0603") {
  place = [soft(near(walkRed, max = 4mm))]
  a -- WALK_RED_K
  b -- GND
}
walkGreen = light(.green) {
  at = (58mm, 88mm)
  A -- WALK_GREEN
  K -- WALK_GREEN_K
}
walkGreenR = res(1kohm, package = "0603") {
  place = [soft(near(walkGreen, max = 4mm))]
  a -- WALK_GREEN_K
  b -- GND
}
display = MAX7219_7SEG_MODULE.MAX7219_7SEG_MODULE {
  at = (46mm, 62mm)
  VCC -- V5
  GND -- GND
  DIN -- MOSI
  CS -- LOAD
  CLK -- SCK
}
request = key("Space") {
  at = (58mm, 40mm)
  a -- REQUEST
  b -- GND
}
gnd = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}
holes = MountingHoles { screw = "M2" }
// The two lights' housings.
fn closed(points: List[Point]) -> List[Point] = concat(points, [first(points)])
housings = [
  Line { points = closed(translated(rect(14mm, 34mm, radius = 3mm), (15mm, 71mm))), width = 0.5mm },
  Line { points = closed(translated(rect(14mm, 24mm, radius = 3mm), (51mm, 81mm))), width = 0.5mm },
]
cars = Text {
  text = "CARS"
  at = (22mm, 68mm)
  size = 1.2mm
}
people = Text {
  text = "WALK"
  at = (58mm, 78mm)
  size = 1.2mm
}
push = Text {
  text = "PUSH"
  at = (58mm, 32mm)
  size = 1.4mm
}
title = Text {
  text = "PEDESTRIAN CROSSING"
  at = (40mm, 51mm)
  size = 1.4mm
}
