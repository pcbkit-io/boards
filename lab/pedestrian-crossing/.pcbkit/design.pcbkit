pcbkit 1
// A pedestrian crossing: a light for cars, one for people, a request button and a countdown.
// Board nets are the executable connections. Module envelopes need physical qualification.
net V5, GND, MOSI, SCK, LOAD, REQUEST, CAR_RED, CAR_AMBER, CAR_GREEN, WALK_RED, WALK_GREEN
board = Board {
  name = "Pedestrian crossing"
  description = "State machine · request button · countdown · flashing walk"
  outline = rect(80mm, 110mm, radius = 6mm)
  fab { mask = .yellow, silk = .black, finish = .enig }
}
U1 = labMcu(
  {
    power: ["4", "3"],
    spi0: ["15", "17"],
    PB2: ["14"],
    PD2: ["32"],
    PD5: ["9"],
    PD6: ["10"],
    PD7: ["11"],
    PB0: ["12"],
    PB1: ["13"],
  },
  firmware = "firmware",
) {
  at = (24mm, 40mm)
  pins {
    "4": V5,
    "3": GND,
    "15": MOSI,
    "17": SCK,
    "14": LOAD,
    "32": REQUEST,
    "9": CAR_RED,
    "10": CAR_AMBER,
    "11": CAR_GREEN,
    "12": WALK_RED,
    "13": WALK_GREEN,
  }
}
carRed = labIndicator(.red, 10mA) {
  at = (22mm, 98mm)
  pins = [V5, GND, CAR_RED]
}
carAmber = labIndicator(.orange, 10mA) {
  at = (22mm, 88mm)
  pins = [V5, GND, CAR_AMBER]
}
carGreen = labIndicator(.green, 10mA) {
  at = (22mm, 78mm)
  pins = [V5, GND, CAR_GREEN]
}
walkRed = labIndicator(.red, 10mA) {
  at = (58mm, 98mm)
  pins = [V5, GND, WALK_RED]
}
walkGreen = labIndicator(.green, 10mA) {
  at = (58mm, 88mm)
  pins = [V5, GND, WALK_GREEN]
}
display = labDisplay() {
  at = (40mm, 62mm)
  pins = [V5, GND, MOSI, SCK, LOAD]
}
request = labButton() {
  at = (58mm, 40mm)
  pins = [V5, GND, REQUEST]
}
battery = labBattery() {
  at = (40mm, 15mm)
  rotation = 180deg
  pins = [V5, GND]
}
gnd = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}
holes = MountingHoles(screw = "M2") {}
// The two lights' housings.
fn closed(points: List<Point>): List<Point> = concat(points, [first(points)])
housings = [
  Line { points = closed(translated(rect(14mm, 34mm, radius = 3mm), (15mm, 71mm))), width = 0.5mm },
  Line { points = closed(translated(rect(14mm, 24mm, radius = 3mm), (51mm, 81mm))), width = 0.5mm },
]
cars = Text {
  text = "CARS"
  at = (22mm, 68mm)
  size = 1.2mm
}
people = Text {
  text = "WALK"
  at = (58mm, 78mm)
  size = 1.2mm
}
push = Text {
  text = "PUSH"
  at = (58mm, 32mm)
  size = 1.4mm
}
title = Text {
  text = "PEDESTRIAN CROSSING"
  at = (40mm, 51mm)
  size = 1.4mm
}
