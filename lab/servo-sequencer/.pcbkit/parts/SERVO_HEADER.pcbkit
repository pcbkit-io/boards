pcbkit 2

// RC servo header, 1 x 3 pins, 2.54 mm (generic): Header for one RC servo (SG90, MG90S,
// MG996R…): 1 x 3 male pins at 2.54 mm in the servo plug's order, GND (brown) - V+ (red, middle)
// - SIGNAL (orange)
// Compiled from the part sheet `parts/SERVO_HEADER.json` (`parts.create`); status: checked.
// Datasheet: https://static.rapidonline.com/pdf/37-1330t.pdf (Tower Pro SG90 mini servo, Rapid
// 37-1330 sheet (October 2013): 4.8 V operation, 1.8 kg·cm stall torque, 23 x 12.2 x 29 mm)
// Pins: the RC servo plug's wire order (brown ground, red V+ in the middle, orange signal, as
// Tower Pro labels the SG90's lead); SG90 ratings from the Rapid 37-1330 datasheet
// Footprint: as given
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: Servo plugs (JR / Futaba style) all put V+ in the middle; the outer pins are ground and
// signal. Mark the GND end on the silkscreen (brown wire).

/// RC servo header, 1 x 3 pins, 2.54 mm — Header for one RC servo (SG90, MG90S, MG996R…): 1 x 3
/// male pins at 2.54 mm in the servo plug's order, GND (brown) - V+ (red, middle) - SIGNAL (orange)
part SERVO_HEADER: Part {
  footprint = pinHeader(3)
  prefix = "J"
  mpn = "RC servo header, 1 x 3 pins, 2.54 mm"
  manufacturer = "generic"
  pinout = { GND = "1", VPLUS = "2", SIG = "3" }
  pinTypes = { GND = .ground, VPLUS = io.powerIn(min = 4.8V, max = 6V), SIG = io.input() }
  fields {
    Status = "checked"
    PinoutSource = "the RC servo plug's wire order (brown ground, red V+ in the middle, orange signal, as Tower Pro labels the SG90's lead); SG90 ratings from the Rapid 37-1330 datasheet"
    Datasheet = "https://static.rapidonline.com/pdf/37-1330t.pdf"
  }
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "servo"
      ports = { "power" = ["2", "1"], "signal" = ["3"] }
      parameters = { "maximum_us" = 2400, "minimum_us" = 544 }
      height = 22mm
    }
    parameters = []
  }
}

/// The support circuit of the RC servo header, 1 x 3 pins, 2.54 mm as its datasheet shows it (our
/// own circuit): every part next to the pin it serves. Add it next to the part: `U1 =
/// SERVO_HEADER.SERVO_HEADER { … }`, `U1Support = SERVO_HEADER.Support(U1) {}`.
///
/// - A servo draws hundreds of mA moving and much more when stalled: feed V+ from a 5 V supply (or
/// a 2S pack through a 5-6 V regulator) with wide tracks, never through a USB port's 500 mA for
/// several servos, and join its ground with the controller's.
///
/// - The pulse: 50 Hz, about 1.0 ms one end, 1.5 ms centre, 2.0 ms the other end (many servos
/// accept 0.5-2.5 ms). Many servos at once: a PCA9685 (`PCA9685PW`) makes the pulses over I2C.
block Support {
  /// The RC servo header, 1 x 3 pins, 2.54 mm this circuit serves (`SERVO_HEADER.Support(U1)`).
  chip: Any
  /// The controller pin it connects to. (`null`: its parts are left out)
  gpio: Endpoint? = null

  /// our choice: electrolytic, 10 V, near the header (one per few servos)
  C1 = cap(220uF, package = "D8xL10", ratedVoltage = 10V) {
    place = [soft(near(chip.pin.VPLUS, max = 4mm), weight = 2)]
    a -- chip.pin.VPLUS
    b -- chip.pin.GND
  }
  /// our choice: series resistor from the controller's PWM pin
  R1 =
    if gpio != null then res(220ohm, package = "0402") {
      place = [soft(near(chip.pin.SIG, max = 5mm), weight = 1)]
      a -- chip.pin.SIG
      b -- gpio
    }
    else null
}
