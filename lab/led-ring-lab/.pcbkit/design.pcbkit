pcbkit 1
// Twelve lights in a ring, each dimmed by a software PWM in a timer interrupt.
// Board nets are the executable connections. Module envelopes need physical qualification.
net V5, GND, SPEED, MODE, L0, L1, L2, L3, L4, L5, L6, L7, L8, L9, L10, L11
board = Board {
  name = "LED ring"
  description = "Software PWM · spinning comet · dial gauge · breathing wave"
  outline = circle((40mm, 40mm), 40mm)
  fab { mask = .matteBlack, finish = .enig }
}
/// Light i of twelve, clockwise from the top, 32 mm from the centre.
fn ring(i: Int): Point = (
  clean(40mm + 32mm * cos((90 - 30 * i) * 1deg)),
  clean(40mm + 32mm * sin((90 - 30 * i) * 1deg)),
)
U1 = labMcu(
  {
    power: ["4", "3"],
    ADC0: ["23"],
    PC1: ["24"],
    PD0: ["30"],
    PD1: ["31"],
    PD2: ["32"],
    PD3: ["1"],
    PD4: ["2"],
    PD5: ["9"],
    PD6: ["10"],
    PD7: ["11"],
    PB0: ["12"],
    PB1: ["13"],
    PB2: ["14"],
    PB3: ["15"],
  },
  firmware = "firmware",
) {
  at = (40mm, 46mm)
  pins {
    "4": V5,
    "3": GND,
    "23": SPEED,
    "24": MODE,
    "30": L0,
    "31": L1,
    "32": L2,
    "1": L3,
    "2": L4,
    "9": L5,
    "10": L6,
    "11": L7,
    "12": L8,
    "13": L9,
    "14": L10,
    "15": L11,
  }
}
led0 = labIndicator(.green, 5mA) {
  at = ring(0)
  rotation = 0deg
  pins = [V5, GND, L0]
}
led1 = labIndicator(.green, 5mA) {
  at = ring(1)
  rotation = 330deg
  pins = [V5, GND, L1]
}
led2 = labIndicator(.green, 5mA) {
  at = ring(2)
  rotation = 300deg
  pins = [V5, GND, L2]
}
led3 = labIndicator(.green, 5mA) {
  at = ring(3)
  rotation = 270deg
  pins = [V5, GND, L3]
}
led4 = labIndicator(.orange, 5mA) {
  at = ring(4)
  rotation = 240deg
  pins = [V5, GND, L4]
}
led5 = labIndicator(.orange, 5mA) {
  at = ring(5)
  rotation = 210deg
  pins = [V5, GND, L5]
}
led6 = labIndicator(.orange, 5mA) {
  at = ring(6)
  rotation = 180deg
  pins = [V5, GND, L6]
}
led7 = labIndicator(.orange, 5mA) {
  at = ring(7)
  rotation = 150deg
  pins = [V5, GND, L7]
}
led8 = labIndicator(.red, 5mA) {
  at = ring(8)
  rotation = 120deg
  pins = [V5, GND, L8]
}
led9 = labIndicator(.red, 5mA) {
  at = ring(9)
  rotation = 90deg
  pins = [V5, GND, L9]
}
led10 = labIndicator(.red, 5mA) {
  at = ring(10)
  rotation = 60deg
  pins = [V5, GND, L10]
}
led11 = labIndicator(.red, 5mA) {
  at = ring(11)
  rotation = 30deg
  pins = [V5, GND, L11]
}
speed = labKnob(0.4) {
  at = (27mm, 48mm)
  pins = [V5, GND, SPEED]
}
mode = labButton() {
  at = (53mm, 48mm)
  pins = [V5, GND, MODE]
}
battery = labBattery() {
  at = (40mm, 28mm)
  rotation = 180deg
  pins = [V5, GND]
}
gnd = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}
title = Text {
  text = "LED RING"
  at = (40mm, 61mm)
  size = 1.6mm
}
speedLabel = Text {
  text = "SPEED"
  at = (27mm, 40mm)
  size = 1mm
}
modeLabel = Text {
  text = "MODE"
  at = (53mm, 41.5mm)
  size = 1mm
}
