pcbkit 1
// A stopwatch: Timer0 counts milliseconds in decimal, a MAX7219 shows hours to hundredths.
// Board nets are the executable connections. Module envelopes need physical qualification.
net V5, GND, MOSI, SCK, LOAD, RUN, LAP, GREEN, ORANGE, RED
board = Board {
  name = "Stopwatch"
  description = "Timer interrupt · MAX7219 · run switch · lap and reset"
  outline = circle((45mm, 45mm), 45mm)
  fab { mask = .white, silk = .black, finish = .enig }
}
U1 = labMcu(
  {
    power: ["4", "3"],
    spi0: ["15", "17"],
    PB2: ["14"],
    PD2: ["32"],
    PD3: ["1"],
    PD5: ["9"],
    PD6: ["10"],
    PD7: ["11"],
  },
  firmware = "firmware",
) {
  at = (45mm, 36mm)
  pins {
    "4": V5,
    "3": GND,
    "15": MOSI,
    "17": SCK,
    "14": LOAD,
    "32": RUN,
    "1": LAP,
    "9": GREEN,
    "10": ORANGE,
    "11": RED,
  }
}
display = labDisplay() {
  at = (45mm, 52mm)
  pins = [V5, GND, MOSI, SCK, LOAD]
}
run = labButton() {
  at = (31mm, 75mm)
  pins = [V5, GND, RUN]
}
lap = labButton() {
  at = (59mm, 75mm)
  pins = [V5, GND, LAP]
}
green = labIndicator(.green) {
  at = (37mm, 66mm)
  pins = [V5, GND, GREEN]
}
orange = labIndicator(.orange) {
  at = (45mm, 66mm)
  pins = [V5, GND, ORANGE]
}
red = labIndicator(.red) {
  at = (53mm, 66mm)
  pins = [V5, GND, RED]
}
battery = labBattery() {
  at = (45mm, 20mm)
  rotation = 180deg
  pins = [V5, GND]
}
gnd = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}
runLabel = Text {
  text = "RUN"
  at = (24mm, 75mm)
  size = 1.2mm
  justify = .right
}
lapLabel = Text {
  text = "LAP"
  at = (66mm, 75mm)
  size = 1.2mm
  justify = .left
}
title = Text {
  text = "STOPWATCH"
  at = (45mm, 61.5mm)
  size = 1.6mm
}
// The dial: a minute track round the edge, every fifth tick longer.
dial = concat(
  [
    Arc { center = (45mm, 45mm), radius = 43.3mm, start = 0deg, angle = 180deg, width = 0.2mm },
    Arc { center = (45mm, 45mm), radius = 43.3mm, start = 180deg, angle = 180deg, width = 0.2mm },
  ],
  map(range(0, 60), fn(i) -> Line {
    points = [
      (clean(45mm + 43mm * cos(i * 6deg)), clean(45mm + 43mm * sin(i * 6deg))),
      (
        clean(45mm + (if i % 5 == 0 then 39.5mm else 41.3mm) * cos(i * 6deg)),
        clean(45mm + (if i % 5 == 0 then 39.5mm else 41.3mm) * sin(i * 6deg)),
      ),
    ]
    width = if i % 5 == 0 then 0.4mm else 0.18mm
  }),
)
