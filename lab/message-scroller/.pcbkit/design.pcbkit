pcbkit 2
use ./parts/ARDUINO_NANO as ARDUINO_NANO
use ./parts/MAX7219_7SEG_MODULE as MAX7219_7SEG_MODULE
use ./parts/PTV09A_4020F_B103 as PTV09A_4020F_B103
// A message scroller: type text into the serial console, it scrolls across eight digits.
net V5, GND, TX, RX, MOSI, SCK, LOAD, SPEED
// The parts every lab board shares: a light (an LED from its pin through 1 kΩ, `.green` to
// `.white`), a key (a tactile switch to ground, the pin's pull-up on; in the lab the keyboard key
// named), a knob (a 10 kΩ pot between 5 V and ground into an ADC pin) and the FTDI header.
fn knob(position: Number) -> Part = PTV09A_4020F_B103.PTV09A_4020F_B103 with {
  simulation = PTV09A_4020F_B103.PTV09A_4020F_B103.simulation with {
    behavior = PTV09A_4020F_B103.PTV09A_4020F_B103.simulation.behavior with {
      parameters = { position = position, volts = 5, ohms = 10000 }
    }
  }
}
fn ftdi() -> Part = header(6) with {
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "serial-terminal"
      ports = { power = ["3", "1"], uart = ["5", "4"] }
      parameters = { baud = 9600 }
    }
  }
}

board = Board {
  name = "Message scroller"
  description = "UART receive interrupt · seven-segment font · scrolling text"
  outline = rect(92mm, 72mm, radius = 4mm)
  fab { mask = .purple, finish = .enig }
}
// The processor: an Arduino Nano on two 15-pin sockets on the back, flashed over its USB (its
// bootloader); the program in firmware/ is plain C for its ATmega328P.
U1 = ARDUINO_NANO.ARDUINO_NANO with {
  simulation = ARDUINO_NANO.ARDUINO_NANO.simulation with {
    behavior = ARDUINO_NANO.ARDUINO_NANO.simulation.behavior with { firmware = "firmware" }
  }
} {
  at = (46mm, 29mm)
  rotation = 90deg
  side = .bottom
  P5V -- V5
  GND -- GND
  D1 -- TX
  D0 -- RX
  D11 -- MOSI
  D13 -- SCK
  D10 -- LOAD
  A0 -- SPEED
}
display = MAX7219_7SEG_MODULE.MAX7219_7SEG_MODULE {
  at = (46mm, 60mm)
  VCC -- V5
  GND -- GND
  DIN -- MOSI
  CS -- LOAD
  CLK -- SCK
}
// A 6-pin FTDI header: plug a USB-serial adapter in (or use the Nano's own USB, the same UART).
console = ftdi() {
  at = (16mm, 29mm)
  pins = [GND, .nc, V5, RX, TX, .nc]
}
speed = knob(0.5) {
  at = (76mm, 30mm)
  CCW -- GND
  W -- SPEED
  CW -- V5
  MP -- GND
}
gnd = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}
title = Text {
  text = "MESSAGE\nSCROLLER"
  at = (76mm, 10mm)
  size = 1.3mm
}
holes = MountingHoles {
  screw = "M2"
  corners = [.bottomLeft, .bottomRight]
}
serialLabel = Text {
  text = "UART 9600"
  at = (16mm, 17mm)
  size = 1mm
}
speedLabel = Text {
  text = "SPEED"
  at = (76mm, 20mm)
  size = 1mm
}
