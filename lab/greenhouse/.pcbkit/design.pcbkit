pcbkit 2
use ./parts/ARDUINO_NANO as ARDUINO_NANO
use ./parts/MAX7219_7SEG_MODULE as MAX7219_7SEG_MODULE
use ./parts/PTV09A_4020F_B103 as PTV09A_4020F_B103
use ./parts/SCD40 as SCD40
use ./parts/SERVO_HEADER as SERVO_HEADER
use ./parts/SHT31_DIS as SHT31_DIS
// A greenhouse controller: temperature and CO₂ open a window on a servo; the knob is the setpoint.
net V5, GND, SDA, SCL, MOSI, SCK, LOAD, SETPOINT, WINDOW, HEAT, VENT, OK, HEAT_K, VENT_K, OK_K
// The parts every lab board shares: a light (an LED from its pin through 1 kΩ, `.green` to
// `.white`), a key (a tactile switch to ground, the pin's pull-up on; in the lab the keyboard key
// named), a knob (a 10 kΩ pot between 5 V and ground into an ADC pin) and the FTDI header.
fn light(color: LedColor) -> Part = led(package = "1206", color = color) with {
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "indicator"
      ports = { input = ["2"] }
      parameters = { color = labColorIndex(color), milliamps = 3 }
    }
  }
}
fn knob(position: Number) -> Part = PTV09A_4020F_B103.Part with {
  simulation = PTV09A_4020F_B103.Part.simulation with {
    behavior = PTV09A_4020F_B103.Part.simulation.behavior with {
      parameters = { position = position, volts = 5, ohms = 10000 }
    }
  }
}

board = Board {
  name = "Greenhouse controller"
  description = "SHT31 · SCD40 · servo window · setpoint knob · MAX7219"
  // A house: the window under the roof.
  outline = polygon([(0mm, 0mm), (100mm, 0mm), (100mm, 58mm), (50mm, 90mm), (0mm, 58mm)])
  fab { mask = .matteGreen, finish = .enig }
}
laboratory = Laboratory {
  temperature = 27degC
  humidity = 60%
  co2 = 700ppm
}
// The processor: an Arduino Nano on two 15-pin sockets on the back, flashed over its USB (its
// bootloader); the program in firmware/ is plain C for its ATmega328P.
U1 = ARDUINO_NANO.Part with {
  simulation = ARDUINO_NANO.Part.simulation with {
    behavior = ARDUINO_NANO.Part.simulation.behavior with { firmware = "firmware" }
  }
} {
  at = (50mm, 20mm)
  rotation = 90deg
  side = .bottom
  P5V -- V5
  GND -- GND
  A4 -- SDA
  A5 -- SCL
  D11 -- MOSI
  D13 -- SCK
  D10 -- LOAD
  A0 -- SETPOINT
  D9 -- WINDOW
  D5 -- HEAT
  D6 -- VENT
  D7 -- OK
}
window = SERVO_HEADER.Part {
  at = (30mm, 64mm)
  GND -- GND
  VPLUS -- V5
  SIG -- WINDOW
}
display = MAX7219_7SEG_MODULE.Part {
  at = (50mm, 45mm)
  VCC -- V5
  GND -- GND
  DIN -- MOSI
  CS -- LOAD
  CLK -- SCK
}
climate = SHT31_DIS.Part {
  at = (12mm, 24mm)
  VDD -- V5
  VSS -- GND
  SDA -- SDA
  SCL -- SCL
  nRESET -- V5
  ALERT -- .nc
}
climateSupport = SHT31_DIS.Support { chip = climate }
co2 = SCD40.Part {
  at = (12mm, 10mm)
  VDD -- V5
  VDDH -- V5
  GND -- GND
  SDA -- SDA
  SCL -- SCL
}
co2Support = SCD40.Support {
  chip = co2
  pullUps = false
}
setpoint = knob(0.4) {
  at = (50mm, 72mm)
  CCW -- GND
  W -- SETPOINT
  CW -- V5
  MP -- GND
}
heat = light(.red) {
  at = (80mm, 26mm)
  A -- HEAT
  K -- HEAT_K
}
heatR = res(1kohm, package = "0603") {
  place = [soft(near(heat, max = 4mm))]
  a -- HEAT_K
  b -- GND
}
vent = light(.orange) {
  at = (80mm, 18mm)
  A -- VENT
  K -- VENT_K
}
ventR = res(1kohm, package = "0603") {
  place = [soft(near(vent, max = 4mm))]
  a -- VENT_K
  b -- GND
}
ok = light(.green) {
  at = (80mm, 10mm)
  A -- OK
  K -- OK_K
}
okR = res(1kohm, package = "0603") {
  place = [soft(near(ok, max = 4mm))]
  a -- OK_K
  b -- GND
}
gnd = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}
title = Text {
  text = "GREENHOUSE"
  at = (70mm, 64mm)
  size = 1.6mm
}
setLabel = Text {
  text = "SETPOINT"
  at = (50mm, 82mm)
  size = 1mm
}
heatLabel = Text {
  text = "HEAT"
  at = (85mm, 26mm)
  size = 0.9mm
  justify = .left
}
ventLabel = Text {
  text = "VENT"
  at = (85mm, 18mm)
  size = 0.9mm
  justify = .left
}
okLabel = Text {
  text = "OK"
  at = (85mm, 10mm)
  size = 0.9mm
  justify = .left
}
