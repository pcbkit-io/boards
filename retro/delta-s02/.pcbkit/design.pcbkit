// Tape: 1 out, 3 in, 4 sound.
XS7 = soviet.ONC5 with {
  // A cassette recorder on it, its sound into contact 3, with the tank game in it: The Scorched
  // Earth (X-Project Association, 1997, freeware), the Russian tape.
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "tape-player"
      ports = { signal: ["3"] }
      image = FirmwareData {
        url = "https://github.com/pcbkit-io/boards/releases/download/delta-s02/scorched_earth-russian.tap"
        sha256 = "0c9e017b70a19051eafd5fde1fa48587a40809ee92d5ca150d0243ac53c2a97a"
        bytes = 15748
      }
      // The board as this tape leaves it once loaded (saved on this board with its ROM): the
      // game at once instead of the tape's two minutes.
      state = FirmwareData {
        url = "https://github.com/pcbkit-io/boards/releases/download/delta-s02/scorched_earth-russian.loaded.state"
        sha256 = "69ae71aab1f1aba41e828b7f6ec1313209497c115683a8c65b83921cb02d9121"
        bytes = 73830
      }
    }
  }
} {
  at = (120.86mm, 140.14mm)
  pins { C1: MICN, C2: GND, C3: TAPEIN, C4: SNDOUT, S: GND }
}

