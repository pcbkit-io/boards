// RGB and composite video to a monitor: 1 video, 3 R, 4 B, 5 G.
XS9 = soviet.ONC5 with {
  // A colour television on it (the RGB inputs of a set, or a monitor): red, green, blue, and the
  // composite signal with sync. Off the board: the laboratory's output (tv.js) shows its picture.
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "raster-display"
      ports = { rgb: ["3", "5", "4"], composite: ["1"] }
      parameters = { width: 480, height: 320, width_mm: 270, height_mm: 180, off_board: 1 }
    }
  }
} {
  at = (161.5mm, 142.17mm)
  pins { C1: VIDEO, C2: GND, C3: OR, C4: OB, C5: OG, S: GND }
}

