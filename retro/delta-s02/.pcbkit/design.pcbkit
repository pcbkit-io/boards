pcbkit 1
// Delta-S02 (Дельта-С-02): the ZX Spectrum 48K compatible home computer Elara (Чебоксары) made in
// 1993, as its factory documents draw it: «Схема электрическая принципиальная БПК Дельта-С»
// (Приложение 5) and «Плата процессора БПК Дельта-С-02» (Приложение 6) of its manual. 52 Soviet
// chips, no ULA: the picture, the memory's RAS/CAS timing and the frame interrupt come from
// counters and gates. Positions are the assembly drawing's (1:1); every chip's function is its
// datasheet's, and the board runs as wired (`simulation`): the ROM, the tape, the picture.

use "parts/soviet.pcbkit" as soviet

board = Board {
  name = "Delta-S02"
  description = "ZX Spectrum 48K compatible (Элара, 1993) · Z80A · 8 × КР565РУ5В · 52 chips"
  outline = rect(285.5mm, 150.2mm)
  fab { mask = .green, silk = .white, finish = .hasl }
}

// In the laboratory: the television on XS9 in the output panel.
laboratory = Laboratory { output = "tv.js" }

net P5V { voltage = 5V }
net GND { voltage = 0V }
net A0, A1, A10, A11, A12, A13, A14, A1415, A15, A2, A3, A4
net A5, A6, A7, A8, A9, AT0, AT1, AT2, AT3, AT4, AT5, AT6
net AT7, BC, BEEP, BEEPE, BLANK, BRD0, BRD1, BRD2, CB, CG, CI, CLK14
net CO20, CO3, CR, CSRAM, CVE, D0, D1, D2, D3, D4, D5, D6
net D7, DB, DG, DR, EAR, F, F7, F7N, FC, FF, FL16, FLN
net FV6, HS, INFU, INKSEL, IOUT, J1, J2, J3, J4, J5, KA10, KA11
net KA12, KA13, KA14, KA15, KA8, KA9, KC, KL0, KL1, KL2, KL3, KL4
net KSEL, M0, M1, M10, M11, M12, M2, M3, M4, M5, M6, M7
net M8, M9, MA0, MA1, MA2, MA3, MA4, MA5, MA6, MA7, MD0, MD1
net MD2, MD3, MD4, MD5, MD6, MD7, MICN, MICO, MIX, OB, OG, OR
net OSC_L, OSC_M, OSC_N, OSC_R, P5V_RF, PA0, PA1, PA10, PA11, PA12, PA13, PA14
net PA15, PA2, PA3, PA4, PA5, PA6, PA7, PA8, PA9, PD0, PD1, PD2
net PD3, PD4, PD5, PD6, PD7, PIXF, PORTLE, PORTW, PRSTB, PRW, R1N, R21N
net RA0, RA1, RA2, RA3, RA4, RA5, RA6, RA7, RAS, RCAS, RDMREQ, RDRF
net RDROM0, RFB, RFC, RFE, RFM, RFOUT, RP, RRAS, RWE, SCR, SH1, SH2
net SNDOUT, STR, SYNC, SYNCX, TAPEIN, TBIAS, TIN, TIN1, V0, V1, V2, V3
net V4, V5, V6, V7, VB, VG, VI, VIDEO, VLD, VR, WIPB, WIPG
net WIPR, WRBUF, WRCYC, Z2, nA1415, nBC, nBK, nBORDER, nBUSAK, nBUSRQ, nCAS, nCC
net nCSRAM, nHALT, nINT, nIORC, nIORQ, nIOWC, nKC, nM1, nM6, nMREQ, nNMI, nPBUSAK
net nPIORQ, nPMREQ, nPRD, nPWR, nRAS, nRD, nRDKL, nRDROM, nRESET, nRFSH, nVF, nWAIT
net nWE, nWR, nWRBUF, nXPM1

