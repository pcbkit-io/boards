// --- Footprints of the Soviet passives and connectors ------------------------------------------

/// Two through-hole pads `pitch` apart along X (pin 1 square at -X).
fn pair(pitch: Length, drill: Length = 0.8mm, pad: Length = 1.6mm) -> List[Pad] = [
  thtPad("1", (clean(-pitch / 2), 0mm), drill, (pad, pad), square = true),
  thtPad("2", (clean(pitch / 2), 0mm), drill, (pad, pad)),
]

/// `count` through-hole pads in a row along X, `pitch` apart, centred (pin 1 square at -X).
fn row(
  count: Int,
  pitch: Length = 2.5mm,
  drill: Length = 0.9mm,
  pad: Length = 1.6mm,
  y: Length = 0mm,
  first: Int = 1,
) -> List[Pad] = map(range(0, count), k => thtPad(
  "\(first + k)",
  (clean((k - (count - 1) / 2) * pitch), y),
  drill,
  (pad, pad),
  square = k == 0 and first == 1,
))

/// МЛТ-0,125: a metal-film resistor lying between holes `pitch` apart, 2.2 x 6 mm, red lacquer.
fn mlt(pitch: Length = 10mm) -> Footprint = Footprint {
  let shape3d = body.axial(pitch, 6mm, 2.2mm, "#9c3b2e")
  name = "R_MLT-0.125_P\(fmt(pitch))mm"
  description = "МЛТ-0,125 resistor, lying, holes \(fmt(pitch)) mm apart"
  pads = pair(pitch, pad = 1.4mm)
  body = centered(6.2mm, 2.2mm)
  height = 2.6mm
  courtyardMargin = 0.1mm
  solids = shape3d
}

/// КД522Б: a glass diode (DO-35 class) lying between holes `pitch` apart, cathode at -X.
fn kd522(pitch: Length = 7.5mm) -> Footprint = Footprint {
  let shape3d = body.diode(pitch, "DO-35")
  name = "D_KD522_P\(fmt(pitch))mm"
  description = "КД522Б diode, glass, lying, holes \(fmt(pitch)) mm apart"
  pads = pair(pitch, pad = 1.3mm)
  body = centered(4.2mm, 1.9mm)
  height = 2.4mm
  courtyardMargin = 0.1mm
  solids = shape3d
}

/// КМ-5 / КМ-6: a ceramic capacitor standing on leads `pitch` apart, its flat body across Y.
fn km(
  pitch: Length = 5mm,
  width: Length = 6mm,
  color: String = "#b85c24",
  depth: Length = 2.6mm,
) -> Footprint = Footprint {
  let shape3d = [
    solid.box((width, depth, 5mm), at = (0mm, 0mm, 0.8mm), radius = 0.6mm, color = color),
  ]
  name = "C_KM_P\(fmt(pitch))mm_W\(fmt(width))mm"
  description = "КМ ceramic capacitor, standing, leads \(fmt(pitch)) mm apart"
  pads = pair(pitch, drill = 0.7mm, pad = 1.4mm)
  body = centered(width, depth)
  height = 5.8mm
  courtyardMargin = 0.1mm
  solids = shape3d
}

/// A capacitor under a chip between its rows (КМ-6, flat), across its diagonal.
fn kmUnder() -> Footprint = Footprint {
  let shape3d = [
    solid.box((4.5mm, 2.4mm, 0.5mm), at = (0mm, 0mm, 0.1mm), radius = 0.4mm, color = "#b85c24"),
  ]
  name = "C_KM6_Under_DIP"
  // Under the chip, between its rows: the chip's courtyard covers it.
  noCourtyard = true
  description = "КМ-6 capacitor flat under a DIP, leads 5 mm apart"
  pads = pair(5mm, drill = 0.6mm, pad = 1.2mm)
  body = centered(5mm, 2.4mm)
  height = 0.6mm
  solids = shape3d
}

/// К50-35 / К53: a radial electrolytic capacitor standing on leads `pitch` apart.
fn k50(
  diameter: Length,
  height: Length,
  pitch: Length,
  sleeve: String = "#2a4f8c",
) -> Footprint = Footprint {
  let shape3d = [
    solid.cylinder(diameter, height, at = (0mm, 0mm, 0.5mm), color = sleeve),
    solid.cylinder(
      clean(diameter * 0.86),
      0.05mm,
      at = (0mm, 0mm, clean(height + 0.5mm)),
      material = .metal,
    ),
  ]
  name = "CP_K50_D\(fmt(diameter))mm_H\(fmt(height))mm_P\(fmt(pitch))mm"
  description = "К50-35 electrolytic capacitor, \(fmt(diameter)) x \(fmt(height)) mm, leads \(fmt(pitch)) mm apart"
  pads = pair(pitch)
  body = centered(diameter, diameter)
  height = clean(height + 0.5mm)
  solids = shape3d
}

/// КТ-26: a small plastic transistor (TO-92 class), three leads in a row 2.5 mm apart.
fn kt26() -> Footprint = Footprint {
  let shape3d = [solid.cylinder(4.8mm, 4.6mm, at = (0mm, 0mm, 3mm), color = "#202022")]
  name = "KT-26"
  description = "КТ-26 transistor (КТ3102БМ), leads E B C 2.5 mm apart"
  pads = row(3, pitch = 2.5mm, drill = 0.7mm, pad = 1.4mm)
  body = centered(5mm, 4mm)
  height = 7.6mm
  solids = shape3d
}

