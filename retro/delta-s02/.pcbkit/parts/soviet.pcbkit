/// НР1-4-9: a resistor network, ten leads in a row 2.5 mm apart (pin 1 the common one).
fn hr1(count: Int = 10) -> Footprint = Footprint {
  let len = clean(count * 2.5mm)
  let shape3d = [
    solid.box((len, 2.6mm, 7mm), at = (0mm, 0mm, 0.5mm), radius = 0.3mm, color = "#3b2a22"),
  ]
  name = "R_Array_HR1-4-9_\(count)"
  description = "НР1-4-9 resistor network, \(count) leads 2.5 mm apart"
  pads = row(count)
  body = centered(len, 2.8mm)
  height = 7.5mm
  solids = shape3d
}

/// ДМ: a choke lying between holes `pitch` apart.
fn dm(pitch: Length = 12.5mm) -> Footprint = Footprint {
  let shape3d = body.axial(pitch, 9mm, 3.5mm, "#3e6b3a")
  name = "L_DM_P\(fmt(pitch))mm"
  description = "ДМ choke, lying, holes \(fmt(pitch)) mm apart"
  pads = pair(pitch)
  body = centered(9.4mm, 3.8mm)
  height = 4mm
  solids = shape3d
}

/// ОНП-СГ-83 / a keyboard's flat-cable socket: `count` contacts in a row 2.5 mm apart.
fn onp(count: Int = 12) -> Footprint = Footprint {
  let len = clean(count * 2.5mm + 3mm)
  let shape3d = [solid.box((len, 6mm, 8mm), radius = 0.4mm, color = "#e9e4d6")]
  name = "Socket_ONP-SG-83_1x\(count)"
  description = "ОНП-СГ-83 flat-cable socket, \(count) contacts 2.5 mm apart"
  pads = row(count)
  body = centered(len, 6mm)
  height = 8mm
  solids = shape3d
}

/// ОНЦ-ВГ: a DIN socket for the back panel, opening at +Y (the board's edge): its contacts on an
/// arc behind the opening, its two shield lugs at the sides.
fn onc(pins: Int = 5) -> Footprint = Footprint {
  let shape3d = [
    solid.box((17.5mm, 18mm, 13mm), color = "#141416"),
    solid.box((15mm, 0.6mm, 15mm), at = (0mm, 9mm, -1mm), radius = 7mm, material = .metal),
    solid.box((11mm, 0.7mm, 11mm), at = (0mm, 9.1mm, 1mm), radius = 5.5mm, color = "#0b0b0c"),
  ]
  let arc =
    if pins == 5 then [(-5mm, -2mm), (-3.5mm, -5.5mm), (0mm, -7mm), (3.5mm, -5.5mm), (5mm, -2mm)]
    else [
      (-5mm, -2mm),
      (-3.5mm, -5.5mm),
      (0mm, -7mm),
      (3.5mm, -5.5mm),
      (5mm, -2mm),
      (-2mm, -3mm),
      (2mm, -3mm),
    ]
  name = "DIN_ONC-VG_\(pins)"
  description = "ОНЦ-ВГ DIN socket, \(pins) contacts, right angle"
  // Its opening stands at the board's edge, through the back panel.
  overhang = true
  pads = concat(
    map(range(0, pins), k => thtPad("\(k + 1)", arc[k], 1mm, (1.8mm, 1.8mm), square = k == 0)),
    [
      thtPad("S1", (-7.5mm, 4mm), 1.5mm, (2.6mm, 2.6mm)),
      thtPad("S2", (7.5mm, 4mm), 1.5mm, (2.6mm, 2.6mm)),
    ],
  )
  body = centered(17.5mm, 18mm)
  height = 13mm
  solids = shape3d
}

/// The RF modulator's screen: a tinned can over its parts, soldered by four tabs.
fn modulatorCan(size: Tuple[Length, Length]) -> Footprint = Footprint {
  let shape3d = [solid.box((size[0], size[1], 14mm), radius = 0.8mm, material = .tin)]
  name = "Shield_Can_\(fmt(size[0]))x\(fmt(size[1]))mm"
  // Over the modulator's parts: they are under it.
  noCourtyard = true
  description = "Tinned screen over the RF modulator"
  pads = [
    thtPad("1", (clean(-size[0] / 2), 0mm), 1.2mm, (2mm, 2mm)),
    thtPad("2", (clean(size[0] / 2), 0mm), 1.2mm, (2mm, 2mm)),
    thtPad("3", (0mm, clean(-size[1] / 2)), 1.2mm, (2mm, 2mm)),
    thtPad("4", (0mm, clean(size[1] / 2)), 1.2mm, (2mm, 2mm)),
  ]
  body = centered(size[0], size[1])
  height = 14mm
  solids = shape3d
}

/// СНП59-64: the system connector, two rows of 32 contacts 2.5 mm apart, along Y.
fn snp59() -> Footprint = Footprint {
  let shape3d = [solid.box((7mm, 84mm, 10mm), radius = 0.5mm, color = "#6b5a3c")]
  name = "Connector_SNP59-64_2x32"
  description = "СНП59-64 system connector, 2 x 32 contacts 2.5 mm apart"
  pads = concat(
    map(range(0, 32), k => thtPad(
      "A\(k + 1)",
      (-1.25mm, clean((15.5 - k) * 2.5mm)),
      0.9mm,
      (1.6mm, 1.6mm),
      square = k == 0,
    )),
    map(
      range(0, 32),
      k => thtPad("B\(k + 1)", (1.25mm, clean((15.5 - k) * 2.5mm)), 0.9mm, (1.6mm, 1.6mm)),
    ),
  )
  body = centered(7mm, 84mm)
  height = 10mm
  solids = shape3d
}

// --- The Soviet passives as parts -------------------------------------------------------------

/// An МЛТ-0,125 resistor.
fn mltResistor(value: Resistance, pitch: Length = 10mm) -> Part = res(value) with {
  footprint = mlt(pitch)
}
/// A КМ ceramic capacitor standing.
fn kmCap(
  value: Capacitance,
  pitch: Length = 5mm,
  width: Length = 6mm,
  depth: Length = 2.6mm,
) -> Part = cap(value) with { footprint = km(pitch, width, depth = depth) }
/// A КМ-6 capacitor flat under a chip (decoupling across its supply pins).
fn underCap(value: Capacitance = 100nF) -> Part = cap(value) with { footprint = kmUnder() }
/// A К50-35 electrolytic capacitor.
fn k50Cap(value: Capacitance, diameter: Length, height: Length, pitch: Length) -> Part = cap(
  value,
) with { footprint = k50(diameter, height, pitch) }
/// A КД522Б diode (anode A, cathode K).
part KD522B = device(
  footprint = kd522(),
  kind = .diode,
  prefix = "VD",
  mpn = "КД522Б",
  pinout = { K = "1", A = "2" },
)
/// A КС119А stabistor (anode A, cathode K).
part KS119A = device(
  footprint = kd522(),
  kind = .diode,
  prefix = "VD",
  mpn = "КС119А",
  pinout = { K = "1", A = "2" },
)
/// КТ3102БМ: an NPN transistor (E, B, C in a row).
part KT3102BM = device(
  footprint = kt26(),
  kind = .transistor,
  prefix = "VT",
  mpn = "КТ3102БМ",
  pinout = { E = "1", B = "2", C = "3" },
)
/// КТ316БМ: an NPN UHF transistor (the modulator's oscillator).
part KT316BM = device(
  footprint = kt26(),
  kind = .transistor,
  prefix = "VT",
  mpn = "КТ316БМ",
  pinout = { E = "1", B = "2", C = "3" },
)
/// The 14 MHz crystal.
part Crystal14 = device(
  footprint = hc49(),
  value = 14MHz,
  kind = .crystal,
  prefix = "BQ",
  mpn = "РК169 14 МГц",
  pinout = { X1 = "1", X2 = "2" },
)
/// ЗП-3 piezo sounder.
part ZP3 = device(footprint = zp3(), prefix = "HA", mpn = "ЗП-3", pinout = { P1 = "1", P2 = "2" })
/// КМ1-1 reset button.
part CoaxOut = device(
