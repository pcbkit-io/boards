pcbkit 2

// The parts of the Delta-S02 (Элара, Чебоксары, 1993) as Elara built it: Soviet chips in their
// metric packages (2.5 mm pitch), each with its datasheet function, which is also what runs when
// the board runs (`simulation`); the passives in their Soviet bodies. Names as the parts list
// («Перечень элементов», Приложение 6) gives them.

/// КР1533ЛН1: six inverters (74ALS04).
part KR1533LN1 = device(
  footprint = dip(14, 7.5mm, pitch = 2.5mm),
  prefix = "DD",
  mpn = "КР1533ЛН1",
  pinout = {
    A1 = "1"
    Y1 = "2"
    A2 = "3"
    Y2 = "4"
    A3 = "5"
    Y3 = "6"
    GND = "7"
    Y4 = "8"
    A4 = "9"
    Y5 = "10"
    A5 = "11"
    Y6 = "12"
    A6 = "13"
    VCC = "14"
  },
) with { simulation = SimulationParameters { behavior = Behavior { model = "KR1533LN1" } } }

