pcbkit 2

// TPS54331D (Texas Instruments): Non-synchronous buck converter, 3.5-28 V in, 3 A, 570 kHz, 0.8 V
// reference, external catch diode
// Compiled from the part sheet `parts/TPS54331D.json` (`parts.create`); status: checked.
// Datasheet: https://www.ti.com/lit/ds/symlink/tps54331.pdf (SLVS839H, revised October 2023)
// Pins: TPS54331 datasheet SLVS839H, Table 5-1 (pin functions)
// Footprint: the standard package `SOIC-8 (D)`
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: Keep the loop VIN capacitors, PH, catch diode and GND short; VSENSE and COMP away from the
// PH node.
// Note: EN floats high (enabled); the R1/R2 divider sets the start voltage (about 6.5 V here).

/// TPS54331D — Non-synchronous buck converter, 3.5-28 V in, 3 A, 570 kHz, 0.8 V reference,
/// external catch diode
part TPS54331D: Part {
  footprint = soic(8)
  prefix = "U"
  mpn = "TPS54331D"
  manufacturer = "Texas Instruments"
  pinout = {
    BOOT = "1"
    VIN = "2"
    EN = "3"
    SS = "4"
    VSENSE = "5"
    COMP = "6"
    GND = "7"
    PH = "8"
  }
  pinTypes = {
    BOOT = .passive
    VIN = io.powerIn(min = 3.5V, max = 30V)
    EN = .passive
    SS = .passive
    VSENSE = .passive
    COMP = .passive
    GND = .ground
    PH = .powerOut
  }
  fields {
    Status = "checked"
    PinoutSource = "TPS54331 datasheet SLVS839H, Table 5-1 (pin functions)"
    Datasheet = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
  }
  simulation = SimulationParameters {
    parameters = [
      SimulationParameter {
        id = "thetaJa"
        quantity = .thetaJa
        typ = 116.3K/W
        conditions = "D SOIC-8 package; tabulated package thermal metric, not a guaranteed value for the application board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
          revision = "SLVS839H, revised October 2023"
          location = "p. 5, section 6.4, D / 8 pins column"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "thetaJcTop"
        quantity = .thetaJcTop
        typ = 53.7K/W
        conditions = "D SOIC-8 package; tabulated package thermal metric, not a guaranteed value for the application board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
          revision = "SLVS839H, revised October 2023"
          location = "p. 5, section 6.4, D / 8 pins column"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "thetaJb"
        quantity = .thetaJb
        typ = 57.1K/W
        conditions = "D SOIC-8 package; tabulated package thermal metric, not a guaranteed value for the application board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
          revision = "SLVS839H, revised October 2023"
          location = "p. 5, section 6.4, D / 8 pins column"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "psiJt"
        quantity = .psiJt
        typ = 12.9K/W
        conditions = "D SOIC-8 package; tabulated package thermal metric, not a guaranteed value for the application board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
          revision = "SLVS839H, revised October 2023"
          location = "p. 5, section 6.4, D / 8 pins column"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "psiJb"
        quantity = .psiJb
        typ = 56.5K/W
        conditions = "D SOIC-8 package; tabulated package thermal metric, not a guaranteed value for the application board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
          revision = "SLVS839H, revised October 2023"
          location = "p. 5, section 6.4, D / 8 pins column"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "tj-operating"
        quantity = .junctionOperatingTemperature
        min = -40degC
        max = 150degC
        conditions = "Recommended junction temperature range"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
          revision = "SLVS839H, revised October 2023"
          location = "p. 4, section 6.3, TJ"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "tj-absolute"
        quantity = .junctionAbsoluteTemperature
        min = -40degC
        max = 150degC
        conditions = "Absolute junction limits; these stress ratings do not establish normal operating conditions"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
          revision = "SLVS839H, revised October 2023"
          location = "p. 4, section 6.1, TJ"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "iq-nonswitching"
        quantity = .quiescentCurrent
        typ = 110uA
        max = 190uA
        conditions = "VIN pin; enabled, not switching, VSENSE=0.85 V; VIN=3.5 to 28 V, TJ=-40 to 150 degC"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
          revision = "SLVS839H, revised October 2023"
          location = "p. 5, section 6.5, operating non-switching supply current"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "ron-high-3v"
        quantity = .onResistance
        typ = 115mohm
        max = 200mohm
        conditions = "High-side MOSFET; BOOT-PH=3 V, VIN=3.5 V, TJ=-40 to 150 degC"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
          revision = "SLVS839H, revised October 2023"
          location = "p. 5, section 6.5, high-side MOSFET first row"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "ron-high-6v"
        quantity = .onResistance
        typ = 80mohm
        max = 150mohm
        conditions = "High-side MOSFET; BOOT-PH=6 V, VIN=12 V, TJ=-40 to 150 degC"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps54331.pdf"
          revision = "SLVS839H, revised October 2023"
          location = "p. 5, section 6.5, high-side MOSFET second row"
          confidence = .datasheet
        }
      },
    ]
  }
}

/// The support circuit of the TPS54331D as its datasheet shows it (p. 14, Figure 8-1 (7-28 V in,
/// 3.3 V / 3 A out)): every part next to the pin it serves. Add it next to the part: `U1 =
/// TPS54331D.TPS54331D { … }`, `U1Support = TPS54331D.Support(U1) {}`.
///
/// - The figure: 7-28 V in, 3.3 V / 3 A out. VOUT = 0.8 V x (1 + R5 / R6); R5 about 10 kohm.
///
/// - Compensation: R3 in series with C6 from COMP to ground, C7 from COMP to ground in parallel
/// (COMP_RC is the node between R3 and C6).
///
/// - The catch diode carries the inductor current while the switch is off: a 40 V 3 A Schottky for
/// inputs up to 28 V.
block Support {
  /// The TPS54331D this circuit serves (`TPS54331D.Support(U1)`).
  chip: Any
  /// The output rail (3.3 V with R5 = 10.2 kohm; VOUT = 0.8 V x (1 + R5 / R6)). (required)
  vout: Endpoint? = null

  net COMP_RC
  @severity(.warning)
  require vout != null
    "TPS54331D needs `vout` (The output rail (3.3 V with R5 = 10.2 kohm; VOUT = 0.8 V x (1 + R5 / R6)).): L1, C8, C9, R5 are left out until it is given, `TPS54331D.Support(U1, vout = …)`"
  /// 50V X5R/X7R
  C1 = cap(4.7uF, package = "1206", ratedVoltage = 50V) {
    place = [soft(near(chip.pin.VIN, max = 4mm), weight = 2)]
    a -- chip.pin.VIN
    b -- chip.pin.GND
  }
  /// 50V X5R/X7R
  C2 = cap(4.7uF, package = "1206", ratedVoltage = 50V) {
    place = [soft(near(chip.pin.VIN, max = 4mm), weight = 2)]
    a -- chip.pin.VIN
    b -- chip.pin.GND
  }
  /// 50V
  C3 = cap(10nF, package = "0402", ratedVoltage = 50V) {
    place = [soft(near(chip.pin.VIN, max = 2mm), weight = 2)]
    a -- chip.pin.VIN
    b -- chip.pin.GND
  }
  /// 1%, undervoltage lockout divider top
  R1 = res(332kohm, package = "0402", tolerance = 1%) {
    place = [soft(near(chip.pin.VIN, max = 5mm), weight = 1)]
    a -- chip.pin.VIN
    b -- chip.pin.EN
  }
  /// 1%, undervoltage lockout divider bottom
  R2 = res(68.1kohm, package = "0402", tolerance = 1%) {
    place = [soft(near(chip.pin.EN, max = 5mm), weight = 1)]
    a -- chip.pin.EN
    b -- chip.pin.GND
  }
  /// slow start, at most 27 nF
  C5 = cap(10nF, package = "0402") {
    place = [soft(near(chip.pin.SS, max = 2mm), weight = 2)]
    a -- chip.pin.SS
    b -- chip.pin.GND
  }
  /// 16V X7R
  C4 = cap(100nF, package = "0402", ratedVoltage = 16V, dielectric = .X7R) {
    place = [soft(near(chip.pin.BOOT, max = 2mm), weight = 2)]
    a -- chip.pin.BOOT
    b -- chip.pin.PH
  }
  /// Schottky 40 V 3 A, SMA
  D1 = diode(.schottky, package = "SMA", ratedVoltage = 40V, ratedCurrent = 3A) {
    place = [soft(near(chip.pin.PH, max = 5mm), weight = 1)]
    A -- chip.pin.GND
    K -- chip.pin.PH
  }
  /// saturation above 4 A
  L1 =
    if vout != null then inductor(6.8uH, package = "6", current = 4A) {
      place = [soft(near(chip.pin.PH, max = 5mm), weight = 1)]
      a -- chip.pin.PH
      b -- vout
    }
    else null
  /// 10V X5R
  C8 =
    if vout != null then cap(47uF, package = "1206", ratedVoltage = 10V, dielectric = .X5R) {
      place = [soft(near(chip, max = 8mm), weight = 1)]
      a -- vout
      b -- chip.pin.GND
    }
    else null
  /// 10V X5R
  C9 =
    if vout != null then cap(47uF, package = "1206", ratedVoltage = 10V, dielectric = .X5R) {
      place = [soft(near(chip, max = 8mm), weight = 1)]
      a -- vout
      b -- chip.pin.GND
    }
    else null
  /// 1% (3.3 V out)
  R5 =
    if vout != null then res(10.2kohm, package = "0402", tolerance = 1%) {
      place = [soft(near(chip.pin.VSENSE, max = 5mm), weight = 1)]
      a -- vout
      b -- chip.pin.VSENSE
    }
    else null
  /// 1%
  R6 = res(3.24kohm, package = "0402", tolerance = 1%) {
    place = [soft(near(chip.pin.VSENSE, max = 5mm), weight = 1)]
    a -- chip.pin.VSENSE
    b -- chip.pin.GND
  }
  R3 = res(29.4kohm, package = "0402") {
    place = [soft(near(chip.pin.COMP, max = 5mm), weight = 1)]
    a -- chip.pin.COMP
    b -- COMP_RC
  }
  C6 = cap(1nF, package = "0402") {
    place = [soft(near(chip, max = 8mm), weight = 1)]
    a -- COMP_RC
    b -- chip.pin.GND
  }
  C7 = cap(47pF, package = "0402") {
    place = [soft(near(chip.pin.COMP, max = 2mm), weight = 2)]
    a -- chip.pin.COMP
    b -- chip.pin.GND
  }
}
