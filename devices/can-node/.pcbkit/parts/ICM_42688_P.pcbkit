/// The support circuit of the ICM-42688-P as its datasheet shows it (Figure 5 application schematic
/// (I2C), Figure 6 (SPI), Table 10 bill of materials): every part next to the pin it serves. Add it
/// next to the part: `U1 = ICM_42688_P.Part { … }`, `U1Support = ICM_42688_P.Support(U1) {}`.
///
/// - I2C: AP_CS to VDDIO, AP_AD0 to GND (0x68) or VDDIO (0x69). SPI (up to 24 MHz): AP_CS, AP_SCLK,
/// AP_SDI, AP_SDO to the host.
///
/// - INT2/FSYNC to GND when unused; RESV pins 2, 3, 10, 11 open or GND, pin 7 to GND.
///
/// - Mount it near the board's centre of rotation, away from board flex and mounting holes; no vias
/// or traces under the package on the top layer.
block Support(
  /// The ICM-42688-P this circuit serves (`ICM_42688_P.Support(U1)`).
  chip: Any,
) {
  /// X7R, VDD bypass
  C1 = cap(100nF, package = "0402", dielectric = .X7R) {
    place = [soft(near(chip.pin.VDD, max = 2mm), weight = 2)]
    pins { a: chip.pin.VDD, b: chip.pin.GND }
  }
  /// X7R, VDD bypass
  C2 = cap(2.2uF, package = "0805", dielectric = .X7R) {
    place = [soft(near(chip.pin.VDD, max = 4mm), weight = 2)]
    pins { a: chip.pin.VDD, b: chip.pin.GND }
  }
  /// X7R, VDDIO bypass
  C3 = cap(10nF, package = "0402", dielectric = .X7R) {
    place = [soft(near(chip.pin.VDDIO, max = 2mm), weight = 2)]
    pins { a: chip.pin.VDDIO, b: chip.pin.GND }
  }
  /// I2C pull-up (once per bus)
  RP1 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.AP_SDA, max = 5mm), weight = 1)]
    pins { a: chip.pin.AP_SDA, b: chip.pin.VDDIO }
  }
  /// I2C pull-up (once per bus)
  RP2 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.AP_SCL, max = 5mm), weight = 1)]
    pins { a: chip.pin.AP_SCL, b: chip.pin.VDDIO }
  }
}
