      Pad { number = "3", at = (-1.1625mm, -0.25mm), shape = shape.rect(0.475mm, 0.25mm) },
      Pad { number = "4", at = (-1.1625mm, -0.75mm), shape = shape.rect(0.475mm, 0.25mm) },
      Pad { number = "5", at = (-0.5mm, -0.9125mm), shape = shape.rect(0.25mm, 0.475mm) },
      Pad { number = "6", at = (0mm, -0.9125mm), shape = shape.rect(0.25mm, 0.475mm) },
      Pad { number = "7", at = (0.5mm, -0.9125mm), shape = shape.rect(0.25mm, 0.475mm) },
      Pad { number = "8", at = (1.1625mm, -0.75mm), shape = shape.rect(0.475mm, 0.25mm) },
      Pad { number = "9", at = (1.1625mm, -0.25mm), shape = shape.rect(0.475mm, 0.25mm) },
      Pad { number = "10", at = (1.1625mm, 0.25mm), shape = shape.rect(0.475mm, 0.25mm) },
      Pad { number = "11", at = (1.1625mm, 0.75mm), shape = shape.rect(0.475mm, 0.25mm) },
      Pad { number = "12", at = (0.5mm, 0.9125mm), shape = shape.rect(0.25mm, 0.475mm) },
      Pad { number = "13", at = (0mm, 0.9125mm), shape = shape.rect(0.25mm, 0.475mm) },
      Pad { number = "14", at = (-0.5mm, 0.9125mm), shape = shape.rect(0.25mm, 0.475mm) },
    ]
    let b = centered(3mm, 2.5mm)
    name = "LGA-14_2.5x3.0x0.91mm_0.5mm_pitch"
    description = "LGA-14 2.5 x 3.0 x 0.91 mm, 0.5 mm pitch: the datasheet's land pattern"
    pads = ps
    body = b
    height = 0.97mm
    silk = silkOf(ps, b, 0.25mm)
    package = Package { family = .other, body = (3mm, 2.5mm), height = 0.97mm }
  },
  prefix = "U",
  mpn = "ICM-42688-P",
  manufacturer = "TDK InvenSense",
  pinout = {
