/// The support circuit of the STM32G431CBU6 as its datasheet shows it (the datasheet's power supply
/// scheme; AN5093 (reset and boot circuits)): every part next to the pin it serves. Add it next to
/// the part: `U1 = STM32G431CBU6.STM32G431CBU6 { … }`, `U1Support = STM32G431CBU6.Support(U1) {}`.
///
/// - No crystal: the HSI16 and HSI48 (USB, trimmed by the clock recovery system) need none; an HSE
/// crystal on PF0/PF1 is optional.
block Support {
  /// The STM32G431CBU6 this circuit serves (`STM32G431CBU6.Support(U1)`).
  chip: Any
  /// VBAT joined to VDD (no backup battery; else 100 nF at VBAT).
  noBattery: Bool = true

  /// one per VDD pin
  C_VDD_23 = cap(100nF, package = "0402") {
    place = [soft(near(chip["23"], max = 2mm), weight = 2)]
    a -- chip["23"]
    b -- chip.pin.VSS
  }
  /// one per VDD pin
  C_VDD_35 = cap(100nF, package = "0402") {
    place = [soft(near(chip["35"], max = 2mm), weight = 2)]
    a -- chip["35"]
    b -- chip.pin.VSS
  }
  /// one per VDD pin
  C_VDD_48 = cap(100nF, package = "0402") {
    place = [soft(near(chip["48"], max = 2mm), weight = 2)]
    a -- chip["48"]
    b -- chip.pin.VSS
  }
  C_BULK = cap(4.7uF, package = "0805") {
    place = [soft(near(chip.pin.VDD, max = 4mm), weight = 2)]
    a -- chip.pin.VDD
    b -- chip.pin.VSS
  }
  C_VBAT =
    if not noBattery then cap(100nF, package = "0402") {
      place = [soft(near(chip.pin.VBAT, max = 2mm), weight = 2)]
      a -- chip.pin.VBAT
      b -- chip.pin.VSS
    }
    else null
  chip.pin.VBAT -- (if noBattery then chip.pin.VDD else chip.pin.VBAT)
  C_VDDA1 = cap(10nF, package = "0402") {
    place = [soft(near(chip.pin.VDDA, max = 2mm), weight = 2)]
    a -- chip.pin.VDDA
    b -- chip.pin.VSS
  }
  C_VDDA2 = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.VDDA, max = 2mm), weight = 2)]
    a -- chip.pin.VDDA
    b -- chip.pin.VSS
  }
  C_VREF1 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VREFP, max = 2mm), weight = 2)]
    a -- chip.pin.VREFP
    b -- chip.pin.VSS
  }
  C_VREF2 = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.VREFP, max = 2mm), weight = 2)]
    a -- chip.pin.VREFP
    b -- chip.pin.VSS
  }
  C_NRST = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.PG10, max = 2mm), weight = 2)]
    a -- chip.pin.PG10
    b -- chip.pin.VSS
  }
  /// boots from flash
  R_BOOT0 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.PB8, max = 5mm), weight = 1)]
    a -- chip.pin.PB8
    b -- chip.pin.VSS
  }
}
