#!/bin/sh
# pcbkit: a design that does not pass `pcbkit check` cannot be committed.
# Note: checks the working tree, so stage everything you want checked.
out=$(pcbkit check 2>&1)
status=$?
if [ $status -ne 0 ]; then
  echo "$out" >&2
  echo "pcbkit: commit refused, fix the errors above (or route) and try again" >&2
  exit 1
fi
