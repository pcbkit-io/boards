pcbkit 1

// A 24 V AC wall thermostat for a furnace and an air conditioner (the US four-wire hookup: R, C, W,
// Y, G). An ESP32-WROOM-32E reads the room from an SHT40 every two seconds and closes W (heat) or
// Y (cool) and G (the fan) through three relays; a 0.96" OLED shows the temperature, the set point
// and the mode; three buttons set them. The furnace's transformer powers it from R and C: a bridge,
// an 80 V synchronous buck (the standard Buck block: TI's LMR38020) to 5 V for the relays, an
// AMS1117 to 3.3 V for the rest. Firmware on ESP-IDF's
// register headers, flashed through the programming header with a USB-serial adapter.

use "parts/ESP32_WROOM_32E.pcbkit" as ESP32_WROOM_32E
use "parts/SHT40_AD1B.pcbkit" as SHT40_AD1B
use "parts/SSD1306_OLED_I2C.pcbkit" as SSD1306_OLED_I2C
use "parts/SRD_05VDC_SL_C.pcbkit" as SRD_05VDC_SL_C
use "parts/ULN2003AD.pcbkit" as ULN2003AD
use "parts/AMS1117_3_3.pcbkit" as AMS1117_3_3

net R, C, W, Y, G
net VDC { voltage = 34V; current = 150mA }
net V5 { voltage = 5V; current = 300mA }
net V3 { voltage = 3.3V; current = 350mA }
net GND { voltage = 0V }
net SDA, SCL, UP, DOWN, MODE, HEAT, COOL, FAN, KW, KY, KG, TX, RX, EN, BOOT

board = Board {
  name = "thermostat"
  description = "ESP32-WROOM-32E · SHT40 · 0.96\" OLED · 3 relays (W, Y, G) · 24 V AC"
  outline = auto()
}
laboratory = Laboratory { world = "sim/house.js" }

// ---- 24 V AC in, to 5 V and 3.3 V --------------------------------------------------------------
// The furnace's wires on two terminal blocks at the left edge (Phoenix MKDS 1,5, 5.08 mm): R
// (24 V AC) and C (its common), then the calls W, Y, G that the relays connect to R.
J1 = device(terminalBlock(2, pitch = 5.08mm), pinout = { "1": "1", "2": "2" }, prefix = "J", mpn = "1715721") {
  place = [edge(.left)]
  pins { "1": R, "2": C }
}
J3 = device(terminalBlock(3, pitch = 5.08mm), pinout = { "1": "1", "2": "2", "3": "3" }, prefix = "J", mpn = "1715734") {
  place = [edge(.left), soft(near(J1, max = 4mm))]
  pins { "1": W, "2": Y, "3": G }
}
// A full-wave bridge (24 V AC is about 34 V at its peaks, up to 40 V on a high line).
D1 = diode(kind = .rectifier, package = "SMA", ratedVoltage = 1000V, ratedCurrent = 1A) { place = [soft(near(J1, max = 12mm))]; pins { A: R, K: VDC } }
D2 = diode(kind = .rectifier, package = "SMA", ratedVoltage = 1000V, ratedCurrent = 1A) { place = [soft(near(J1, max = 12mm))]; pins { A: C, K: VDC } }
D3 = diode(kind = .rectifier, package = "SMA", ratedVoltage = 1000V, ratedCurrent = 1A) { place = [soft(near(J1, max = 12mm))]; pins { A: GND, K: R } }
D4 = diode(kind = .rectifier, package = "SMA", ratedVoltage = 1000V, ratedCurrent = 1A) { place = [soft(near(J1, max = 12mm))]; pins { A: GND, K: C } }
// The line's spikes: a 36 V TVS (SMBJ36A) clamps them near 58 V, under the buck's 80 V (an
// LM2596's 45 V would not take that).
buck = Buck(vin = VDC, vout = V5, gnd = GND) {}
D5 = diode(kind = .tvs, package = "SMB", voltage = 36V) { place = [soft(near(buck.U, max = 10mm))]; pins { A: GND, K: VDC } }
U4 = AMS1117_3_3.Part { pins { VIN: V5, VOUT: V3, GND: GND } }
U4Support = AMS1117_3_3.Support(U4) {}

// ---- processor -----------------------------------------------------------------------------------
U1 = ESP32_WROOM_32E.Part with {
  simulation = ESP32_WROOM_32E.Part.simulation with { behavior = ESP32_WROOM_32E.Part.simulation.behavior with { firmware = "firmware" } }
} {
  place = [edge(.top, overhang = 6mm)]
  pins {
    P3V3: V3, GND: GND, EN: EN, IO0: BOOT, TXD0: TX, RXD0: RX,
    IO21: SDA, IO22: SCL, IO32: UP, IO33: DOWN, IO25: MODE, IO26: HEAT, IO27: COOL, IO14: FAN,
  }
}
U1Support = ESP32_WROOM_32E.Support(U1) {}
// Programming and console: a 3.3 V USB-serial adapter (115200 baud). Hold BOOT, press RESET, flash.
J2 = header(5) { pins { "1": GND, "2": TX, "3": RX, "4": EN, "5": BOOT } }

// ---- the room, the screen, the buttons ------------------------------------------------------------
// The SHT40 at the bottom edge, away from the regulators' heat, at 0x44 with the bus's pull-ups.
U2 = SHT40_AD1B.Part { place = [edge(.bottom)]; pins { SDA: SDA, SCL: SCL, VDD: V3, VSS: GND } }
U2Support = SHT40_AD1B.Support(U2) {}
// The 0.96" OLED module (0x3C) on its 4-pin socket.
DS1 = SSD1306_OLED_I2C.Part { pins { GND: GND, VCC: V3, SCL: SCL, SDA: SDA } }
SW1 = button("6x6", key = "ArrowUp") { place = [edge(.right), soft(near(DS1, max = 25mm))]; pins { a: UP, b: GND } }
SW2 = button("6x6", key = "ArrowDown") { place = [edge(.right), soft(near(DS1, max = 25mm))]; pins { a: DOWN, b: GND } }
SW3 = button("6x6", key = "KeyM") { place = [edge(.right), soft(near(DS1, max = 25mm))]; pins { a: MODE, b: GND } }

// ---- the calls: three relays switching R to W, Y and G -------------------------------------------
// In the laboratory the house reads the calls at the driver's inputs (sim/house.js).
U5 = physicalLines(ULN2003AD.Part, { input: ["1"], input2: ["2"], input3: ["3"] }) {
  pins { IN1: HEAT, IN2: COOL, IN3: FAN, IN4: GND, IN5: GND, IN6: GND, IN7: GND, OUT1: KW, OUT2: KY, OUT3: KG, OUT4: .nc, OUT5: .nc, OUT6: .nc, OUT7: .nc, GND: GND, COM: V5 }
}
C2 = cap(100nF, package = "0402") { place = [soft(near(U5, max = 4mm))]; pins { a: V5, b: GND } }
K1 = SRD_05VDC_SL_C.Part { pins { COIL1: V5, COIL2: KW, COM: R, NO: W, NCLOSED: .nc } }
K2 = SRD_05VDC_SL_C.Part { pins { COIL1: V5, COIL2: KY, COM: R, NO: Y, NCLOSED: .nc } }
K3 = SRD_05VDC_SL_C.Part { pins { COIL1: V5, COIL2: KG, COM: R, NO: G, NCLOSED: .nc } }

holes = MountingHoles(corners = [.bottomLeft, .bottomRight, .topLeft, .topRight]) {}
gndPour = pour(net = GND, layers = [Cu.bottom]) {}

override C2.orderCode = "C1525"
override U1Support.C2.orderCode = "C1525"
override U2Support.C1.orderCode = "C1525"
override U4Support.CIN.orderCode = "C15850"
override U4Support.COUT.orderCode = "C12891"
override U1Support.C1.orderCode = "C12891"
override U1Support.C3.orderCode = "C52923"
override D1.orderCode = "C81191"
override D2.orderCode = "C81191"
override D3.orderCode = "C81191"
override D4.orderCode = "C81191"
override D5.orderCode = "C114001"
override DS1.orderCode = "C2718488"
override J1.orderCode = "C5183929"
override J2.orderCode = "C492404"
override J3.orderCode = "C480520"
override K1.orderCode = "C35449"
override K2.orderCode = "C35449"
override K3.orderCode = "C35449"
override U1Support.R1.orderCode = "C25744"
override U1Support.R2.orderCode = "C25744"
override U2Support.RP1.orderCode = "C25744"
override U2Support.RP2.orderCode = "C25744"
override SW1.orderCode = "C221880"
override SW2.orderCode = "C221880"
override SW3.orderCode = "C221880"
override U1Support.SW1.orderCode = "C221880"
override U1Support.SW2.orderCode = "C221880"
override U1.orderCode = "C701341"
override U2.orderCode = "C2848306"
override U4.orderCode = "C6186"
override U5.orderCode = "C7512"
override U1Support.C2.place = [near(U1.pin.P3V3, max = 2mm)]
override U4Support.CIN.place = [near(U4.pin.VIN, max = 2.5mm)]
override U2Support.C1.place = [near(U2.pin.VDD, max = 2mm)]
