/// The support circuit of the ESP32-WROOM-32E-N4 as its datasheet shows it (9 peripheral schematics
/// (figure 9, p. 39); 4 boot configurations (table 4)): every part next to the pin it serves. Add
/// it next to the part: `U1 = ESP32_WROOM_32E.Part { … }`, `U1Support =
/// ESP32_WROOM_32E.Support(U1) {}`.
///
/// - EN: 10 kohm to 3V3 and 1 uF to GND so the supply settles before the chip starts; a reset
/// button to GND.
///
/// - Firmware download over UART0 (TXD0, RXD0) from a USB-serial bridge; auto-reset: the bridge's
/// DTR and RTS drive EN and IO0 through two transistors (the DevKitC circuit).
///
/// - Keep IO12 low at power-up; JTAG: IO14 TMS, IO12 TDI, IO13 TCK, IO15 TDO.
block Support {
  /// The ESP32-WROOM-32E-N4 this circuit serves (`ESP32_WROOM_32E.Support(U1)`).
  chip: Any
  /// The RESET button.
  resetButton: Bool = true
  /// The BOOT button.
  bootButton: Bool = true

  C1 = cap(22uF, package = "1206") {
    place = [soft(near(chip.pin.P3V3, max = 4mm), weight = 2)]
    a -- chip.pin.P3V3
    b -- chip.pin.GND
  }
  C2 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.P3V3, max = 2mm), weight = 2)]
    a -- chip.pin.P3V3
    b -- chip.pin.GND
  }
  /// EN RC delay
  R1 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.EN, max = 5mm), weight = 1)]
    a -- chip.pin.EN
    b -- chip.pin.P3V3
  }
  /// EN RC delay
  C3 = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.EN, max = 2mm), weight = 2)]
    a -- chip.pin.EN
    b -- chip.pin.GND
  }
  SW1 = if resetButton then button("6x6") { a -- chip.pin.EN, b -- chip.pin.GND } else null
  SW2 = if bootButton then button("6x6") { a -- chip.pin.IO0, b -- chip.pin.GND } else null
  /// only with PSRAM variants (IO16 pull-up)
  R2 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.IO16, max = 5mm), weight = 1)]
    a -- chip.pin.IO16
    b -- chip.pin.P3V3
  }
}
