pcbkit 1

// LM2596S-ADJ/NOPB (Texas Instruments): Non-synchronous buck regulator, 4.5-40 V in, 3 A, 150 kHz,
// adjustable from 1.23 V, external catch diode (TO-263-5)
// Compiled from the part sheet `parts/LM2596S_ADJ.json` (`parts.create`); status: checked.
// Datasheet: https://www.ti.com/lit/ds/symlink/lm2596.pdf (SNVS124G, revised March 2023)
// Pins: LM2596 datasheet SNVS124G, Figure 6-2 (5-pin TO-263 KTT, top view: metal tab GND) and
// Table 6-1 (pin functions)
// Footprint: the standard package `TO-263-5 (KTT)`
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: Solder the tab to a large ground copper area: it is the heat path (the datasheet's thermal
// figures assume 0.5 to 3 in² of copper).
// Note: Keep the loop CIN, VIN, OUTPUT, D1 and GND short and wide; route FEEDBACK away from the
// inductor and the OUTPUT node, taking it from the output capacitor.
// Note: Land pattern: the datasheet's recommendation (pads 2.16 x 1.07 mm at 1.7 mm pitch, tab pad
// 6.99 mm long, 10.8 mm wide at its outer end and 8.33 mm next to the leads, 14.17 mm overall);
// the 14.17 mm pattern centred on the 14.35 mm package length (0.09 mm short of the lead tips and
// of the tab end), rotated so pin 1 is top left.

/// LM2596S-ADJ/NOPB — Non-synchronous buck regulator, 4.5-40 V in, 3 A, 150 kHz, adjustable from
/// 1.23 V, external catch diode (TO-263-5)
part Part = device(
  footprint = dpak("TO-263-5"),
  prefix = "U",
  mpn = "LM2596S-ADJ/NOPB",
  manufacturer = "Texas Instruments",
  pinout = { VIN: "1", OUTPUT: "2", GND: ["3", "6"], FEEDBACK: "4", nON_OFF: "5" },
  pinTypes = {
    VIN: io.powerIn(min = 4.5V, max = 45V),
    OUTPUT: .powerOut,
    GND: .ground,
    FEEDBACK: .passive,
    nON_OFF: io.input(max = 25V),
  },
) with {
  fields {
    Status: "checked",
    PinoutSource: "LM2596 datasheet SNVS124G, Figure 6-2 (5-pin TO-263 KTT, top view: metal tab GND) and Table 6-1 (pin functions)",
    Datasheet: "https://www.ti.com/lit/ds/symlink/lm2596.pdf",
  }
  simulation = SimulationParameters {
    parameters = [
      SimulationParameter {
        id = "thetaJa-0p5in2"
        quantity = .thetaJa
        typ = 50K/W
        conditions = "KTW TO-263 package; tab soldered to single-sided PCB with 0.5 square inch of 1 oz copper"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/lm2596.pdf"
          revision = "SNVS124G, revised March 2023"
          location = "pp. 5-6, section 7.4, KTW column, footnote 5"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "thetaJa-2p5in2"
        quantity = .thetaJa
        typ = 30K/W
        conditions = "KTW TO-263 package; tab soldered to single-sided PCB with 2.5 square inches of 1 oz copper"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/lm2596.pdf"
          revision = "SNVS124G, revised March 2023"
          location = "pp. 5-6, section 7.4, KTW column, footnote 6"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "thetaJa-double-sided"
        quantity = .thetaJa
        typ = 20K/W
        conditions = "KTW TO-263 package; tab soldered to double-sided PCB with 3 square inches of 1 oz copper on the device side and approximately 16 square inches of copper on the opposite side"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/lm2596.pdf"
          revision = "SNVS124G, revised March 2023"
          location = "pp. 5-6, section 7.4, KTW column, footnote 7"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "thetaJcTop"
        quantity = .thetaJcTop
        typ = 2K/W
        conditions = "KTW TO-263 package; manufacturer labels this metric junction-to-case top; it is not a junction-to-board value"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/lm2596.pdf"
          revision = "SNVS124G, revised March 2023"
          location = "p. 5, section 7.4, RthetaJC(top), KTW column"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "tj-operating"
        quantity = .junctionOperatingTemperature
        min = -40degC
        max = 125degC
        conditions = "Junction range of the adjustable-version electrical specifications; operating range also listed in section 7.3"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/lm2596.pdf"
          revision = "SNVS124G, revised March 2023"
          location = "pp. 5-7, sections 7.3, 7.8 and 7.9, TJ conditions"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "tj-absolute"
        quantity = .junctionAbsoluteTemperature
        max = 150degC
        conditions = "Absolute maximum junction temperature; storage temperature lower bound is not a junction rating"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/lm2596.pdf"
          revision = "SNVS124G, revised March 2023"
          location = "p. 5, section 7.1, maximum junction temperature"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "iq-switch-off"
        quantity = .quiescentCurrent
        typ = 5mA
        max = 10mA
        conditions = "Adjustable version; VIN=12 V, TJ=25 degC; feedback disconnected from output and held at 12 V to force the output transistor off"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/lm2596.pdf"
          revision = "SNVS124G, revised March 2023"
          location = "p. 7, section 7.9, IQ and footnote 6"
          confidence = .datasheet
        }
      },
    ]
  }
}

/// The support circuit of the LM2596S-ADJ/NOPB as its datasheet shows it (p. 27, Figure 9-13 and
/// Section 9.2.2): every part next to the pin it serves. Add it next to the part: `U1 =
/// LM2596S_ADJ.Part { … }`, `U1Support = LM2596S_ADJ.Support(U1) {}`.
///
/// - VOUT = 1.23 V x (1 + R2 / R1), R1 from 240 ohm to 1.5 kohm; R2 = 3.09 kohm for 5 V, 1.68 kohm
/// for 3.3 V, 8.66 kohm for 12 V.
///
/// - The datasheet's adjustable example (Figure 9-13): CIN 470 uF 50 V, COUT 220 uF 35 V, D1 5 A 40
/// V Schottky, L1 68 uH for 20 V out from 28 V.
///
/// - ON/OFF to GND (or open) when the shutdown is not used; the diode's anode on GND, cathode on
/// OUTPUT.
block Support(
  /// The LM2596S-ADJ/NOPB this circuit serves (`LM2596S_ADJ.Support(U1)`).
  chip: Any,
  /// The output rail (5 V with R2 = 3.09 kohm; VOUT = 1.23 V x (1 + R2 / R1)). (required)
  vout: Endpoint? = null,
  /// ON/OFF to GND (`false`: drive the shutdown).
  alwaysOn: Bool = true,
) {
  warn(
    vout != null,
    "LM2596S_ADJ needs `vout` (The output rail (5 V with R2 = 3.09 kohm; VOUT = 1.23 V x (1 + R2 / R1)).): L1, COUT, R2 are left out until it is given, `LM2596S_ADJ.Support(U1, vout = …)`",
  )
  /// 50V aluminium electrolytic, ripple current at least half the load current (470 uF in the
  /// datasheet's example; 330 uF is the largest 50 V can in 10 x 10 mm)
  CIN = cap(330uF, package = "D10xL10", ratedVoltage = 50V) {
    place = [soft(near(chip.pin.VIN, max = 4mm), weight = 2)]
    pins { a: chip.pin.VIN, b: chip.pin.GND }
  }
  /// Schottky 40 V 5 A
  D1 = diode(.schottky, package = "SMC", ratedVoltage = 40V, ratedCurrent = 5A) {
    place = [soft(near(chip.pin.OUTPUT, max = 5mm), weight = 1)]
    pins { A: chip.pin.GND, K: chip.pin.OUTPUT }
  }
  /// 3 A or more saturation (5 V out): a 12 x 12 mm shielded power inductor
  L1 =
    if vout != null then inductor(33uH, package = "12", current = 3A) {
      place = [soft(near(chip.pin.OUTPUT, max = 5mm), weight = 1)]
      pins { a: chip.pin.OUTPUT, b: vout }
    }
    else null
  /// 35V aluminium electrolytic, low ESR
  COUT =
    if vout != null then cap(220uF, package = "D8xL10", ratedVoltage = 35V) {
      place = [soft(near(chip, max = 8mm), weight = 1)]
      pins { a: vout, b: chip.pin.GND }
    }
    else null
  /// 1% (5 V out)
  R2 =
    if vout != null then res(3.09kohm, package = "0402", tolerance = 1pct) {
      place = [soft(near(chip.pin.FEEDBACK, max = 5mm), weight = 1)]
      pins { a: vout, b: chip.pin.FEEDBACK }
    }
    else null
  /// 1%
  R1 = res(1kohm, package = "0402", tolerance = 1pct) {
    place = [soft(near(chip.pin.FEEDBACK, max = 5mm), weight = 1)]
    pins { a: chip.pin.FEEDBACK, b: chip.pin.GND }
  }
  connect(chip.pin.nON_OFF, if alwaysOn then chip.pin.GND else chip.pin.nON_OFF)
}
