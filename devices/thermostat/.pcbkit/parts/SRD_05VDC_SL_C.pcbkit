pcbkit 2

// SRD-05VDC-SL-C (Ningbo Songle Relay): Songle SRD-05VDC-SL-C power relay, 5 V coil (70 Ω, 71
// mA), one change-over contact (COM, NO and NC, named NCLOSED) up to 10 A 250 VAC, through hole,
// 19.2 x 15.6 mm
// Compiled from the part sheet `parts/SRD_05VDC_SL_C.json` (`parts.create`); status: checked.
// Datasheet: https://datasheet.lcsc.com/datasheet/pdf/9ddfe54b7529126320ff1ddcabf6bab7.pdf (Songle
// SRD series datasheet: coil table, outline and PCB layout (bottom view), C type)
// Pins: Songle SRD series datasheet: C-type PCB layout (bottom view, mirrored here for the top
// view), outline dimensions, coil table (5 V, 71.4 mA, 70 Ω, pick-up 75 % max, drop-out 10 % min)
// Footprint: as given
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: The coil draws 71 mA at 5 V: drive it with a transistor or MOSFET (e.g. `mosfet(.n)` from
// the coil's low side to GND, the gate from a GPIO through 100 Ω with 10 kΩ to GND), never from
// a GPIO directly, and put a flyback diode (`diode(kind = .rectifier)`, 1N4148 or 1N4007) across
// the coil, cathode to 5 V.
// Note: Mains on COM/NO/NC: keep at least 6 mm of board (or a slot) between the contacts' copper
// and low-voltage copper, use wide tracks for the load current, and never route mains under the
// coil side.
// Note: Contacts 7, 10 or 15 A by version (the case print says which). The normally closed contact
// is named NCLOSED (NC means no-connect to PCBKit).

/// SRD-05VDC-SL-C — Songle SRD-05VDC-SL-C power relay, 5 V coil (70 Ω, 71 mA), one change-over
/// contact (COM, NO and NC, named NCLOSED) up to 10 A 250 VAC, through hole, 19.2 x 15.6 mm
part Part = device(
  footprint = Footprint {
    let ps = [
      thtPad("1", (0mm, 0mm), 1.3mm, (2.6mm, 2.6mm), square = true),
      thtPad("2", (2mm, 6mm), 1.3mm, (2.6mm, 2.6mm)),
      thtPad("3", (14.2mm, 6mm), 1.3mm, (2.6mm, 2.6mm)),
      thtPad("4", (14.2mm, -6mm), 1.3mm, (2.6mm, 2.6mm)),
      thtPad("5", (2mm, -6mm), 1.3mm, (2.6mm, 2.6mm)),
    ]
    let b = box((-1.6mm, -7.8mm), (17.6mm, 7.8mm))
    name = "Relay_SPDT_Songle_SRD_Form_C"
    description = "Songle SRD relay, form C, top view: 1 COM, 2 and 5 the coil, 3 NC (normally closed), 4 NO; 1.3 mm holes (Songle's PCB layout, mirrored from its bottom view)"
    tags = ["relay", "SPDT", "THT"]
    pads = ps
    body = b
    height = 15.8mm
    silk = silkOf(ps, b, 0.25mm)
    package = Package { family = .other, body = (19.2mm, 15.6mm), height = 15.8mm }
    solids = [
      solid.box(
        (19.2mm, 15.6mm, 15.5mm),
        at = (8mm, 0mm, 0.3mm),
        radius = 0.4mm,
        color = "#1f5fbf",
      ),
    ]
  },
  prefix = "K",
  mpn = "SRD-05VDC-SL-C",
  manufacturer = "Ningbo Songle Relay",
  orderCode = "C35449",
  pinout = { COM = "1", COIL1 = "2", NCLOSED = "3", NO = "4", COIL2 = "5" },
  pinTypes = {
    COM = .passive
    COIL1 = .passive
    NCLOSED = .passive
    NO = .passive
    COIL2 = .passive
  },
) with {
  fields {
    Status = "checked"
    PinoutSource = "Songle SRD series datasheet: C-type PCB layout (bottom view, mirrored here for the top view), outline dimensions, coil table (5 V, 71.4 mA, 70 Ω, pick-up 75 % max, drop-out 10 % min)"
    Datasheet = "https://datasheet.lcsc.com/datasheet/pdf/9ddfe54b7529126320ff1ddcabf6bab7.pdf"
  }
  simulation = SimulationParameters {
    parameters = [
      SimulationParameter {
        id = "coil-current-5v"
        quantity = .supplyCurrent
        typ = 71.4mA
        conditions = "Coil at nominal 5 VDC, 20 degC, 0.36 W coil (L version) 71.4 mA; the 0.45 W (D version) coil draws 89.3 mA; coil resistance +/-10%"
        source = SimulationEvidence {
          url = "https://datasheet.lcsc.com/datasheet/pdf/9ddfe54b7529126320ff1ddcabf6bab7.pdf"
          revision = "Songle SRD series datasheet (coil specification table)"
          location = "p. 1, coil specification table (0.36 W, L version), 05 VDC row"
          confidence = .datasheet
        }
      },
    ]
  }
}
