(version 1)
(rule "J1: pads by its own holes"
	(constraint hole_clearance (min 0mm))
	(condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')"))
(rule "J2: pads by its own holes"
	(constraint hole_clearance (min 0mm))
	(condition "A.memberOfFootprint('J2') && B.memberOfFootprint('J2')"))
(rule "J7: pads by its own holes"
	(constraint hole_clearance (min 0mm))
	(condition "A.memberOfFootprint('J7') && B.memberOfFootprint('J7')"))
