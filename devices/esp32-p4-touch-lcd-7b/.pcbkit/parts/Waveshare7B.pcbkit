pcbkit 1

// The chips of Waveshare's ESP32-P4-WIFI6-Touch-LCD-7B that PCBKit's registry does not have yet,
// each with the pin numbers Waveshare's schematic gives it (its board is built with them) and the
// standard package its maker draws.
// This file may be used, changed and shared without conditions, with the board or alone.

/// CH343P (WCH): USB to UART bridge, full-speed USB, 6 Mbaud, VIO 1.8 to 5 V, TQFN-16 3 x 3 mm
/// (the exposed pad is ground); its modem inputs are pulled up inside.
part CH343P = device(
  footprint = qfn(16, size = (3mm, 3mm), ep = (1.7mm, 1.7mm)),
  prefix = "U",
  mpn = "CH343P",
  manufacturer = "WCH",
  orderCode = "C2846043",
  pinout = {
    VIO: "1",
    GND: ["2", "17"],
    VDD5: "3",
    TXD: "4",
    RXD: "5",
    V3: "6",
    "UD+": "7",
    "UD-": "8",
    VBUS: "9",
    "ACT#": "10",
    "DCD#": "11",
    "DTR#": "12",
    "RTS#": "13",
    "DSR#": "14",
    "CTS#": "15",
    "RI#": "16",
  },
  pinTypes = {
    VIO: .powerIn,
    GND: .ground,
    VDD5: .powerIn,
    TXD: .output,
    RXD: .input,
    V3: .passive,
    "UD+": .bidirectional,
    "UD-": .bidirectional,
    VBUS: .input,
    "ACT#": .output,
    "DCD#": .passive,
    "DTR#": .output,
    "RTS#": .output,
    "DSR#": .passive,
    "CTS#": .passive,
    "RI#": .passive,
  },
)

