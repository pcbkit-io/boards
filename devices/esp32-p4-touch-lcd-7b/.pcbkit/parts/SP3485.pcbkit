pcbkit 2

// SP3485EN-L/TR (MaxLinear (Exar, Sipex)): RS-485/RS-422 transceiver, half duplex, 3.3 V supply,
// 10 Mbps, 32 unit loads, 5 V tolerant logic (SOIC-8, 75176 pinout): the common 3.3 V RS485 module
// chip
// Compiled from the part sheet `parts/SP3485.json` (`parts.create`); status: checked.
// Datasheet: https://www.maxlinear.com/ds/sp3485.pdf (Exar SP3485 datasheet rev. 1.0.0 (06/19/12))
// Pins: Exar SP3485 datasheet (rev. 1.0.0, 06/19/12): pin function, absolute maximum ratings,
// electrical characteristics (VCC = 3.3 V ± 5 %), ordering information (8-pin NSOIC); read from
// the copy the distributor hosts (https://www.lcsc.com/datasheet/C8963.pdf)
// Footprint: the standard package `SOIC-8`
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: Same pins as the MAX3485 and the 5 V MAX485 (75176 pinout).
// Note: The logic inputs take 5 V, so a 5 V MCU may drive it; RO swings to 3.3 V.
// Note: Bias resistors (e.g. 680 ohm A to VCC and B to GND at one node) keep an idle terminated
// bus defined; a TVS at the connector for long buses.

/// SP3485EN-L/TR — RS-485/RS-422 transceiver, half duplex, 3.3 V supply, 10 Mbps, 32 unit loads,
/// 5 V tolerant logic (SOIC-8, 75176 pinout): the common 3.3 V RS485 module chip
part SP3485: Part {
  footprint = soic(8)
  prefix = "U"
  mpn = "SP3485EN-L/TR"
  manufacturer = "MaxLinear (Exar, Sipex)"
  pinout = { RO = "1", RE = "2", DE = "3", DI = "4", GND = "5", A = "6", B = "7", VCC = "8" }
  pinTypes = {
    RO = .output
    RE = io.input(max = 6V)
    DE = io.input(max = 6V)
    DI = io.input(max = 6V)
    GND = .ground
    A = io.bidirectional(max = 15V)
    B = io.bidirectional(max = 15V)
    VCC = io.powerIn(min = 3.135V, max = 6V)
  }
  fields {
    Status = "checked"
    PinoutSource = "Exar SP3485 datasheet (rev. 1.0.0, 06/19/12): pin function, absolute maximum ratings, electrical characteristics (VCC = 3.3 V ± 5 %), ordering information (8-pin NSOIC); read from the copy the distributor hosts (https://www.lcsc.com/datasheet/C8963.pdf)"
    Datasheet = "https://www.maxlinear.com/ds/sp3485.pdf"
  }
  simulation = SimulationParameters {
    parameters = [
      SimulationParameter {
        id = "icc-driver-enabled"
        quantity = .supplyCurrent
        typ = 425uA
        max = 2mA
        conditions = "no load, driver and receiver enabled (RE, DI = 0 V or VCC; DE = VCC), VCC=3.3 V +/-5 %, TAMB=TMIN to TMAX; receiver only (DE=0 V) is 300 uA typ"
        source = SimulationEvidence {
          url = "https://www.maxlinear.com/ds/sp3485.pdf"
          revision = "SP3485 datasheet Rev. 2.0.2 as printed in the page footers"
          location = "p. 3, Electrical Characteristics, SP3485 Power Requirements, Supply current no load row"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "theta-ja-nsoic8"
        quantity = .thetaJa
        typ = 128.4K/W
        conditions = "8-pin NSOIC package power dissipation"
        source = SimulationEvidence {
          url = "https://www.maxlinear.com/ds/sp3485.pdf"
          revision = "SP3485 datasheet Rev. 2.0.2 as printed in the page footers"
          location = "p. 2, Absolute Maximum Ratings / Operating Conditions"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "tj-absolute"
        quantity = .junctionAbsoluteTemperature
        max = 125degC
        conditions = "maximum junction temperature as printed in the absolute maximum ratings"
        source = SimulationEvidence {
          url = "https://www.maxlinear.com/ds/sp3485.pdf"
          revision = "SP3485 datasheet Rev. 2.0.2 as printed in the page footers"
          location = "p. 2, Absolute Maximum Ratings"
          confidence = .datasheet
        }
      },
    ]
  }
}

/// The support circuit of the SP3485EN-L/TR as its datasheet shows it (pin function; electrical
/// characteristics (VCC = 3.3 V ± 5 %); typical half-duplex network): every part next to the pin
/// it serves. Add it next to the part: `U1 = SP3485.SP3485 { … }`, `U1Support = SP3485.Support(U1)
/// {}`.
///
/// - RE and DE are usually tied together and driven by one GPIO (high = transmit); RO to the UART
/// RX, DI to its TX.
///
/// - Terminate the bus at its two ends only, 120 ohm across A-B.
block Support {
  /// The SP3485EN-L/TR this circuit serves (`SP3485.Support(U1)`).
  chip: Any

  /// X7R
  C1 = cap(100nF, package = "0402", dielectric = .X7R) {
    place = [soft(near(chip.pin.VCC, max = 2mm), weight = 2)]
    a -- chip.pin.VCC
    b -- chip.pin.GND
  }
  /// at each end of the bus only
  RT = res(120ohm, package = "0402") {
    place = [soft(near(chip.pin.A, max = 5mm), weight = 1)]
    a -- chip.pin.A
    b -- chip.pin.B
  }
}
