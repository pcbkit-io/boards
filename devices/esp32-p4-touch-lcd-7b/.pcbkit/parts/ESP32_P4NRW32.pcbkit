let Y1Crystal = crystal(40MHz, load = crystalLoad(10pF), package = "3225")

/// The support circuit of the ESP32-P4NRW32 as its datasheet shows it (ESP32-P4 Hardware Design
/// Guidelines, 2 Schematic Checklist (power, crystal, flash, chip enable); datasheet 2.6 Power
/// Supply): every part next to the pin it serves. Add it next to the part: `U1 = ESP32_P4NRW32.Part
/// { … }`, `U1Support = ESP32_P4NRW32.Support(U1) {}`.
///
/// - VDD_HP_0/2/3 (1.1 V) come from an external step-down converter that EN_DCDC switches on and
/// whose feedback FB_DCDC trims: give the block its output (vddHp).
///
/// - VDD_PSRAM_0/1 run from VDDO_PSRAM (the in-package PSRAM's 1.9 V LDO); VDD_MIPI_DPHY from
/// VDDO_3 set to 2.5 V by the firmware.
///
/// - Route DSI and CSI lanes as 100 ohm differential pairs, the clock lane matched to its data
/// lanes; keep the 40 MHz crystal next to XTAL_P/N.
block Support {
  /// The ESP32-P4NRW32 this circuit serves (`ESP32_P4NRW32.Support(U1)`).
  chip: Any

  /// one per 3.3 V supply pin
  C_3V3_21 = cap(100nF, package = "0402", ratedVoltage = 3.3V) {
    place = [soft(near(chip["21"], max = 2mm), weight = 2)]
    a -- chip["21"]
    b -- chip.pin.GND
  }
  C_IO4 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_IO_4, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_IO_4
    b -- chip.pin.GND
  }
  C_IO5 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_IO_5, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_IO_5
    b -- chip.pin.GND
  }
  C_IO6 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_IO_6, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_IO_6
    b -- chip.pin.GND
  }
  C_LP = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_LP, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_LP
    b -- chip.pin.GND
  }
  C_BAT = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_BAT, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_BAT
    b -- chip.pin.GND
  }
  C_ANA = cap(10uF, package = "0805") {
    place = [soft(near(chip.pin.VDD_ANA, max = 4mm), weight = 2)]
    a -- chip.pin.VDD_ANA
    b -- chip.pin.GND
  }
  C_ANA2 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_ANA, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_ANA
    b -- chip.pin.GND
  }
  C_LDO = cap(10uF, package = "0805") {
    place = [soft(near(chip.pin.VDD_LDO, max = 4mm), weight = 2)]
    a -- chip.pin.VDD_LDO
    b -- chip.pin.GND
  }
  C_DCDCC = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_DCDCC, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_DCDCC
    b -- chip.pin.GND
  }
  C_USB = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_USBPHY, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_USBPHY
    b -- chip.pin.GND
  }
  C_FLASHIO = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_FLASHIO, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_FLASHIO
    b -- chip.pin.GND
  }
  C_HP0 = cap(10uF, package = "0805") {
    place = [soft(near(chip.pin.VDD_HP_0, max = 4mm), weight = 2)]
    a -- chip.pin.VDD_HP_0
    b -- chip.pin.GND
  }
  C_HP0B = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_HP_0, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_HP_0
    b -- chip.pin.GND
  }
  C_HP2 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_HP_2, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_HP_2
    b -- chip.pin.GND
  }
  C_HP3 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_HP_3, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_HP_3
    b -- chip.pin.GND
  }
  C_PSRAM0 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_PSRAM_0, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_PSRAM_0
    b -- chip.pin.GND
  }
  C_PSRAM1 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_PSRAM_1, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_PSRAM_1
    b -- chip.pin.GND
  }
  C_DPHY = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.VDD_MIPI_DPHY, max = 2mm), weight = 2)]
    a -- chip.pin.VDD_MIPI_DPHY
    b -- chip.pin.GND
  }
  C_VO1 = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.VDDO_FLASH, max = 2mm), weight = 2)]
    a -- chip.pin.VDDO_FLASH
    b -- chip.pin.GND
  }
  C_VO2 = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.VDDO_PSRAM, max = 2mm), weight = 2)]
    a -- chip.pin.VDDO_PSRAM
    b -- chip.pin.GND
  }
  C_VO3 = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.VDDO_3, max = 2mm), weight = 2)]
    a -- chip.pin.VDDO_3
    b -- chip.pin.GND
  }
  C_VO4 = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.VDDO_4, max = 2mm), weight = 2)]
    a -- chip.pin.VDDO_4
    b -- chip.pin.GND
  }
  chip.pin.VDDO_PSRAM -- chip.pin.VDD_PSRAM_0
  chip.pin.VDDO_PSRAM -- chip.pin.VDD_PSRAM_1
  chip.pin.VDDO_3 -- chip.pin.VDD_MIPI_DPHY
  chip.pin.VDD_HP_0 -- chip.pin.VDD_HP_2
  chip.pin.VDD_HP_0 -- chip.pin.VDD_HP_3
  /// ±10 ppm, CL 10 pF
  Y1 = Y1Crystal {
    place = [soft(near(chip, max = 4mm), weight = 2)]
    X1 -- chip.pin.XTAL_P
    X2 -- chip.pin.XTAL_N
    GND -- chip.pin.GND
  }
  Y1_C1 = cap(loadCapacitor(crystalLoad(10pF), stray = 3pF), package = "0402") {
    place = [soft(near(Y1.pin.X1, max = 2.5mm), weight = 2)]
    a -- chip.pin.XTAL_P
    b -- chip.pin.GND
  }
  Y1_C2 = cap(loadCapacitor(crystalLoad(10pF), stray = 3pF), package = "0402") {
    place = [soft(near(Y1.pin.X2, max = 2.5mm), weight = 2)]
    a -- chip.pin.XTAL_N
    b -- chip.pin.GND
  }
  R_PU = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.CHIP_PU, max = 5mm), weight = 1)]
    a -- chip.pin.CHIP_PU
    b -- chip.pin.VDD_ANA
  }
  /// RC delay: CHIP_PU rises after the supplies
  C_PU = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.CHIP_PU, max = 2mm), weight = 2)]
    a -- chip.pin.CHIP_PU
    b -- chip.pin.GND
  }
  /// 1%
  R_DSI = res(2kohm, package = "0402", tolerance = 1%) {
    place = [soft(near(chip.pin.DSI_REXT, max = 5mm), weight = 1)]
    a -- chip.pin.DSI_REXT
    b -- chip.pin.GND
  }
  /// 1%
  R_CSI = res(2kohm, package = "0402", tolerance = 1%) {
    place = [soft(near(chip.pin.CSI_REXT, max = 5mm), weight = 1)]
    a -- chip.pin.CSI_REXT
    b -- chip.pin.GND
  }
  /// 16 MiB quad SPI NOR flash, 3.3 V
  U_FLASH = W25Q128JVSIQ.Part {
    place = [soft(near(chip, max = 8mm), weight = 1)]

    nCS -- chip.pin.FLASH_CS
    nHOLD -- chip.pin.FLASH_HOLD
    nWP -- chip.pin.FLASH_WP
    CLK -- chip.pin.FLASH_CK
    DI -- chip.pin.FLASH_D
    DO -- chip.pin.FLASH_Q
    GND -- chip.pin.GND
    VCC -- chip.pin.VDD_FLASHIO
  }
  U_FLASH_support = W25Q128JVSIQ.Support {
    chip = U_FLASH
    ioPullUps = false
  }
}
