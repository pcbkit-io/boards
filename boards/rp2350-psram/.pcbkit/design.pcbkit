pcbkit 1

// Doom device 07: the bare RP2350A (two Cortex-M33 or two Hazard3 RISC-V cores, chosen by the
// image, 150 MHz, 520 KB SRAM) with a 16 MB W25Q128 on the QSPI chip select 0 and an 8 MB
// APS6404L PSRAM on QMI chip select 1 (GPIO8): both memory-mapped through the XIP cache, so Doom
// runs unmodified with its zone heap in PSRAM. A 2.0" 240 x 320 ST7789 IPS on SPI0, a microSD
// slot on SPI1, ten buttons, a MAX98357A I2S speaker amplifier, and a full LiPo power system:
// BQ24074 charger with power path (the game runs from USB with a flat or missing cell), a
// MAX17048 fuel gauge on I2C, a TLV75533 LDO enabled by the power switch. Flashing: UF2 over USB
// (BOOTSEL), or SWD. Four layers.

use "parts/RP2350A.pcbkit" as RP2350A
use "parts/W25Q128JVSIQ.pcbkit" as W25Q128JVSIQ
use "parts/APS6404L_3SQR.pcbkit" as APS6404L_3SQR
use "parts/ST7789_TFT_2_0.pcbkit" as ST7789_TFT_2_0
use "parts/DM3AT_SF_PEJM5.pcbkit" as DM3AT_SF_PEJM5
use "parts/MAX98357AETE.pcbkit" as MAX98357AETE
use "parts/BQ24074RGT.pcbkit" as BQ24074RGT
use "parts/MAX17048G.pcbkit" as MAX17048G
use "parts/TLV75533PDBV.pcbkit" as TLV75533PDBV
use "parts/JS102011SAQN.pcbkit" as JS102011SAQN
use "parts/S2B_PH_K_S.pcbkit" as S2B_PH_K_S

net VBUS { voltage = 5V }
net VSYS { voltage = 4.4V }
net VBAT { voltage = 4.2V }
net V3 { voltage = 3.3V }
net V1V1 { voltage = 1.1V }
net GND { voltage = 0V }
net LDO_EN, DP, DN, BOOTSEL, RUN, SWDIO, SWCLK
net QSPI_SCLK, QSPI_SD0, QSPI_SD1, QSPI_SD2, QSPI_SD3, QSPI_SS, PSRAM_CS
net SCK, MOSI, LCD_CS, LCD_DC, LCD_RST, LCD_BL
net SD_SCK, SD_MOSI, SD_MISO, SD_CS, SD_CD
net I2S_BCK, I2S_LRCK, I2S_DIN, SPK_P, SPK_N
net SDA, SCL, FUEL_ALRT
net UP, DOWN, LEFT, RIGHT, FIRE, USE, STRAFE_L, STRAFE_R, MENU, ENTER

board = Board {
  name = "doom-07-rp2350-psram"
  description = "RP2350A (Cortex-M33 / Hazard3) · 16 MB flash + 8 MB PSRAM · 2.0in ST7789 · BQ24074 + MAX17048"
  outline = rect(144mm, 64mm, radius = 6mm)
  layers = [signal(Cu.top), mixed(Cu.inner[1], label = "GND"), signal(Cu.inner[2]), signal(Cu.bottom)]
}

// ---- processor (back) --------------------------------------------------------------------------
U1 = RP2350A.Part {
  at = (72mm, 22mm)
  side = .bottom
  pins {
    IOVDD: V3, QSPI_IOVDD: V3, ADC_AVDD: V3, USB_OTP_VDD: V3, VREG_VIN: V3,
    DVDD: V1V1, VREG_FB: V1V1, GND: GND, VREG_PGND: GND,
    RUN: RUN, SWDIO: SWDIO, SWCLK: SWCLK,
    QSPI_SCLK: QSPI_SCLK, QSPI_SD0: QSPI_SD0, QSPI_SD1: QSPI_SD1, QSPI_SD2: QSPI_SD2, QSPI_SD3: QSPI_SD3, QSPI_SS: QSPI_SS,
    GPIO8: PSRAM_CS,
    GPIO18: SCK, GPIO19: MOSI, GPIO17: LCD_CS, GPIO16: LCD_DC, GPIO20: LCD_RST, GPIO21: LCD_BL,
    GPIO10: SD_SCK, GPIO11: SD_MOSI, GPIO12: SD_MISO, GPIO13: SD_CS, GPIO14: SD_CD,
    GPIO22: I2S_BCK, GPIO23: I2S_LRCK, GPIO24: I2S_DIN,
    GPIO6: SDA, GPIO7: SCL, GPIO29_ADC3: FUEL_ALRT,
    GPIO0: UP, GPIO1: DOWN, GPIO2: LEFT, GPIO3: RIGHT, GPIO4: FIRE, GPIO5: USE,
    GPIO9: STRAFE_L, GPIO15: STRAFE_R, GPIO25: MENU, GPIO26_ADC0: ENTER,
  }
}
// Raspberry Pi's minimal design: decoupling, the core switching regulator (L1, 3.3 uH), the
// 12 MHz crystal, the 27 ohm USB resistors, BOOTSEL through 1 kohm on QSPI_SS.
U1Support = RP2350A.Support(U1, connectorDP = DP, connectorDN = DN, bootsel = BOOTSEL) { side = .bottom }
SW11 = button("4.2x3.2") { side = .bottom; pins { a: BOOTSEL, b: GND } }
R1 = res(10kohm, package = "0402") { side = .bottom; pins { a: RUN, b: V3 } }
J3 = header(4) { side = .bottom; pins = [SWCLK, GND, SWDIO, RUN] }

// ---- memory (back): flash on CS0, PSRAM on QMI CS1 sharing SCLK and SD0-SD3 ------------------------
U2 = W25Q128JVSIQ.Part {
  side = .bottom
  pins { nCS: QSPI_SS, CLK: QSPI_SCLK, DI: QSPI_SD0, DO: QSPI_SD1, nWP: QSPI_SD2, nHOLD: QSPI_SD3, VCC: V3, GND: GND }
}
U2Support = W25Q128JVSIQ.Support(U2, csPullUp = false, ioPullUps = false) { side = .bottom }
U3 = APS6404L_3SQR.Part {
  side = .bottom
  pins { CE: PSRAM_CS, SCLK: QSPI_SCLK, SIO0: QSPI_SD0, SIO1: QSPI_SD1, SIO2: QSPI_SD2, SIO3: QSPI_SD3, VDD: V3, VSS: GND }
}
U3Support = APS6404L_3SQR.Support(U3) { side = .bottom }

// ---- display (front) ----------------------------------------------------------------------------------
DS1 = ST7789_TFT_2_0.Part {
  at = (42mm, 32mm)
  rotation = 90deg
  pins { GND: GND, VCC: V3, SCL: SCK, SDA: MOSI, RES: LCD_RST, DC: LCD_DC, CS: LCD_CS, BLK: LCD_BL }
}

// ---- storage (back, right edge) --------------------------------------------------------------------------
J4 = DM3AT_SF_PEJM5.Part {
  side = .bottom
  place = [edge(.right)]
  pins { DAT2: .nc, CD_DAT3: SD_CS, CMD: SD_MOSI, VDD: V3, CLK: SD_SCK, VSS: GND, DAT0: SD_MISO, DAT1: .nc, CD_A: SD_CD, CD_B: GND, SH: GND }
}
R2 = res(10kohm, package = "0402") { side = .bottom; pins { a: SD_CD, b: V3 } }
R3 = res(10kohm, package = "0402") { side = .bottom; pins { a: SD_CS, b: V3 } }
R4 = res(10kohm, package = "0402") { side = .bottom; pins { a: SD_MISO, b: V3 } }
C1 = cap(10uF, package = "0603") { side = .bottom; pins { a: V3, b: GND } }

// ---- audio (back) ---------------------------------------------------------------------------------------
U5 = MAX98357AETE.Part {
  side = .bottom
  pins { BCLK: I2S_BCK, LRCLK: I2S_LRCK, DIN: I2S_DIN, VDD: VSYS, GND: GND, EP: GND, GAIN_SLOT: .nc, OUTP: SPK_P, OUTN: SPK_N, NC5: .nc, NC6: .nc, NC12: .nc, NC13: .nc }
}
U5Support = MAX98357AETE.Support(U5, vio = V3) { side = .bottom }
J5 = S2B_PH_K_S.Part { side = .bottom; pins { C1: SPK_N, C2: SPK_P } }

// ---- USB-C (front, bottom edge) ----------------------------------------------------------------------------
usb = UsbC2(vbus = VBUS, gnd = GND, dp = DP, dn = DN, tvsPackage = "SOD-323") {}
override usb.power.J.at = (72mm, 8.15mm)

// ---- power (back): BQ24074 power path, the cell, the gauge, the 3.3 V LDO -----------------------------------
U6 = BQ24074RGT.Part {
  side = .bottom
  // EN2 high, EN1 low: input current limit set by RILIM (about 1.4 A); charging always enabled.
  pins { IN: VBUS, OUT: VSYS, BAT: VBAT, VSS: GND, nCE: GND, EN2: VSYS, EN1: GND }
}
U6Support = BQ24074RGT.Support(U6) { side = .bottom }
J2 = S2B_PH_K_S.Part { side = .bottom; pins { C1: GND, C2: VBAT } }
U7 = MAX17048G.Part { side = .bottom; pins { VDD: VBAT, CELL: VBAT, GND: GND, CTG: GND, EP: GND, QSTRT: GND, SDA: SDA, SCL: SCL, ALRT: FUEL_ALRT } }
U7Support = MAX17048G.Support(U7) { side = .bottom }
i2c = I2cPullups(sda = SDA, scl = SCL, vcc = V3, speed = 400kHz) { side = .bottom }
R5 = res(10kohm, package = "0402") { side = .bottom; pins { a: FUEL_ALRT, b: V3 } }
U4 = TLV75533PDBV.Part { side = .bottom; pins { IN: VSYS, OUT: V3, GND: GND, EN: LDO_EN } }
U4Support = TLV75533PDBV.Support(U4, alwaysOn = false) { side = .bottom }
R6 = res(100kohm, package = "0402") { side = .bottom; pins { a: LDO_EN, b: GND } }
SW12 = JS102011SAQN.Part { at = (20mm, 61.2mm); rotation = 180deg; pins { A: VSYS, COM: LDO_EN, B: GND } }

// ---- input (front) ------------------------------------------------------------------------------------------
part Btn = button("6x6")
SW1 = Btn { at = (16mm, 40mm); pins { a: UP, b: GND } }
SW2 = Btn { at = (16mm, 20mm); pins { a: DOWN, b: GND } }
SW3 = Btn { at = (6.5mm, 30mm); pins { a: LEFT, b: GND } }
SW4 = Btn { at = (25.5mm, 30mm); pins { a: RIGHT, b: GND } }
SW5 = Btn { at = (9mm, 52mm); pins { a: STRAFE_L, b: GND } }
SW6 = Btn { at = (9mm, 8mm); pins { a: STRAFE_R, b: GND } }
SW7 = Btn { at = (135mm, 34mm); pins { a: FIRE, b: GND } }
SW8 = Btn { at = (123mm, 24mm); pins { a: USE, b: GND } }
SW9 = Btn { at = (123mm, 47mm); pins { a: MENU, b: GND } }
SW10 = Btn { at = (135mm, 47mm); pins { a: ENTER, b: GND } }

H1 = hole("M2.5") { at = (25mm, 4mm) }
H2 = hole("M2.5") { at = (140mm, 4mm) }
H3 = hole("M2.5") { at = (4mm, 4mm + 56mm) }
H4 = hole("M2.5") { at = (140mm, 60mm) }

gndPour = pour(net = GND, layers = [Cu.top, Cu.inner[1], Cu.bottom]) {}

// Fine-pitch escape (QFN-60 at 0.4 mm): 0.15 mm tracks and gaps, 0.45 / 0.2 mm vias (standard
// 4-layer capabilities); supplies wider.
fineClass = NetClass { name = "fine"; trackWidth = 0.15mm; clearance = 0.15mm; viaDiameter = 0.45mm; viaDrill = 0.2mm; default = true }
supplyClass = NetClass { name = "supply"; trackWidth = 0.3mm; clearance = 0.15mm; viaDiameter = 0.6mm; viaDrill = 0.3mm; nets = [V3, VSYS, VBAT, VBUS, V1V1] }
routing = Routing { timeLimit = 180s }
rules = Rules { vias { minDiameter = 0.45mm; minDrill = 0.2mm } }
