pcbkit 1

// JS102011SAQN (C&K): Slide switch, SPDT, sub-miniature, right angle (actuator at the board edge),
// SMD with two locating pegs, 0.3 A 6 V DC: pins A, COM, B
// Compiled from the part sheet `parts/JS102011SAQN.json` (`parts.create`); status: checked.
// Datasheet: https://datasheet.lcsc.com/datasheet/pdf/facc684708fd3febef29363c3f43748d.pdf (C&K JS
// Series Sub-Miniature Slide Switches catalog pages I-49 to I-60, dated 29 jun 16: p. I-52 right
// angle surface mount (JS102011SAQN), p. I-49 specifications)
// Pins: C&K JS Series Sub-Miniature Slide Switches catalog pages I-49 to I-60, dated 29 jun 16, p.
// I-52: JS102011SAQN drawing (terminal No. 1, body 9.0 x 3.6 x 3.5, actuator 2.0 out), PCB mount -
// hole layout, circuit diagram (2 = C, common); p. I-49 specifications
// Footprint: as given
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: SPDT: COM joins A in one position and B in the other. As an on/off switch: COM to the load
// (a regulator's input or EN), A to the supply, B unconnected (or to GND to pull EN down when
// off).
// Note: Rated 0.3 A at 6 V DC: switch a regulator's enable pin or a small load, not a motor or a
// LiPo's full current (use a MOSFET load switch driven by the slide switch for that).
// Note: Put it at the board edge with its front (-Y, the actuator) on the edge line; the pads lie
// behind the body (+Y).
// Note: The two 0.9 mm holes take the housing's plastic pegs: non-plated.

/// JS102011SAQN — Slide switch, SPDT, sub-miniature, right angle (actuator at the board edge),
/// SMD with two locating pegs, 0.3 A 6 V DC: pins A, COM, B
part Part = device(footprint = Footprint {
  let ps = [
    Pad { number = "1"; at = (-2.5mm, 2.75mm); shape = shape.rect(1.2mm, 2.5mm) },
    Pad { number = "2"; at = (0mm, 2.75mm); shape = shape.rect(1.2mm, 2.5mm) },
    Pad { number = "3"; at = (2.5mm, 2.75mm); shape = shape.rect(1.2mm, 2.5mm) },
    Pad {
      number = ""
      kind = .npth
      at = (-3.4mm, 0mm)
      drill = 0.9mm
      shape = shape.round(0.9mm)
    },
    Pad { number = ""; kind = .npth; at = (3.4mm, 0mm); drill = 0.9mm; shape = shape.round(0.9mm) },
  ]
  let b = box((-4.5mm, -1.8mm), (4.5mm, 1.8mm))
  name = "SW_Slide_SPDT_CK_JS102011SAQN_Horizontal"
  description = "C&K JS102011SAQN slide switch, SPDT, right angle SMD: pads 1 (A), 2 (COM), 3 (B) at 2.5 mm behind the body, two 0.9 mm peg holes 6.8 mm apart; the actuator stands 2 mm out of the front (-Y)"
  tags = ["switch", "slide switch", "SPDT", "SMD", "right angle"]
  pads = ps
  body = b
  height = 3.5mm
  mating = .down
  silk = silkOf(ps, b, 0.25mm, pin1 = (-2.5mm, 4.4mm))
  package = Package { family = .other; body = (9mm, 3.6mm); height = 3.5mm }
  solids = [
    solid.box((9mm, 3.6mm, 3.5mm), at = (0mm, 0mm, 0.3mm), radius = 0.2mm, material = .metal),
    solid.box((1.5mm, 2mm, 1.5mm), at = (-1mm, -2.8mm, 1.3mm), color = "#1a1a1a"),
  ]
}, prefix = "SW", mpn = "JS102011SAQN", manufacturer = "C&K", pinout = {
  A: "1",
  COM: "2",
  B: "3",
}, pinTypes = {
  A: .passive,
  COM: .passive,
  B: .passive,
}) with {
  fields {
    Status: "checked",
    PinoutSource: "C&K JS Series Sub-Miniature Slide Switches catalog pages I-49 to I-60, dated 29 jun 16, p. I-52: JS102011SAQN drawing (terminal No. 1, body 9.0 x 3.6 x 3.5, actuator 2.0 out), PCB mount - hole layout, circuit diagram (2 = C, common); p. I-49 specifications",
    Datasheet: "https://datasheet.lcsc.com/datasheet/pdf/facc684708fd3febef29363c3f43748d.pdf",
  }
}
