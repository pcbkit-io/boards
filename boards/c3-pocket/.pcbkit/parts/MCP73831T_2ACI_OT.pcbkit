pcbkit 1

// MCP73831T-2ACI/OT (Microchip Technology): Single-cell Li-Ion / Li-Po linear charger, 4.20 V,
// 15-500 mA set by one resistor, tri-state status output
// Compiled from the part sheet `parts/MCP73831T_2ACI_OT.json` (`parts.create`); status: checked.
// Datasheet:
// https://ww1.microchip.com/downloads/en/DeviceDoc/MCP73831-Family-Data-Sheet-DS20001984H.pdf
// (DS20001984H, 2020)
// Pins: MCP73831/2 datasheet DS20001984H, Table 3-1 (pin function tables), SOT-23-5 column
// Footprint: the standard package `SOT-23-5`
// Symbol: digikey-kicad d4bd68f42e6ccc474526811a853a03692e170b58
// dk_PMIC-Battery-Chargers:MCP73831T-2ACI_OT (CC-BY-SA-4.0),
// https://github.com/Digi-Key/digikey-kicad-library
// 3D model: kicad 10.0.7 Package_TO_SOT_SMD.3dshapes/SOT-23-5 (the model of
// Package_TO_SOT_SMD:SOT-23-5: the package `SOT-23-5`) (CC-BY-SA-4.0)
// Parameters: digikey-kicad d4bd68f42e6ccc474526811a853a03692e170b58
// dk_PMIC-Battery-Chargers:MCP73831T-2ACI_OT (CC-BY-SA-4.0),
// https://github.com/Digi-Key/digikey-kicad-library
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: VBAT needs at least 4.7 uF to stay stable without a battery.
// Note: At 500 mA from 5 V the SOT-23 dissipates up to about 0.6 W: thermal regulation lowers the
// current; give the pins copper.
// Note: The -2ACI option: 4.20 V regulation, 10% preconditioning, 7.5% end of charge, 96.5%
// recharge threshold (Product Identification System).

/// MCP73831T-2ACI/OT — Single-cell Li-Ion / Li-Po linear charger, 4.20 V, 15-500 mA set by one
/// resistor, tri-state status output
part Part = device(footprint = (sot23(5)) with {
  models = [Model3d { path = "Package_TO_SOT_SMD:SOT-23-5" }]
}, prefix = "U", mpn = "MCP73831T-2ACI/OT", manufacturer = "Microchip Technology", pinout = {
  STAT: "1",
  VSS: "2",
  VBAT: "3",
  VDD: "4",
  PROG: "5",
}, pinTypes = {
  STAT: .output,
  VSS: .ground,
  VBAT: io.powerOut(4.2V),
  VDD: io.powerIn(min = 4.5V, max = 7V),
  PROG: .passive,
}) with {
  fields {
    Status: "checked",
    PinoutSource: "MCP73831/2 datasheet DS20001984H, Table 3-1 (pin function tables), SOT-23-5 column",
    Datasheet: "https://ww1.microchip.com/downloads/en/DeviceDoc/MCP73831-Family-Data-Sheet-DS20001984H.pdf",
  }
  simulation = SimulationParameters {
    parameters = [
      SimulationParameter {
        id = "iss-charging"
        quantity = .quiescentCurrent
        typ = 510uA
        max = 1.5mA
        conditions = "Supply current ISS while charging; VDD = VREG + 1.0 V to 6 V, TA -40 to 85 degC, typical at 25 degC (charge complete, no battery: 53 uA typ; PROG floating: 25 uA typ)"
        source = SimulationEvidence {
          url = "https://ww1.microchip.com/downloads/en/DeviceDoc/MCP73831-Family-Data-Sheet-DS20001984H.pdf"
          revision = "DS20001984H, 2020"
          location = "p. 3, DC Characteristics, Supply Input, Supply Current row"
          confidence = .datasheet
        }
      },
    ]
  }
}

/// The support circuit of the MCP73831T-2ACI/OT as its datasheet shows it (p. 1, Typical
/// application (500 mA Li-Ion battery charger)): every part next to the pin it serves. Add it next
/// to the part: `U1 = MCP73831T_2ACI_OT.Part { … }`, `U1Support = MCP73831T_2ACI_OT.Support(U1)
/// {}`.
///
/// - Charge current IREG (mA) = 1000 / RPROG (kohm): 2 kohm 500 mA, 10 kohm 100 mA.
///
/// - The datasheet's front page wires the LED from VDD through 470 ohm into STAT (lit while
/// charging, STAT low); STAT can instead drive a microcontroller input with a pull-up.
block Support(
  /// The MCP73831T-2ACI/OT this circuit serves (`MCP73831T_2ACI_OT.Support(U1)`).
  chip: Any,
  /// The charge LED from VDD through 470 ohm into STAT.
  statusLed: Bool = true,
) {
  net LED_K
  /// 10V X7R
  CIN = cap(4.7uF, package = "0805", voltage = 10V, dielectric = .X7R) {
    place = [soft(near(chip.pin.VDD, max = 4mm), weight = 2)]
    pins { a: chip.pin.VDD, b: chip.pin.VSS }
  }
  /// 10V X7R
  COUT = cap(4.7uF, package = "0805", voltage = 10V, dielectric = .X7R) {
    place = [soft(near(chip.pin.VBAT, max = 4mm), weight = 2)]
    pins { a: chip.pin.VBAT, b: chip.pin.VSS }
  }
  /// 1% (500 mA; IREG = 1000 V / RPROG, 10 kohm for 100 mA)
  RPROG = res(2kohm, package = "0402", tolerance = 1pct) {
    place = [soft(near(chip.pin.PROG, max = 5mm), weight = 1)]
    pins { a: chip.pin.PROG, b: chip.pin.VSS }
  }
  /// on while charging
  LED1 =
    if statusLed then led(package = "0603", color = .red) {
      place = [soft(near(chip.pin.VDD, max = 5mm), weight = 1)]
      pins { A: chip.pin.VDD, K: LED_K }
    }
    else null
  RLED =
    if statusLed then res(470ohm, package = "0402") {
      place = [soft(near(chip.pin.STAT, max = 5mm), weight = 1)]
      pins { a: LED_K, b: chip.pin.STAT }
    }
    else null
}
