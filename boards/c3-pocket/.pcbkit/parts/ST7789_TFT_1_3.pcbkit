// MSP1308 1.3in 240x240 IPS SPI module (ST7789) (generic): 1.3" 240 x 240 IPS colour TFT module
// (ST7789), SPI without chip select, 3.3 V, on a 1x7 female header: GND VCC SCL SDA RES DC BLK;
// courtyard the 27.78 x 39.22 mm module lying over the board
// Compiled from the part sheet `parts/ST7789_TFT_1_3.json` (`parts.create`); status: checked.
// Datasheet: https://www.lcdwiki.com/1.3inch_IPS_Module (lcdwiki 1.3inch IPS Module SKU:MSP1308:
// interface definition and size picture (1.3inch_IPS_Size.jpg))
// Pins: lcdwiki MSP1308: pins 1 GND, 2 VCC (3.3 V), 3 SCL, 4 SDA, 5 RES, 6 DC, 7 BLK; size
// picture: PCB 27.78 x 39.22 mm, Ø2 mm holes 22.78 x 34.22 mm, header 2.50 mm from the top edge,
// first pin 6.27 mm from the left (centred)
// Footprint: as given
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: No chip select: the controller is always selected, so it cannot share the SPI bus; use SPI
// mode 3 (most drivers: `TFT_eSPI` / Adafruit ST7789 with CS = -1).
// Note: 3.3 V supply and logic only.

/// MSP1308 1.3in 240x240 IPS SPI module (ST7789) — 1.3" 240 x 240 IPS colour TFT module (ST7789),
/// SPI without chip select, 3.3 V, on a 1x7 female header: GND VCC SCL SDA RES DC BLK; courtyard
/// the 27.78 x 39.22 mm module lying over the board
part Part = device(footprint = moduleSocket(
  "TFT_1.3in_ST7789_Socket_1x07_P2.54mm",
  socketRow(1, 7, (-7.62mm, 0mm), (2.54mm, 0mm)),
  box((-13.89mm, -36.72mm), (13.89mm, 2.5mm)),
  description = "1.3 inch ST7789 IPS module on a 1x7 female header along its top edge, the display facing up over -Y: GND, VCC, SCL, SDA, RES, DC, BLK left to right",
  parts = 3mm,
  color = "#1d3f8c",
  module = displayPanel(
    box((-13.08mm, -31.72mm), (13.08mm, -2.5mm)),
    box((-11.7mm, -27.23mm), (11.7mm, -3.83mm)),
    1.5mm,
    glass = 0.4mm,
    tape = 0.3mm,
  ),
), prefix = "U", mpn = "MSP1308 1.3in 240x240 IPS SPI module (ST7789)", manufacturer = "generic", pinout = {
  GND: "1",
  VCC: "2",
  SCL: "3",
  SDA: "4",
  RES: "5",
  DC: "6",
  BLK: "7",
}, pinTypes = {
  GND: .ground,
  VCC: io.powerIn(min = 3V, max = 3.6V),
  SCL: io.input(),
  SDA: io.input(),
  RES: io.input(),
  DC: io.input(),
  BLK: io.input(),
}) with {
  fields {
    Status: "checked",
    PinoutSource: "lcdwiki MSP1308: pins 1 GND, 2 VCC (3.3 V), 3 SCL, 4 SDA, 5 RES, 6 DC, 7 BLK; size picture: PCB 27.78 x 39.22 mm, Ø2 mm holes 22.78 x 34.22 mm, header 2.50 mm from the top edge, first pin 6.27 mm from the left (centred)",
    Datasheet: "https://www.lcdwiki.com/1.3inch_IPS_Module",
  }
}
