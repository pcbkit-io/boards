pcbkit 1

// IP5306 (Injoinic Technology): Power bank SoC: 2.1 A switching Li-ion charger from 5 V and a 5.1
// V 2.1 A boost on one inductor, power path, 1-4 LED fuel gauge, push button, flashlight driver,
// eSOP-8
// Compiled from the part sheet `parts/IP5306.json` (`parts.create`); status: checked.
// Datasheet: https://datasheet.lcsc.com/datasheet/pdf/309666add984eaea02a8f06d99102496.pdf (IP5306
// datasheet V1.10 (Injoinic, 2016))
// Pins: Injoinic IP5306 datasheet V1.10: pin definition (eSOP8: 1 VIN, 2 LED1, 3 LED2, 4 LED3, 5
// KEY, 6 BAT, 7 SW, 8 VOUT, power pad GND), absolute maximum ratings, recommended operation
// conditions, electrical characteristics, package information
// Footprint: computed per IPC-7351B from the datasheet's package dimensions
// This file may be used, changed and shared without conditions, with the board or alone.

/// IP5306 — Power bank SoC: 2.1 A switching Li-ion charger from 5 V and a 5.1 V 2.1 A boost on
/// one inductor, power path, 1-4 LED fuel gauge, push button, flashlight driver, eSOP-8
part Part = device(footprint = rows(
  name = "SOIC-8-1EP_3.9x4.9mm_P1.27mm_EP2.09x2.09mm",
  description = "eSOP-8, 8 pins, 4.9 x 3.9 mm body, 1.27 mm pitch (from the datasheet)",
  pitch = 1.27mm,
  pinsY = 4,
  spanX = tolerance(5.8mm, 6.2mm),
  leadLength = tolerance(0.5mm, 0.8mm),
  leadWidth = tolerance(0.39mm, 0.48mm),
  bodyX = tolerance(3.7mm, 4.1mm),
  bodyY = tolerance(4.7mm, 5.1mm),
  bodyHeight = 1.65mm,
  exposedPad = (2.09mm, 2.09mm),
), prefix = "U", mpn = "IP5306", manufacturer = "Injoinic Technology", orderCode = "C181692", pinout = {
  VIN: "1",
  LED1: "2",
  LED2: "3",
  LED3: "4",
  KEY: "5",
  BAT: "6",
  SW: "7",
  VOUT: "8",
  GND: "9",
}, pinTypes = {
  VIN: io.powerIn(min = 4.75V, max = 5.5V),
  LED1: .passive,
  LED2: .passive,
  LED3: .passive,
  KEY: io.input(),
  BAT: io.powerIn(min = 3V, max = 4.4V),
  SW: .passive,
  VOUT: io.powerOut(5.1V),
  GND: .ground,
}) with {
  fields {
    Status: "checked",
    PinoutSource: "Injoinic IP5306 datasheet V1.10: pin definition (eSOP8: 1 VIN, 2 LED1, 3 LED2, 4 LED3, 5 KEY, 6 BAT, 7 SW, 8 VOUT, power pad GND), absolute maximum ratings, recommended operation conditions, electrical characteristics, package information",
    Datasheet: "https://datasheet.lcsc.com/datasheet/pdf/309666add984eaea02a8f06d99102496.pdf",
  }
  simulation = SimulationParameters {
    parameters = [
      SimulationParameter {
        id = "ivin-charging"
        quantity = .quiescentCurrent
        typ = 2mA
        conditions = "Controller input current while charging, VIN=5 V, fs=500 kHz, TA=25 degC, L=1 uH (standby with device not switching: 100 uA; boost battery operation current 3 mA at VBAT=3.7 V, VOUT=5.1 V)"
        source = SimulationEvidence {
          url = "https://datasheet.lcsc.com/datasheet/pdf/309666add984eaea02a8f06d99102496.pdf"
          revision = "IP5306 datasheet V1.10 (Injoinic, 2016)"
          location = "p. 5, Electrical Characteristics, Charger system, Input current (charging) row"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "tj-absolute"
        quantity = .junctionAbsoluteTemperature
        min = -40degC
        max = 150degC
        conditions = "Junction temperature TJ in the absolute maximum ratings table"
        source = SimulationEvidence {
          url = "https://datasheet.lcsc.com/datasheet/pdf/309666add984eaea02a8f06d99102496.pdf"
          revision = "IP5306 datasheet V1.10 (Injoinic, 2016)"
          location = "p. 4, Absolute maximum ratings"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "thetaja"
        quantity = .thetaJa
        typ = 40K/W
        conditions = "Thermal resistance from junction to ambient air, eSOP-8"
        source = SimulationEvidence {
          url = "https://datasheet.lcsc.com/datasheet/pdf/309666add984eaea02a8f06d99102496.pdf"
          revision = "IP5306 datasheet V1.10 (Injoinic, 2016)"
          location = "p. 4, Absolute maximum ratings"
          confidence = .datasheet
        }
      },
    ]
  }
}

/// The support circuit of the IP5306 as its datasheet shows it (p. 9, Figure 7 (4 LEDs SOC
/// indicator typical application schematic)): every part next to the pin it serves. Add it next to
/// the part: `U1 = IP5306.Part { … }`, `U1Support = IP5306.Support(U1) {}`.
///
/// - One inductor does both directions: charging steps 5 V on VIN down to the battery, discharging
/// steps the battery up to 5.1 V on VOUT; VIN passes to VOUT while charging.
///
/// - The datasheet's figure adds a flashlight LED from KEY through 20 ohm, and USB data-line
/// dividers (43k/75k, 51k/51k) so phones draw full current; leave out what you do not need.
///
/// - Heat leaves through the exposed pad: a GND pour with vias under it; keep SW - L1 - C2 and VOUT
/// - C3 loops short.
///
/// - Not placed by the support circuit, add it where the board needs it: D1_D4 4 LEDs between LED1,
/// LED2, LED3 (25/50/75/100 % gauge: D1 and D2 antiparallel between LED1 and LED2, D3 and D4
/// antiparallel between LED2 and LED3 (Figure 7)).
block Support(
  /// The IP5306 this circuit serves (`IP5306.Support(U1)`).
  chip: Any,
) {
  net C6_P, C7_P
  /// 10V
  C1 = cap(10uF, package = "0805", voltage = 10V) {
    place = [soft(near(chip.pin.VIN, max = 4mm), weight = 2)]
    pins { a: chip.pin.VIN, b: chip.pin.GND }
  }
  /// with C6: damps the input
  R3 = res(2ohm, package = "0402") {
    place = [soft(near(chip.pin.VIN, max = 5mm), weight = 1)]
    pins { a: chip.pin.VIN, b: C6_P }
  }
  C6 = cap(10uF, package = "0805") {
    place = [soft(near(chip, max = 8mm), weight = 1)]
    pins { a: C6_P, b: chip.pin.GND }
  }
  /// saturation above 4 A, low DCR
  L1 = inductor(1uH, package = "6") {
    place = [soft(near(chip.pin.SW, max = 5mm), weight = 1)]
    pins { a: chip.pin.SW, b: chip.pin.BAT }
  }
  /// 10V
  C2 = cap(22uF, package = "1206", voltage = 10V) {
    place = [soft(near(chip.pin.BAT, max = 4mm), weight = 2)]
    pins { a: chip.pin.BAT, b: chip.pin.GND }
  }
  /// with C7: damps the battery node
  R4 = res(2ohm, package = "0402") {
    place = [soft(near(chip.pin.BAT, max = 5mm), weight = 1)]
    pins { a: chip.pin.BAT, b: C7_P }
  }
  C7 = cap(10uF, package = "0805") {
    place = [soft(near(chip, max = 8mm), weight = 1)]
    pins { a: C7_P, b: chip.pin.GND }
  }
  /// 10V
  C3A = cap(22uF, package = "1206", voltage = 10V) {
    place = [soft(near(chip.pin.VOUT, max = 4mm), weight = 2)]
    pins { a: chip.pin.VOUT, b: chip.pin.GND }
  }
  /// 10V
  C3B = cap(22uF, package = "1206", voltage = 10V) {
    place = [soft(near(chip.pin.VOUT, max = 4mm), weight = 2)]
    pins { a: chip.pin.VOUT, b: chip.pin.GND }
  }
  /// 10V
  C3C = cap(22uF, package = "1206", voltage = 10V) {
    place = [soft(near(chip.pin.VOUT, max = 4mm), weight = 2)]
    pins { a: chip.pin.VOUT, b: chip.pin.GND }
  }
  /// through R1 10 kohm in the datasheet's figure
  S1 = button("6x6") { pins { a: chip.pin.KEY, b: chip.pin.GND } }
}
