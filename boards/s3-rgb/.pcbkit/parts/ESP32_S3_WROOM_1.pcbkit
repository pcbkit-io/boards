/// The support circuit of the ESP32-S3-WROOM-1-N16R8 as its datasheet shows it (9 Peripheral
/// Schematics (p. 41)): every part next to the pin it serves. Add it next to the part: `U1 =
/// ESP32_S3_WROOM_1.Part { … }`, `U1Support = ESP32_S3_WROOM_1.Support(U1) {}`.
///
/// - EN RC delay (10 kohm to 3V3, 1 uF to GND) so the supply is stable before the chip starts; a
/// reset button may pull EN to GND.
///
/// - USB: IO19 = D-, IO20 = D+ straight to a USB connector (0 ohm or 22 ohm series resistors
/// optional); the ROM can flash over this USB port.
///
/// - Optional 32.768 kHz crystal on IO15/IO16 with 12 pF load capacitors.
block Support(
  /// The ESP32-S3-WROOM-1-N16R8 this circuit serves (`ESP32_S3_WROOM_1.Support(U1)`).
  chip: Any,
  /// A RESET button pulling EN to GND.
  resetButton: Bool = true,
  /// A BOOT button pulling IO0 to GND.
  bootButton: Bool = true,
) {
  /// 10V X5R, bulk at the 3V3 pin
  C1 = cap(22uF, package = "1206", voltage = 10V, dielectric = .X5R) {
    place = [soft(near(chip.pin.P3V3, max = 4mm), weight = 2)]
    pins { a: chip.pin.P3V3, b: chip.pin.GND }
  }
  C2 = cap(100nF, package = "0402") {
    place = [soft(near(chip.pin.P3V3, max = 2mm), weight = 2)]
    pins { a: chip.pin.P3V3, b: chip.pin.GND }
  }
  /// EN RC delay
  R1 = res(10kohm, package = "0402") {
    place = [soft(near(chip.pin.EN, max = 5mm), weight = 1)]
    pins { a: chip.pin.EN, b: chip.pin.P3V3 }
  }
  /// EN RC delay
  C3 = cap(1uF, package = "0402") {
    place = [soft(near(chip.pin.EN, max = 2mm), weight = 2)]
    pins { a: chip.pin.EN, b: chip.pin.GND }
  }
  SW1 = if resetButton then button("6x6") { pins { a: chip.pin.EN, b: chip.pin.GND } } else null
  /// held at reset: download mode
  SW2 = if bootButton then button("6x6") { pins { a: chip.pin.IO0, b: chip.pin.GND } } else null
}
