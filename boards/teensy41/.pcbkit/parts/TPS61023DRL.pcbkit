/// The support circuit of the TPS61023DRLR as its datasheet shows it (p. 12, Figure 8-1 (Li-ion
/// battery to 5 V boost converter)): every part next to the pin it serves. Add it next to the part:
/// `U1 = TPS61023DRL.Part { … }`, `U1Support = TPS61023DRL.Support(U1) {}`.
///
/// - VOUT = 0.595 V x (1 + R1 / R2); keep R2 under 300 kohm. 732k / 100k gives 5 V.
///
/// - One Li-ion cell (2.7-4.35 V) to 5 V at 1.5 A is the datasheet's example; when VIN rises above
/// the set output it passes VIN through.
///
/// - Keep the loop VIN capacitor - SW - VOUT capacitor - GND as small as possible; the output
/// capacitors right at VOUT and GND.
block Support(
  /// The TPS61023DRLR this circuit serves (`TPS61023DRL.Support(U1)`).
  chip: Any,
) {
  /// 10V X5R/X7R
  C1 = cap(10uF, package = "0805", ratedVoltage = 10V) {
    place = [soft(near(chip.pin.VIN, max = 4mm), weight = 2)]
    pins { a: chip.pin.VIN, b: chip.pin.GND }
  }
  /// saturation above the peak current (about 4.5 A for 5 V 1.5 A from 2.7 V)
  L1 = inductor(1uH, package = "6") {
    place = [soft(near(chip.pin.VIN, max = 5mm), weight = 1)]
    pins { a: chip.pin.VIN, b: chip.pin.SW }
  }
  /// 10V X5R/X7R
  C2A = cap(22uF, package = "1206", ratedVoltage = 10V) {
    place = [soft(near(chip.pin.VOUT, max = 4mm), weight = 2)]
    pins { a: chip.pin.VOUT, b: chip.pin.GND }
  }
  /// 10V X5R/X7R
  C2B = cap(22uF, package = "1206", ratedVoltage = 10V) {
    place = [soft(near(chip.pin.VOUT, max = 4mm), weight = 2)]
    pins { a: chip.pin.VOUT, b: chip.pin.GND }
  }
  /// 1% (5 V out)
  R1 = res(732kohm, package = "0402", tolerance = 1pct) {
    place = [soft(near(chip.pin.VOUT, max = 5mm), weight = 1)]
    pins { a: chip.pin.VOUT, b: chip.pin.FB }
  }
  /// 1%
  R2 = res(100kohm, package = "0402", tolerance = 1pct) {
    place = [soft(near(chip.pin.FB, max = 5mm), weight = 1)]
    pins { a: chip.pin.FB, b: chip.pin.GND }
  }
}
