pcbkit 1

// TPS61023DRLR (Texas Instruments): Synchronous boost converter, 0.5-5.5 V in (1.8 V to start),
// 2.2-5.5 V adjustable out, 3.7 A valley switch limit, 1 MHz, true output disconnect, SOT-563
// Compiled from the part sheet `parts/TPS61023DRL.json` (`parts.create`); status: checked.
// Datasheet: https://www.ti.com/lit/ds/symlink/tps61023.pdf (SLVSF14B, revised August 2020)
// Pins: TI TPS61023 datasheet SLVSF14B: pin functions (DRL), 6.1 absolute maximum ratings, 6.3
// recommended operating conditions, 6.5 electrical characteristics (VREF 595 mV, EN high 1.2 V)
// Footprint: the standard package `SOT-563 (DRL)`
// This file may be used, changed and shared without conditions, with the board or alone.

/// TPS61023DRLR — Synchronous boost converter, 0.5-5.5 V in (1.8 V to start), 2.2-5.5 V
/// adjustable out, 3.7 A valley switch limit, 1 MHz, true output disconnect, SOT-563
part Part = device(footprint = sot(
  "SOT-563",
), prefix = "U", mpn = "TPS61023DRLR", manufacturer = "Texas Instruments", pinout = {
  FB: "1",
  EN: "2",
  VIN: "3",
  GND: "4",
  SW: "5",
  VOUT: "6",
}, pinTypes = {
  FB: .passive,
  EN: io.input(max = 7V, high = 1.2V),
  VIN: io.powerIn(min = 0.5V, max = 7V),
  GND: .ground,
  SW: .passive,
  VOUT: .powerOut,
}) with {
  fields {
    Status: "checked",
    PinoutSource: "TI TPS61023 datasheet SLVSF14B: pin functions (DRL), 6.1 absolute maximum ratings, 6.3 recommended operating conditions, 6.5 electrical characteristics (VREF 595 mV, EN high 1.2 V)",
    Datasheet: "https://www.ti.com/lit/ds/symlink/tps61023.pdf",
  }
  simulation = SimulationParameters {
    parameters = [
      SimulationParameter {
        id = "thetaJa-standard"
        quantity = .thetaJa
        typ = 142.7K/W
        conditions = "DRL SOT563 6-pin package; Standard column; tabulated package thermal metric, not a guaranteed value for the application board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps61023.pdf"
          revision = "SLVSF14B, revised August 2020"
          location = "p. 4, section 6.4, Standard column"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "thetaJc-standard"
        quantity = .thetaJc
        typ = 55.7K/W
        conditions = "DRL SOT563 6-pin package; Standard column; tabulated package thermal metric, not a guaranteed value for the application board; case face unspecified"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps61023.pdf"
          revision = "SLVSF14B, revised August 2020"
          location = "p. 4, section 6.4, Standard column"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "thetaJb-standard"
        quantity = .thetaJb
        typ = 31K/W
        conditions = "DRL SOT563 6-pin package; Standard column; tabulated package thermal metric, not a guaranteed value for the application board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps61023.pdf"
          revision = "SLVSF14B, revised August 2020"
          location = "p. 4, section 6.4, Standard column"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "psiJt-standard"
        quantity = .psiJt
        typ = 1.4K/W
        conditions = "DRL SOT563 6-pin package; Standard column; tabulated package thermal metric, not a guaranteed value for the application board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps61023.pdf"
          revision = "SLVSF14B, revised August 2020"
          location = "p. 4, section 6.4, Standard column"
          confidence = .datasheet
        }
      },
      SimulationParameter {
        id = "psiJb-standard"
        quantity = .psiJb
        typ = 30.7K/W
        conditions = "DRL SOT563 6-pin package; Standard column; tabulated package thermal metric, not a guaranteed value for the application board"
        source = SimulationEvidence {
          url = "https://www.ti.com/lit/ds/symlink/tps61023.pdf"
          revision = "SLVSF14B, revised August 2020"
