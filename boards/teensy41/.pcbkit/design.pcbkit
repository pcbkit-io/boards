pcbkit 1

// Doom device 10: the most capable. A Teensy 4.1 (NXP i.MX RT1062, Cortex-M7 at 600 MHz with
// double-precision FPU, 1 MB tightly-coupled SRAM, 8 MB flash, a microSD socket on 4-bit SDIO,
// optional 8 MB PSRAM pads on FlexSPI2) runs Doom (and Doom II) at full speed from the WAD on
// its SD card. A 3.5" 320 x 480 ILI9488 with touch (MSP3520) on LPSPI4 by DMA, ten buttons, CD
// quality sound from SAI1 (I2S) into a PCM5102A DAC with a headphone jack and a PAM8403
// amplifier to a speaker. Power: two 18650 cells in parallel behind reverse-cell and DW01A
// protection, a BQ24075 power-path charger on its own USB-C, a MAX17048 fuel gauge, a TPS61023
// boost from the power path to 5 V into the Teensy's VIN through a Schottky (VIN and VUSB are
// joined on the Teensy). Firmware is loaded over the Teensy's micro-USB with Teensy Loader (its
// MKL02 bootloader chip). Four layers.

use "parts/TEENSY_41.pcbkit" as TEENSY_41
use "parts/ILI9488_TFT_3_5_TOUCH.pcbkit" as ILI9488_TFT_3_5_TOUCH
use "parts/PCM5102APWR.pcbkit" as PCM5102APWR
use "parts/PAM8403DR.pcbkit" as PAM8403DR
use "parts/SJ1_3525N.pcbkit" as SJ1_3525N
use "parts/MAX17048G.pcbkit" as MAX17048G
use "parts/TPS61023DRL.pcbkit" as TPS61023DRL
use "parts/S2B_PH_K_S.pcbkit" as S2B_PH_K_S
use "parts/KEYSTONE_1042.pcbkit" as Holder
use "parts/BQ24075RGT.pcbkit" as Charger
use "parts/DW01A.pcbkit" as Protection
use "parts/D_1N5819HW.pcbkit" as Schottky
use "parts/MSK12C02.pcbkit" as Slide
use "parts/AO3401A.pcbkit" as Pfet
use "parts/PCBKIT_LOGO.pcbkit" as Logo

// Power: USB-C 5 V into the charger; its power path (SYS: the input when there is one, else the
// cells) into the boost and the amplifier. The two cells in parallel (1S2P, 3.0-4.2 V) behind one
// protection circuit; the pack's minus is the board's ground.
net VBUS { voltage = 5V; current = 500mA }
// SYS feeds the boost (the Teensy and the screen, about 250 mA at 5 V) and the speaker amplifier.
net SYS { voltage = 5V; current = 600mA }
net BAT { voltage = 4.2V; current = 800mA }
net BAT_IN { voltage = 4.2V; current = 800mA }
net CELL_N { current = 800mA }
// The boost's 5 V: the Teensy at 600 MHz, its 3.3 V regulator for the screen and the DAC.
net V5 { voltage = 5V; current = 300mA }
net VIN { voltage = 4.6V; current = 300mA }
net V3 { voltage = 3.3V }
net GND { voltage = 0V }
// The DAC's own rails: its charge pump's negative supply and its digital core's LDO.
net DAC_VNEG { voltage = -3.3V }
net DAC_LDO { voltage = 1.8V; current = 10mA }
// The power paths: wide tracks, vias that carry an ampere.
powerClass = NetClass {
  name = "power"
  trackWidth = 0.6mm
  viaDiameter = 0.8mm
  viaDrill = 0.4mm
  nets = [VBUS, SYS, BAT, BAT_IN, CELL_N, V5, VIN]
}
net BOOST_EN, CHG_N, PG_N, CHG_LED, PG_LED, ISET, ILIM, TS
net SCK, MOSI, MISO, LCD_CS, LCD_DC, LCD_RST, LCD_BL, T_CS, T_IRQ
net I2S_BCK, I2S_LRCK, I2S_DIN, LINE_L, LINE_R, AMP_SD, SPK_P, SPK_N
net SDA, SCL, FUEL_ALRT
net UP, DOWN, LEFT, RIGHT, FIRE, USE, STRAFE_L, STRAFE_R, MENU, ENTER

board = Board {
  name = "doom-10-teensy41"
  description = "Teensy 4.1 (i.MX RT1062 Cortex-M7 600 MHz) · 3.5in ILI9488 touch · PCM5102A + PAM8403 · 2 x 18650, BQ24075 + MAX17048 + boost"
  outline = rect(172mm, 112mm, radius = 7mm)
  layers = [signal(Cu.top), power(Cu.inner[1], label = "GND"), signal(Cu.inner[2]), signal(Cu.bottom)]
}
laboratory = Laboratory { world = "input.js" }

// ---- processor (back): the Teensy on two 24-pin sockets, its USB end at the top edge ------------
// The program is doom/; the game's data, id Software's shareware DOOM1.WAD (free to share
// unmodified), is linked into its flash from where it is published.
U1 = TEENSY_41.Part with {
  simulation = TEENSY_41.Part.simulation with { behavior = TEENSY_41.Part.simulation.behavior with {
    firmware = "doom"
    data = { "DOOM1.WAD": FirmwareData {
      url = "https://raw.githubusercontent.com/Akbar30Bill/DOOM_wads/9b384dc68add3eb2f5eb7754654cafeeaea5103b/doom1.wad"
      sha256 = "1d7d43be501e67d927e415e0b8f3e29c3bf33075e859721816f652a526cac771"
      bytes = 4196020
    } }
  } }
} {
  at = (62mm, 80.4mm)
  rotation = 90deg
  side = .bottom
  // The two 1x24 sockets it plugs into (the module itself: a Teensy 4.1, bought separately).
  orderCode = "C41376163"
  pins {
    GND: GND, VIN: VIN, P3V3: V3,
    D13: SCK, D11: MOSI, D12: MISO, D10: LCD_CS, D9: LCD_DC, D8: LCD_RST, D6: LCD_BL, D5: T_CS, D4: T_IRQ,
    D21: I2S_BCK, D20: I2S_LRCK, D7: I2S_DIN, D26: AMP_SD,
    D18: SDA, D19: SCL, D25: FUEL_ALRT,
    D0: UP, D1: DOWN, D2: LEFT, D3: RIGHT, D14: FIRE, D15: USE, D16: STRAFE_L, D17: STRAFE_R, D22: MENU, D24: ENTER,
  }
}

// ---- display (front) ----------------------------------------------------------------------------------
DS1 = ILI9488_TFT_3_5_TOUCH.Part {
  at = (135mm, 78mm)
  rotation = 90deg
  // The 1x14 socket it plugs into (the module: an MSP3520, bought separately).
  orderCode = "C2905420"
  pins {
    VCC: V3, GND: GND, CS: LCD_CS, RESET: LCD_RST, DC: LCD_DC, SDI: MOSI, SCK: SCK, LED: LCD_BL, SDO: MISO,
    T_CLK: SCK, T_CS: T_CS, T_DIN: MOSI, T_DO: MISO, T_IRQ: T_IRQ,
  }
}
R1 = res(10kohm, package = "0402") { side = .bottom; orderCode = "C25744"; pins { a: T_CS, b: V3 } }
R2 = res(10kohm, package = "0402") { side = .bottom; orderCode = "C25744"; pins { a: T_IRQ, b: V3 } }
R3 = res(10kohm, package = "0402") { side = .bottom; orderCode = "C25744"; pins { a: LCD_CS, b: V3 } }

// ---- sound (back): SAI1 -> PCM5102A -> jack and PAM8403 -> speaker ---------------------------------------
U2 = PCM5102APWR.Part {
  side = .bottom
  orderCode = "C107671"
  pins {
    AVDD: V3, CPVDD: V3, DVDD: V3, AGND: GND, CPGND: GND, DGND: GND, VNEG: DAC_VNEG, LDOO: DAC_LDO,
    BCK: I2S_BCK, LRCK: I2S_LRCK, DIN: I2S_DIN, SCK: GND, FLT: GND, DEMP: GND, FMT: GND, XSMT: V3,
  }
}
U2Support = PCM5102APWR.Support(U2, lineL = LINE_L, lineR = LINE_R) { side = .bottom }
J1 = SJ1_3525N.Part {
  side = .bottom
  orderCode = "C4991936"
  place = [edge(.right)]
  pins { SLEEVE: GND, TIP: LINE_L, RING: LINE_R, TIP_SW: .nc, RING_SW: .nc }
}
// PAM8403DR-H: the PAM8403DR with the same pins and SOP-16 package, the one JLCPCB stocks.
U3 = PAM8403DR.Part {
  side = .bottom
  orderCode = "C17337"
  pins { VDD: SYS, PVDD: SYS, GND: GND, PGND: GND, SHDN: AMP_SD, MUTE: .nc, OUTLP: SPK_P, OUTLN: SPK_N, OUTRP: .nc, OUTRN: .nc, NC: .nc }
}
U3Support = PAM8403DR.Support(U3, audioL = LINE_L) { side = .bottom }
// The speaker's plug (an 8 Ω, 1-2 W speaker with a JST PH lead, bought separately).
J5 = S2B_PH_K_S.Part { side = .bottom; orderCode = "C173752"; place = [edge(.left)]; pins { C1: SPK_N, C2: SPK_P } }

// ---- power: two 18650 cells on the back, side by side along the bottom, in parallel -------------
// The holders are not polarized: put each cell's + at the end the silkscreen marks. They sit
// right of the Teensy's column, so its microSD card comes out past them.
BT1 = Holder.Part { orderCode = "C5249310"; at = (118mm, 13mm); side = .bottom; pins { C2: BAT_IN, C1: CELL_N } }
BT2 = Holder.Part { orderCode = "C5249310"; at = (118mm, 35mm); side = .bottom; pins { C2: BAT_IN, C1: CELL_N } }
cellMarks = [
  Text { text = "+"; at = (71mm, 13mm); size = 2.5mm; layer = Silk.bottom },
  Text { text = "-"; at = (165mm, 13mm); size = 2.5mm; layer = Silk.bottom },
  Text { text = "+"; at = (71mm, 35mm); size = 2.5mm; layer = Silk.bottom },
  Text { text = "-"; at = (165mm, 35mm); size = 2.5mm; layer = Silk.bottom },
  Text { text = "2 x 18650 Li-ion 3.7 V"; at = (100mm, 49mm); size = 1.5mm; layer = Silk.bottom },
]

// A cell put in the wrong way round: a P-MOSFET in the plus line, its gate at the cells' minus,
// on (both ways: charging too) only when the cells are the right way round.
reversed = ReversePolarity(vin = BAT_IN, vout = BAT, gnd = CELL_N, inputVoltage = 4.2V, current = 800mA, rdsOn = 60mohm, maxGateVoltage = 12V, fet = Pfet.Part with { orderCode = "C15127" }) {}

// Protection: over-charge 4.3 V, over-discharge 2.4 V, over-current about 3 A, in the pack's minus.
U7 = Protection.Part { orderCode = "C351410"; pins { GND: CELL_N } }
U7Support = Protection.Support(U7, batteryPlus = BAT, packMinus = GND) {}

// USB-C for charging only (5.1 kΩ on CC: 500 mA from any source), a 1 A resettable fuse and a TVS.
usb = UsbCPower(vbus = VBUS, gnd = GND, fuseHold = 1A, tvsPackage = "SOD-323") {}
override usb.J.at = (20mm, 8.15mm)

// The charger (BQ24075, datasheet SLUS810): USB500 mode (EN1 high, EN2 low: at most 500 mA from
// any port), 800 mA fast charge (RISET = 890 AΩ / 0.8 A), its current-based termination; SYSOFF
// low (the cells always connected); the safety timers off (TMR to VSS): two cells charge longer
// than its longest timer. TS: 10 kΩ without an NTC.
U4 = Charger.Part {
  at = (32mm, 22mm)
  pins { IN: VBUS, OUT: SYS, BAT: BAT, VSS: GND, nCE: GND, EN1: SYS, EN2: GND, TMR: GND, ISET: ISET, ILIM: ILIM, SYSOFF: GND, TS: TS, nCHG: CHG_N, nPGOOD: PG_N }
}
cIn = cap(1uF, package = "0603", ratedVoltage = 16V) { orderCode = "C15849"; at = (33.55mm, 25mm); rotation = 180deg; place = [near(U4.pin.IN, max = 3.5mm)]; pins { a: VBUS, b: GND } }
cSys = cap(4.7uF, package = "0805", ratedVoltage = 10V) { orderCode = "C1779"; place = [soft(near(U4.pin.OUT, max = 4mm), weight = 2)]; pins { a: SYS, b: GND } }
cBat = cap(4.7uF, package = "0805", ratedVoltage = 10V) { orderCode = "C1779"; place = [soft(near(U4.pin.BAT, max = 4mm), weight = 2)]; pins { a: BAT, b: GND } }
rIset = res(1.13kohm, package = "0402", tolerance = 1pct) { orderCode = "C67014"; place = [soft(near(U4.pin.ISET, max = 5mm))]; pins { a: ISET, b: GND } }
rIlim = res(1.18kohm, package = "0402", tolerance = 1pct) { orderCode = "C270651"; place = [soft(near(U4.pin.ILIM, max = 5mm))]; pins { a: ILIM, b: GND } }
rTs = res(10kohm, package = "0402") { orderCode = "C25744"; place = [soft(near(U4.pin.TS, max = 5mm))]; pins { a: TS, b: GND } }
// Charging (red) and USB present (green), each through 1.5 kΩ.
ledChg = led(package = "0603", color = .red) { orderCode = "C2286"; at = (26mm, 34mm); pins { A: SYS, K: CHG_LED } }
rChg = res(1.5kohm, package = "0402") { orderCode = "C25867"; place = [soft(near(ledChg, max = 3mm))]; pins { a: CHG_LED, b: CHG_N } }
ledPg = led(package = "0603", color = .green) { orderCode = "C12624"; at = (36mm, 34mm); pins { A: SYS, K: PG_LED } }
rPg = res(1.5kohm, package = "0402") { orderCode = "C25867"; place = [soft(near(ledPg, max = 3mm))]; pins { a: PG_LED, b: PG_N } }
chargeLabel = Text { text = "CHG    USB"; at = (31mm, 37mm); size = 1mm }

// The fuel gauge on the cells (after the protection), on I2C with its alert line.
U5 = MAX17048G.Part { side = .bottom; orderCode = "C2682616"; pins { VDD: BAT, CELL: BAT, GND: GND, CTG: GND, EP: GND, QSTRT: GND, SDA: SDA, SCL: SCL, ALRT: FUEL_ALRT } }
U5Support = MAX17048G.Support(U5) { side = .bottom }
i2c = I2cPullups(sda = SDA, scl = SCL, vcc = V3, speed = 400kHz) { side = .bottom }
R4 = res(10kohm, package = "0402") { side = .bottom; orderCode = "C25744"; pins { a: FUEL_ALRT, b: V3 } }
// TPS61023: SYS (3.0-5 V) up to 5 V (the datasheet's 732k / 100k divider), switched by its EN.
// On the front, beside the charger: its ground straight into the front's pour.
U6 = TPS61023DRL.Part { at = (52mm, 22mm); orderCode = "C919459"; pins { VIN: SYS, VOUT: V5, GND: GND, EN: BOOST_EN } }
U6Support = TPS61023DRL.Support(U6) {}
R5 = res(1Mohm, package = "0402") { side = .bottom; orderCode = "C26083"; pins { a: BOOST_EN, b: GND } }
// On/off: the switch enables the boost (the Teensy off; the cells still charging when off).
SW12 = Slide.Part { at = (1.9mm, 50mm); rotation = 90deg; pins { A: SYS, COM: BOOST_EN, B: GND, SHELL: GND } }
switchLabel = Text { text = "ON / OFF"; at = (6mm, 54mm); size = 1mm; rotation = 90deg }
D1 = Schottky.Part { orderCode = "C82544"; side = .bottom; place = [soft(near(U1.pin.VIN, max = 15mm))]; pins { A: V5, K: VIN } }

// ---- input (front) ---------------------------------------------------------------------------------------------
// A tactile switch that pulls its line to ground, operated by `code` while the device runs.
fn key(code: String): Part = button("6x6") with {
  orderCode = "C221880"
  simulation = SimulationParameters { behavior = Behavior { model = "button"; ports = { output: ["1"] }; key = code } }
}
SW1 = key("ArrowUp") { at = (20mm, 88mm); pins { a: UP, b: GND } }
SW2 = key("ArrowDown") { at = (20mm, 68mm); pins { a: DOWN, b: GND } }
SW3 = key("ArrowLeft") { at = (10mm, 78mm); pins { a: LEFT, b: GND } }
SW4 = key("ArrowRight") { at = (30mm, 78mm); pins { a: RIGHT, b: GND } }
SW5 = key("Comma") { at = (145mm, 102mm); pins { a: STRAFE_L, b: GND } }
SW6 = key("Period") { at = (158mm, 102mm); pins { a: STRAFE_R, b: GND } }
SW7 = key("KeyF") { at = (162mm, 81mm); pins { a: FIRE, b: GND } }
SW8 = key("Space") { at = (150mm, 71mm); pins { a: USE, b: GND } }
SW9 = key("KeyM") { at = (145mm, 54mm); pins { a: MENU, b: GND } }
SW10 = key("Enter") { at = (158mm, 54mm); pins { a: ENTER, b: GND } }

// Bring-up: the cells, the power path, 5 V, 3.3 V and ground on test pads.
tpBat = testPoint() { at = (136mm, 38mm); pins = [BAT] }
tpSys = testPoint() { at = (142mm, 38mm); pins = [SYS] }
tpV5 = testPoint() { at = (148mm, 38mm); pins = [V5] }
tpV3 = testPoint() { at = (154mm, 38mm); pins = [V3] }
tpGnd = testPoint() { at = (160mm, 38mm); pins = [GND] }
tpLabel = Text { text = "BAT SYS 5V 3V3 GND"; at = (148mm, 34.5mm); size = 1mm }

H1 = hole("M3") { at = (5mm, 5mm) }
H2 = hole("M3") { at = (167mm, 5mm) }
H3 = hole("M3") { at = (5mm, 107mm) }
H4 = hole("M3") { at = (167mm, 107mm) }

gndPour = pour(net = GND, layers = [Cu.top, Cu.inner[1], Cu.bottom]) {}

// PCBKit's mark and pcbkit.io, where the board has room.
logo = Logo.Part {}

override reversed.Rg.orderCode = "C25741"
override usb.J.orderCode = "C165948"
override usb.R1.orderCode = "C25905"
override usb.R2.orderCode = "C25905"
override usb.F.orderCode = "C20800"
override usb.D.orderCode = "C19224"
override U2Support.C1.orderCode = "C1525"
override U2Support.C2.orderCode = "C15850"
override U2Support.C3.orderCode = "C1525"
override U2Support.C4.orderCode = "C15850"
override U2Support.C5.orderCode = "C1525"
override U2Support.C6.orderCode = "C15850"
override U2Support.C7.orderCode = "C87994"
override U2Support.C8.orderCode = "C87994"
override U2Support.C9.orderCode = "C1525"
override U2Support.R1.orderCode = "C25117"
override U2Support.C10.orderCode = "C1531"
override U2Support.R2.orderCode = "C25117"
override U2Support.C11.orderCode = "C1531"
// The DAC's three supplies decoupled at their pins.
override U2Support.C1.place = [near(U2.pin.AVDD, max = 2.5mm)]
override U2Support.C3.place = [near(U2.pin.CPVDD, max = 2.5mm)]
override U2Support.C5.place = [near(U2.pin.DVDD, max = 2.5mm)]
override U3Support.C1.orderCode = "C52923"
override U3Support.C2.orderCode = "C52923"
override U3Support.C3.orderCode = "C52923"
override U3Support.C4.orderCode = "C12891"
override U3Support.C5.orderCode = "C52923"
override U5Support.C1.orderCode = "C1525"
override U6Support.C1.orderCode = "C15850"
override U6Support.L1.orderCode = "C96955"
override U6Support.C2A.orderCode = "C12891"
override U6Support.C2B.orderCode = "C12891"
override U6Support.R1.orderCode = "C137940"
override U6Support.R2.orderCode = "C25741"
override U6Support.C1.place = [near(U6.pin.VIN, max = 2mm)]
override i2c.Rsda.orderCode = "C25890"
override i2c.Rscl.orderCode = "C25890"
override U3Support.C6.orderCode = "C47339"
// The amplifier's supply pins (VDD 6, PVDD 4 and 13) decoupled each at its pin.
override U3Support.C1.place = [near(U3["6"], max = 2.5mm)]
override U3Support.C2.place = [near(U3["4"], max = 2.5mm)]
override U3Support.C3.place = [near(U3["13"], max = 2.5mm)]
