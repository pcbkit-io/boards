pcbkit 1

// Doom device 02: a Raspberry Pi Pico (RP2040, dual Cortex-M0+, 264 KB SRAM, 2 MB flash) on
// sockets behind a 2.42" 128 x 64 monochrome OLED (SSD1309, SPI), eight buttons, a piezo, two
// 18650 cells in parallel it charges from the Pico's micro-USB. The Pico's own buck-boost (RT6150)
// makes 3.3 V from anything between 1.8 and 5.5 V on VSYS, so the cells need no regulator of ours.
// Front (top): the OLED, the buttons, the charger. Back (bottom): the Pico, the cells, the piezo.

use "parts/RASPBERRY_PI_PICO.pcbkit" as RASPBERRY_PI_PICO
use "parts/SSD1309_SPI_2_42.pcbkit" as SSD1309_SPI_2_42
use "parts/GPC12075YB_5V.pcbkit" as GPC12075YB_5V
use "parts/KEYSTONE_1042.pcbkit" as Holder
use "parts/BQ24075RGT.pcbkit" as Charger
use "parts/DW01A.pcbkit" as Protection
use "parts/D_1N5819HW.pcbkit" as Schottky
use "parts/MSK12C02.pcbkit" as Slide
use "parts/AO3401A.pcbkit" as Pfet
use "parts/PCBKIT_LOGO.pcbkit" as Logo

// Power: USB 5 V (the Pico's VBUS) into the charger; its power path (SYS: the input when there
// is one, else the cells) through a Schottky into the Pico's VSYS, beside the Pico's own VBUS
// diode. The two cells in parallel (1S2P, 3.0-4.2 V) behind one protection circuit; the pack's
// minus is the board's ground.
net VBUS { voltage = 5V }
// SYS feeds the Pico (RP2040 at 270 MHz, flash) and the OLED: about 150 mA.
net SYS { voltage = 5V; current = 300mA }
net VSYS { voltage = 4.2V }
net BAT { voltage = 4.2V; current = 800mA }
net BAT_IN { voltage = 4.2V; current = 800mA }
net CELL_N { current = 800mA }
net V3 { voltage = 3.3V }
net GND { voltage = 0V }
// The power paths: wide tracks, vias that carry an ampere.
powerClass = NetClass {
  name = "power"
  trackWidth = 0.6mm
  viaDiameter = 0.8mm
  viaDrill = 0.4mm
  nets = [VBUS, SYS, VSYS, BAT, BAT_IN, CELL_N]
}
net PWR_EN, CHG_N, PG_N, CHG_LED, PG_LED, ISET, ILIM, TS
net SCK, MOSI, OLED_CS, OLED_DC, OLED_RES, BUZZ, BUZZ_R
net UP, DOWN, LEFT, RIGHT, FIRE, USE, STRAFE, MENU

board = Board {
  name = "doom-02-pico-oled"
  description = "RP2040 (Pico) · 2.42in 128x64 OLED · 8 buttons · 2 x 18650, USB charging"
  outline = rect(150mm, 100mm, radius = 6mm)
}
laboratory = Laboratory { world = "input.js" }

// The processor: a Pico on two 20-pin sockets on the back, USB end at the top edge (charging,
// and the firmware flashed over USB as a UF2: hold BOOTSEL while plugging in).
// The program is doom/ (rp2040-doom's engine); its data, rp2040-doom's compressed shareware WAD
// (DOOM1.WHX, id Software's data, free to share unmodified), is linked into the Pico's 2 MB flash.
U1 = RASPBERRY_PI_PICO.Part with {
  simulation = RASPBERRY_PI_PICO.Part.simulation with { behavior = RASPBERRY_PI_PICO.Part.simulation.behavior with {
    firmware = "doom"
    data = { "DOOM1.WHX": FirmwareData {
      url = "https://raw.githubusercontent.com/kilograham/rp2040-doom/29a453c980918a03e40fc8b69b024e7a3bdb5dc2/doom1.whx"
      sha256 = "87ea79020578fa2e72fc204f67ff2ce45bd73a266a369670da7a019028b0d893"
      bytes = 1800344
    } }
  } }
} {
  at = (75mm, 73.2mm)
  rotation = 0deg
  side = .bottom
  // The two 1x20 sockets it plugs into (the module itself: a Raspberry Pi Pico, bought separately).
  orderCode = "C2905423"
  pins {
    GND: GND, VSYS: VSYS, P3V3: V3, P3V3_EN: PWR_EN, VBUS: VBUS, RUN: .nc, ADC_VREF: .nc, AGND: GND,
    GP18: SCK, GP19: MOSI, GP17: OLED_CS, GP20: OLED_DC, GP21: OLED_RES,
    GP2: UP, GP3: DOWN, GP4: LEFT, GP5: RIGHT, GP6: FIRE, GP7: USE, GP8: STRAFE, GP9: MENU,
    GP15: BUZZ,
  }
}

// The screen on the front: its 1x7 socket at the left of the module, the glass to its right.
DS1 = SSD1309_SPI_2_42.Part {
  at = (41mm, 69mm)
  // The 1x7 socket it plugs into (the module: a 2.42" SSD1309 SPI OLED, bought separately).
  orderCode = "C2932672"
  pins { GND: GND, VCC: V3, SCL: SCK, SDA: MOSI, RES: OLED_RES, DC: OLED_DC, CS: OLED_CS }
}

// Two 18650 cells on the back, side by side along the bottom, in parallel. The holders are not
// polarized: put each cell's + at the end the silkscreen marks.
BT1 = Holder.Part { orderCode = "C5249310"; at = (75mm, 13mm); side = .bottom; pins { C2: BAT_IN, C1: CELL_N } }
BT2 = Holder.Part { orderCode = "C5249310"; at = (75mm, 35mm); side = .bottom; pins { C2: BAT_IN, C1: CELL_N } }
cellMarks = [
  Text { text = "+"; at = (28mm, 13mm); size = 2.5mm; layer = Silk.bottom },
  Text { text = "-"; at = (122mm, 13mm); size = 2.5mm; layer = Silk.bottom },
  Text { text = "+"; at = (28mm, 35mm); size = 2.5mm; layer = Silk.bottom },
  Text { text = "-"; at = (122mm, 35mm); size = 2.5mm; layer = Silk.bottom },
  Text { text = "2 x 18650 Li-ion 3.7 V"; at = (132mm, 24mm); size = 1.5mm; rotation = 90deg; layer = Silk.bottom },
]

// A cell put in the wrong way round: a P-MOSFET in the plus line, its gate at the cells' minus,
// on (both ways: charging too) only when the cells are the right way round.
reversed = ReversePolarity(vin = BAT_IN, vout = BAT, gnd = CELL_N, inputVoltage = 4.2V, current = 800mA, rdsOn = 60mohm, maxGateVoltage = 12V, fet = Pfet.Part with { orderCode = "C15127" }) {}

// Protection: over-charge 4.3 V, over-discharge 2.4 V, over-current about 3 A, in the pack's minus.
U2 = Protection.Part { orderCode = "C351410"; pins { GND: CELL_N } }
U2Support = Protection.Support(U2, batteryPlus = BAT, packMinus = GND) {}

// The charger (BQ24075, datasheet SLUS810): USB500 mode (EN1 high, EN2 low: at most 500 mA from
// any port), 800 mA fast charge (RISET = 890 AΩ / 0.8 A), its current-based termination; SYSOFF
// low (the cells always connected); the safety timers off (TMR to VSS): two cells charge longer
// than its longest timer. TS: 10 kΩ without an NTC.
U3 = Charger.Part {
  at = (75mm, 30mm)
  pins { IN: VBUS, OUT: SYS, BAT: BAT, VSS: GND, nCE: GND, EN1: SYS, EN2: GND, TMR: GND, ISET: ISET, ILIM: ILIM, SYSOFF: GND, TS: TS, nCHG: CHG_N, nPGOOD: PG_N }
}
cIn = cap(1uF, package = "0603", ratedVoltage = 16V) { orderCode = "C15849"; at = (76.55mm, 33mm); rotation = 180deg; place = [near(U3.pin.IN, max = 3.5mm)]; pins { a: VBUS, b: GND } }
cSys = cap(4.7uF, package = "0805", ratedVoltage = 10V) { orderCode = "C1779"; place = [soft(near(U3.pin.OUT, max = 4mm), weight = 2)]; pins { a: SYS, b: GND } }
cBat = cap(4.7uF, package = "0805", ratedVoltage = 10V) { orderCode = "C1779"; place = [soft(near(U3.pin.BAT, max = 4mm), weight = 2)]; pins { a: BAT, b: GND } }
rIset = res(1.13kohm, package = "0402", tolerance = 1pct) { orderCode = "C67014"; place = [soft(near(U3.pin.ISET, max = 5mm))]; pins { a: ISET, b: GND } }
rIlim = res(1.18kohm, package = "0402", tolerance = 1pct) { orderCode = "C270651"; place = [soft(near(U3.pin.ILIM, max = 5mm))]; pins { a: ILIM, b: GND } }
rTs = res(10kohm, package = "0402") { orderCode = "C25744"; place = [soft(near(U3.pin.TS, max = 5mm))]; pins { a: TS, b: GND } }
// Charging (red) and USB present (green), each through 1.5 kΩ.
ledChg = led(package = "0603", color = .red) { orderCode = "C2286"; at = (70mm, 40mm); pins { A: SYS, K: CHG_LED } }
rChg = res(1.5kohm, package = "0402") { orderCode = "C25867"; place = [soft(near(ledChg, max = 3mm))]; pins { a: CHG_LED, b: CHG_N } }
ledPg = led(package = "0603", color = .green) { orderCode = "C12624"; at = (80mm, 40mm); pins { A: SYS, K: PG_LED } }
rPg = res(1.5kohm, package = "0402") { orderCode = "C25867"; place = [soft(near(ledPg, max = 3mm))]; pins { a: PG_LED, b: PG_N } }
chargeLabel = Text { text = "CHG    USB"; at = (75mm, 43mm); size = 1mm }

// The power path into the Pico's VSYS, beside its own VBUS diode.
D1 = Schottky.Part { orderCode = "C82544"; place = [soft(near(U1.pin.VSYS, max = 15mm))]; pins { A: SYS, K: VSYS } }

// On/off: the switch holds the Pico's 3V3_EN low (its regulator off, the cells still charging).
SW9 = Slide.Part { at = (1.9mm, 30mm); rotation = 90deg; pins { COM: PWR_EN, A: GND, SHELL: GND } }
switchLabel = Text { text = "ON / OFF"; at = (6mm, 34mm); size = 1mm; rotation = 90deg }

// Sound: a passive piezo driven by PWM through a series resistor.
BZ1 = GPC12075YB_5V.Part { side = .bottom; orderCode = "C252948"; pins { A: BUZZ_R, B: GND } }
R1 = res(100ohm, package = "0805") { side = .bottom; orderCode = "C17408"; pins { a: BUZZ, b: BUZZ_R } }

// Input: a d-pad on the left, fire/use on the right, strafe and menu above them. Each button
// pulls its GPIO to ground; the RP2040's internal pull-ups hold them high.
// A tactile switch that pulls its line to ground, operated by `code` while the device runs.
fn key(code: String): Part = button("6x6") with {
  orderCode = "C221880"
  simulation = SimulationParameters { behavior = Behavior { model = "button"; ports = { output: ["1"] }; key = code } }
}
SW1 = key("ArrowUp") { at = (16mm, 80mm); pins { a: UP, b: GND } }
SW2 = key("ArrowDown") { at = (16mm, 58mm); pins { a: DOWN, b: GND } }
SW3 = key("ArrowLeft") { at = (7mm, 69mm); pins { a: LEFT, b: GND } }
SW4 = key("ArrowRight") { at = (25mm, 69mm); pins { a: RIGHT, b: GND } }
SW5 = key("KeyF") { at = (136mm, 74mm); pins { a: FIRE, b: GND } }
SW6 = key("Space") { at = (124mm, 64mm); pins { a: USE, b: GND } }
SW7 = key("KeyS") { at = (124mm, 86mm); pins { a: STRAFE, b: GND } }
SW8 = key("KeyM") { at = (140mm, 86mm); pins { a: MENU, b: GND } }

// Bring-up: the cells, the power path, 3.3 V and ground on test pads.
tpBat = testPoint() { at = (120mm, 44mm); pins = [BAT] }
tpSys = testPoint() { at = (126mm, 44mm); pins = [SYS] }
tpV3 = testPoint() { at = (132mm, 44mm); pins = [V3] }
tpGnd = testPoint() { at = (138mm, 44mm); pins = [GND] }
tpLabel = Text { text = "BAT SYS 3V3 GND"; at = (129mm, 40.5mm); size = 1mm }

// Four M3 holes for a back plate or a case.
H1 = hole("M3") { at = (5mm, 5mm) }
H2 = hole("M3") { at = (145mm, 5mm) }
H3 = hole("M3") { at = (5mm, 95mm) }
H4 = hole("M3") { at = (145mm, 95mm) }

gndPour = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}

// PCBKit's mark and pcbkit.io, where the board has room.
logo = Logo.Part {}

override reversed.Rg.orderCode = "C25741"
