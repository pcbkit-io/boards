pcbkit 1

// SC0915 (Raspberry Pi): Raspberry Pi Pico (RP2040) on two 20-pin female headers 0.7" apart (the
// through-hole socket variant), pins named as its pinout (GP0-GP28, VBUS, VSYS, 3V3, 3V3_EN, RUN,
// ADC_VREF, AGND); courtyard the 21 x 51 mm board with its USB end
// Compiled from the part sheet `parts/RASPBERRY_PI_PICO.json` (`parts.create`); status: checked.
// Datasheet: https://datasheets.raspberrypi.com/pico/pico-datasheet.pdf (Raspberry Pi Pico
// datasheet: Figure 2 pinout, Figure 3 dimensions, §2.1 pin descriptions)
// Pins: Raspberry Pi Pico datasheet, Figure 2 (pinout), Figure 4 (pin numbering), §2.1 (VBUS,
// VSYS, 3V3_EN, 3V3, ADC_VREF, AGND, RUN), Figure 3 (dimensions)
// Footprint: as given
// Parameters: librepcb 0.2.2 01115be9-a89c-4639-8d01-70a2cd5c5925 (CC0-1.0),
// https://github.com/LibrePCB-Libraries/RaspberryPi.lplib
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: GPIOs are 3.3 V and not 5 V tolerant. In PCBKit 3V3 is `P3V3`, 3V3_EN `P3V3_EN`.
// Note: Power: USB (VBUS → diode → VSYS), or 1.8-5.5 V into VSYS; a second supply into VSYS
// goes through its own Schottky diode. 3V3 can feed sensors (under 300 mA).
// Note: The three SWD debug pins at the bottom edge are not in the socket. Pico W, Pico 2 and Pico
// 2 W have the same header pinout.
// Note: The USB connector overhangs the top edge (+Y): put that end at the board edge.

/// SC0915 — Raspberry Pi Pico (RP2040) on two 20-pin female headers 0.7" apart (the through-hole
/// socket variant), pins named as its pinout (GP0-GP28, VBUS, VSYS, 3V3, 3V3_EN, RUN, ADC_VREF,
/// AGND); courtyard the 21 x 51 mm board with its USB end
part Part = device(footprint = moduleSocket(
  "Raspberry_Pi_Pico_Socket_2x20_P2.54mm_W17.78mm",
  concat(
    socketRow(1, 20, (-8.89mm, 24.13mm)),
    socketRow(21, 20, (8.89mm, -24.13mm), (0mm, 2.54mm)),
  ),
  box((-10.5mm, -25.5mm), (10.5mm, 26.8mm)),
  description = "Raspberry Pi Pico on two 1x20 female headers 17.78 mm apart, the USB end at +Y: pin 1 (GP0) top left, 1-20 down the left row, 21-40 up the right row (Raspberry Pi's numbering)",
  board = 1mm,
  color = "#2e7d32",
), prefix = "U", mpn = "SC0915", manufacturer = "Raspberry Pi", pinout = {
  GP0: "1",
  GP1: "2",
  GND: ["3", "8", "13", "18", "23", "28", "38"],
  GP2: "4",
  GP3: "5",
  GP4: "6",
  GP5: "7",
  GP6: "9",
  GP7: "10",
  GP8: "11",
  GP9: "12",
  GP10: "14",
  GP11: "15",
  GP12: "16",
  GP13: "17",
  GP14: "19",
  GP15: "20",
  GP16: "21",
  GP17: "22",
  GP18: "24",
  GP19: "25",
  GP20: "26",
  GP21: "27",
  GP22: "29",
  RUN: "30",
  GP26: "31",
  GP27: "32",
  AGND: "33",
  GP28: "34",
  ADC_VREF: "35",
  P3V3: "36",
  P3V3_EN: "37",
  VSYS: "39",
  VBUS: "40",
}, pinTypes = {
  GP0: io.bidirectional(),
  GP1: io.bidirectional(),
  GND: .ground,
  GP2: io.bidirectional(),
  GP3: io.bidirectional(),
  GP4: io.bidirectional(),
  GP5: io.bidirectional(),
  GP6: io.bidirectional(),
  GP7: io.bidirectional(),
  GP8: io.bidirectional(),
  GP9: io.bidirectional(),
  GP10: io.bidirectional(),
  GP11: io.bidirectional(),
  GP12: io.bidirectional(),
  GP13: io.bidirectional(),
  GP14: io.bidirectional(),
  GP15: io.bidirectional(),
  GP16: io.bidirectional(),
  GP17: io.bidirectional(),
  GP18: io.bidirectional(),
  GP19: io.bidirectional(),
  GP20: io.bidirectional(),
  GP21: io.bidirectional(),
  GP22: io.bidirectional(),
  RUN: io.input(pull = .up),
  GP26: io.bidirectional(),
  GP27: io.bidirectional(),
  AGND: .ground,
  GP28: io.bidirectional(),
  ADC_VREF: .passive,
  P3V3: io.powerOut(3.3V),
  P3V3_EN: io.input(pull = .up),
  VSYS: .passive,
  VBUS: io.powerOut(5V),
}) with {
  fields {
    Status: "checked",
    PinoutSource: "Raspberry Pi Pico datasheet, Figure 2 (pinout), Figure 4 (pin numbering), §2.1 (VBUS, VSYS, 3V3_EN, 3V3, ADC_VREF, AGND, RUN), Figure 3 (dimensions)",
    Datasheet: "https://datasheets.raspberrypi.com/pico/pico-datasheet.pdf",
  }
}
