  Polygon { points = [(78.564mm, 5.8mm), (79.252mm, 6.6mm), (79.167mm, 14.4mm), (78.367mm, 15.2mm), (76.664mm, 13.4mm), (76.919mm, 7.6mm)] },
  Polygon { points = [(78.367mm, 15.2mm), (77.55mm, 16.0mm), (69.75mm, 16.0mm), (69.063mm, 15.2mm), (71.056mm, 13.4mm), (76.664mm, 13.4mm)] },
  Polygon { points = [(69.063mm, 15.2mm), (68.391mm, 14.4mm), (69.568mm, 6.6mm), (70.384mm, 5.8mm), (71.739mm, 7.6mm), (71.056mm, 13.4mm)] },
  Polygon { points = [(81.436mm, 5.8mm), (82.107mm, 5.0mm), (88.815mm, 5.0mm), (89.616mm, 5.8mm), (88.261mm, 7.6mm), (83.081mm, 7.6mm)] },
  Polygon { points = [(89.616mm, 5.8mm), (90.432mm, 6.6mm), (91.609mm, 14.4mm), (90.937mm, 15.2mm), (88.944mm, 13.4mm), (88.261mm, 7.6mm)] },
  Polygon { points = [(90.937mm, 15.2mm), (90.25mm, 16.0mm), (82.45mm, 16.0mm), (81.633mm, 15.2mm), (83.336mm, 13.4mm), (88.944mm, 13.4mm)] },
  Polygon { points = [(81.633mm, 15.2mm), (80.833mm, 14.4mm), (80.748mm, 6.6mm), (81.436mm, 5.8mm), (83.081mm, 7.6mm), (83.336mm, 13.4mm)] },
  Polygon { points = [(91.653mm, 5.0mm), (93.889mm, 5.0mm), (96.15mm, 16.0mm), (93.343mm, 14.8mm)] },
  Polygon { points = [(98.877mm, 5.0mm), (101.113mm, 5.0mm), (104.175mm, 14.8mm), (101.95mm, 16.0mm)] },
  Polygon { points = [(96.15mm, 16.0mm), (95.482mm, 12.75mm), (97.183mm, 8.3mm), (97.971mm, 11.55mm)] },
  Polygon { points = [(101.95mm, 16.0mm), (97.971mm, 11.55mm), (97.183mm, 8.3mm), (101.042mm, 12.75mm)] },
  Polygon { points = [(58.459mm, 2.4mm), (101.541mm, 2.4mm), (100.224mm, 3.5mm), (59.776mm, 3.5mm)] },
]
cheat = Text { text = "IDDQD"; at = (140mm, 58mm); size = 1.5mm }
map = Text { text = "E1M1"; at = (20mm, 22mm); size = 1.5mm }
