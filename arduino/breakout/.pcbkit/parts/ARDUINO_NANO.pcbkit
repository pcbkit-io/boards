    D5: io.bidirectional(),
    D6: io.bidirectional(),
    D7: io.bidirectional(),
    D8: io.bidirectional(),
    D9: io.bidirectional(),
    D10: io.bidirectional(),
    D11: io.bidirectional(),
    D12: io.bidirectional(),
    D13: io.bidirectional(),
    P3V3: io.powerOut(3.3V),
    AREF: .passive,
    A0: io.bidirectional(),
    A1: io.bidirectional(),
    A2: io.bidirectional(),
    A3: io.bidirectional(),
    A4: io.bidirectional(),
    A5: io.bidirectional(),
    A6: .passive,
    A7: .passive,
    P5V: io.powerOut(5V),
    VIN: .passive,
  },
) with {
  fields {
    Status: "checked",
    PinoutSource: "Arduino Nano product reference manual (A000005), §5 connector pinout figure and tables (pin 27 5V, pin 30 VIN), §6 mechanical drawing",
    Datasheet: "https://docs.arduino.cc/resources/datasheets/A000005-datasheet.pdf",
  }
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "atmega328p"
      ports = {
        "ADC6": ["25"],
