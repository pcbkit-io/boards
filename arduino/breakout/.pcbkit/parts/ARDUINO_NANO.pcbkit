    A4: "23",
    A5: "24",
    A6: "25",
    A7: "26",
    P5V: "27",
    VIN: "30",
  },
  pinTypes = {
    D1: io.bidirectional(),
    D0: io.bidirectional(),
    RESET: io.input(pull = .up),
    GND: .ground,
    D2: io.bidirectional(),
    D3: io.bidirectional(),
