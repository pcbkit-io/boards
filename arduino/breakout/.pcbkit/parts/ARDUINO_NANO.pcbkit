pcbkit 1

// A000005 (Arduino): Arduino Nano (classic, ATmega328P, 5 V, 16 MHz) plugged into two 15-pin
// female headers 0.6" apart, pins named as its silkscreen; the courtyard is the Nano's 18 x 43.2
// mm board
// Compiled from the part sheet `parts/ARDUINO_NANO.json` (`parts.create`); status: checked.
// Datasheet: https://docs.arduino.cc/resources/datasheets/A000005-datasheet.pdf (Arduino Nano
// (A000005) product reference manual: §5 connector pinouts, §6 mechanical information (drawing
// 2020/11/19))
// Pins: Arduino Nano product reference manual (A000005), §5 connector pinout figure and tables
// (pin 27 5V, pin 30 VIN), §6 mechanical drawing
// Footprint: as given
// Symbol: librepcb 0.1.4 7f8cadda-e30b-43fc-87c4-04a9fe0f70d2 (CC0-1.0),
// https://github.com/LibrePCB-Libraries/Arduino.lplib
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: Pins by the Nano's silkscreen: D0-D13, A0-A7, 5V, 3V3, VIN, AREF, RESET, GND; the module
// joins the two GND and the two RESET pins inside. In PCBKit 5V is `P5V` and 3V3 `P3V3`.
// Note: Logic is 5 V: a 3.3 V part on D/A pins needs a level shifter (or a divider on its inputs).
// A6 and A7 are analog inputs only.
// Note: Power: USB, 7-12 V on VIN, or a regulated 5 V on 5V (not both 5V and USB from different
// supplies without a diode). Its 5V and 3V3 pins can feed small loads.
// Note: The USB connector is at +Y (overhanging the board about 1.5 mm): put that end at the board
// edge, or leave room for the cable. The ICSP header at the other end is not socketed.

/// A000005 — Arduino Nano (classic, ATmega328P, 5 V, 16 MHz) plugged into two 15-pin female
/// headers 0.6" apart, pins named as its silkscreen; the courtyard is the Nano's 18 x 43.2 mm board
part Part = device(
  footprint = moduleSocket(
    "Arduino_Nano_Socket_2x15_P2.54mm_W15.24mm",
    concat(
      socketRow(1, 15, (7.62mm, -17.78mm), (0mm, 2.54mm)),
      socketRow(16, 15, (-7.62mm, 17.78mm)),
    ),
    box((-9mm, -21.6mm), (9mm, 23.1mm)),
    description = "Arduino Nano on two 1x15 female headers 15.24 mm apart, its USB end at +Y (Arduino's drawing): pins 1-15 the right row from the bottom (D1/TX … D12), 16-30 the left row from the top (D13 … VIN)",
    color = "#0f6e8c",
    board = 1.6mm,
    parts = 4mm,
    module = [
      solid.box((7mm, 7mm, 1mm), at = (0mm, -2mm, 0mm), radius = 0.05mm, material = .epoxy),
      solid.box(
        (4.6mm, 11.4mm, 3.5mm),
        at = (0mm, -12.5mm, 0mm),
        radius = 1.5mm,
        material = .metal,
      ),
      solid.box((6mm, 3.5mm, 2mm), at = (0mm, 6.5mm, 0mm), radius = 0.3mm, color = "#e8e8e4"),
      solid.box((3mm, 1.6mm, 0.6mm), at = (0mm, 6.5mm, 2mm), radius = 0.3mm, color = "#1c1c1e"),
      solid.box((7.6mm, 9.3mm, 3.9mm), at = (0mm, 19.8mm, 0mm), radius = 0.2mm, material = .metal),
      solid.box(
        (1.6mm, 0.8mm, 0.6mm),
        at = (-6.2mm, 12mm, 0mm),
        material = .led,
        color = "#7dff9a",
      ),
      solid.box(
        (1.6mm, 0.8mm, 0.6mm),
        at = (-6.2mm, 10mm, 0mm),
        material = .led,
        color = "#ffb347",
      ),
      solid.box((1.6mm, 0.8mm, 0.6mm), at = (-6.2mm, 8mm, 0mm), material = .led, color = "#ffb347"),
      solid.box((1.6mm, 0.8mm, 0.6mm), at = (6.2mm, 12mm, 0mm), material = .led, color = "#ff6b5a"),
      solid.box((5.3mm, 5.3mm, 1.5mm), at = (0mm, 13mm, 0mm), radius = 0.05mm, material = .epoxy),
    ],
  ),
  prefix = "U",
  mpn = "A000005",
  manufacturer = "Arduino",
  pinout = {
    D1: "1",
    D0: "2",
    RESET: ["3", "28"],
    GND: ["4", "29"],
    D2: "5",
    D3: "6",
    D4: "7",
    D5: "8",
    D6: "9",
    D7: "10",
    D8: "11",
