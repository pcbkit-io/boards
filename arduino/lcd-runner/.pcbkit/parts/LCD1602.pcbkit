pcbkit 2

// 1602 16x2 character LCD module (HD44780 compatible) (generic): 16 x 2 character LCD module
// (HD44780 / ST7066U compatible, 4- or 8-bit parallel), 5 V, on a 1x16 female header along its top
// edge; courtyard the 80 x 36 mm module lying over the board
// Compiled from the part sheet `parts/LCD1602.json` (`parts.create`); status: checked.
// Datasheet: https://newhavendisplay.com/content/specs/NHD-0216K1Z-FL-YBW.pdf (Newhaven
// NHD-0216K1Z-FL-YBW product specification rev. 13 (11/09/2022): mechanical drawing (the standard
// 1602 outline), pin description, electrical characteristics)
// Pins: Newhaven NHD-0216K1Z-FL-YBW rev. 13: pin assignment (1 VSS, 2 VDD, 3 V0, 4 RS, 5 R/W, 6 E,
// 7-14 DB0-DB7, 15 A, 16 K), mechanical drawing (PCB 80.00 x 36.00 mm, P2.54 x 15 = 38.10, first
// pin 8.00 mm from the left edge, row 2.00 mm from the top edge, holes 75 x 31 mm, 13.2 mm max
// thick), VDD 4.5-5.5 V, VIH 0.7 VDD
// Footprint: as given
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: 4-bit mode needs six GPIOs: RS, E, DB4-DB7 (RW to VSS). Inputs read high from 0.7 VDD =
// 3.5 V: a 3.3 V controller is marginal on a 5 V LCD; `LCD1602_I2C` (the PCF8574 backpack) needs
// two wires.
// Note: Backlight: A to 5 V and K to GND; many modules have the series resistor on board (check
// the module, else 100-220 ohm in series with A).
// Note: The standard outline: PCB 80 x 36 mm, Ø2.5 mm holes 75 x 31 mm; pins on 2.54 mm, pin 1
// 8.00 mm from the left edge.

/// 1602 16x2 character LCD module (HD44780 compatible) — 16 x 2 character LCD module (HD44780 /
/// ST7066U compatible, 4- or 8-bit parallel), 5 V, on a 1x16 female header along its top edge;
/// courtyard the 80 x 36 mm module lying over the board
part LCD1602: Part {
  footprint = moduleSocket(
    "LCD_1602_Socket_1x16_P2.54mm",
    socketRow(1, 16, (-19.05mm, 0mm), (2.54mm, 0mm)),
    box((-27.05mm, -34.0mm), (52.95mm, 2.0mm)),
    description = "16x2 character LCD module on a 1x16 female header along its top edge, the display facing up over -Y: VSS, VDD, V0, RS, RW, E, DB0-DB7, A, K left to right",
    parts = 8.6mm,
    color = "#2c7a30",
    board = 1.6mm,
    spacer = 2.5mm,
    pins = true,
    module = modules.lcd1602(),
  )
  prefix = "U"
  mpn = "1602 16x2 character LCD module (HD44780 compatible)"
  manufacturer = "generic"
  pinout = {
    VSS = "1"
    VDD = "2"
    V0 = "3"
    RS = "4"
    RW = "5"
    E = "6"
    DB0 = "7"
