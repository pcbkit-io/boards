        "d5" = ["12"]
        "d6" = ["13"]
        "d7" = ["14"]
        "e" = ["6"]
        "power" = ["2", "1"]
        "rs" = ["4"]
        "rw" = ["5"]
        "v0" = ["3"]
      }
      parameters = {
        "columns" = 16
        "height_mm" = 11.5
        "offset_x_mm" = 12.95
        "offset_y_mm" = -16
        "rows" = 2
        "width_mm" = 56.2
      }
      height = 19.6mm
    }
    parameters = [
      SimulationParameter {
        id = "idd-logic"
        quantity = .supplyCurrent
        typ = 1mA
        max = 3mA
        conditions = "logic supply current into VDD (display and ST7066U controller, backlight off), VDD=5.0 V; the backlight is fed separately through LED+ (130 mA typ at 5.0 V, 156 mA max)"
        source = SimulationEvidence {
          url = "https://newhavendisplay.com/content/specs/NHD-0216K1Z-FL-YBW.pdf"
          revision = "NHD-0216K1Z-FL-YBW product specification, document revision 13 (11/09/2022)"
