    VSS = .ground
    VDD = io.powerIn(min = 4.5V, max = 5.5V)
    V0 = .passive
    RS = io.input(high = 0.7)
    RW = io.input(high = 0.7)
    E = io.input(high = 0.7)
    DB0 = io.bidirectional()
    DB1 = io.bidirectional()
    DB2 = io.bidirectional()
    DB3 = io.bidirectional()
    DB4 = io.bidirectional()
    DB5 = io.bidirectional()
    DB6 = io.bidirectional()
    DB7 = io.bidirectional()
    A = .passive
    K = .passive
  }
  fields {
    Status = "checked"
    PinoutSource = "Newhaven NHD-0216K1Z-FL-YBW rev. 13: pin assignment (1 VSS, 2 VDD, 3 V0, 4 RS, 5 R/W, 6 E, 7-14 DB0-DB7, 15 A, 16 K), mechanical drawing (PCB 80.00 x 36.00 mm, P2.54 x 15 = 38.10, first pin 8.00 mm from the left edge, row 2.00 mm from the top edge, holes 75 x 31 mm, 13.2 mm max thick), VDD 4.5-5.5 V, VIH 0.7 VDD"
    Datasheet = "https://newhavendisplay.com/content/specs/NHD-0216K1Z-FL-YBW.pdf"
  }
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "hd44780"
