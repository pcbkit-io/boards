pcbkit 2

// A magic drawing screen on an Arduino Nano: the left knob moves the pen across, the right one up
// and down, the button wipes the picture. A 0.96" OLED is the screen; the knobs are 10 kΩ pots
// read by the ADC. Power: the Nano's USB.

use ./parts/ARDUINO_NANO as ARDUINO_NANO
use ./parts/SSD1306_OLED_I2C as SSD1306_OLED_I2C
use ./parts/PTV09A_4020F_B103 as Pot

net V5 { voltage = 5V }
net GND { voltage = 0V }
net SDA, SCL, X, Y, WIPE

board = Board {
  name = "etch-a-sketch"
  description = "Arduino Nano · 0.96in I2C OLED · two knobs and a wipe button"
  outline = rect(90mm, 70mm, radius = 8mm)
  fab { mask = .red }
}

NANO = ARDUINO_NANO.Part with {
  simulation = ARDUINO_NANO.Part.simulation with {
    behavior = ARDUINO_NANO.Part.simulation.behavior with { firmware = "firmware" }
  }
} {
  at = (45mm, 22mm)
  rotation = 90deg
  side = .bottom
  P5V -- V5
  GND -- GND
  A4 -- SDA
  A5 -- SCL
  A0 -- X
  A1 -- Y
  D2 -- WIPE
}

DS1 = SSD1306_OLED_I2C.Part {
  at = (45mm, 64mm)
  GND -- GND
  VCC -- V5
  SCL -- SCL
  SDA -- SDA
}

// The knobs at the two bottom corners, their wipers into A0 and A1.
RV1 = Pot.Part {
  at = (12mm, 12mm)
  CCW -- GND
  W -- X
  CW -- V5
  MP -- GND
}
RV2 = Pot.Part {
  at = (78mm, 12mm)
  CCW -- GND
  W -- Y
  CW -- V5
  MP -- GND
}

SW1 = button("6x6") with {
  simulation = SimulationParameters {
    behavior = Behavior { model = "button", ports = { output = ["1"] }, key = "Space" }
  }
} {
  at = (45mm, 8mm)
  a -- WIPE
  b -- GND
}
wipeLabel = Text {
  text = "WIPE"
  at = (55mm, 8mm)
  size = 1.2mm
}

H1 = hole("M3") { at = (6mm, 64mm) }
H2 = hole("M3") { at = (84mm, 64mm) }

gndPour = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}
