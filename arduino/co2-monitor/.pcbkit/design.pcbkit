pcbkit 2

// A CO₂ monitor on an Arduino Nano: Sensirion's SCD40 measures CO₂ (photoacoustic), temperature
// and humidity every five seconds; a 0.96" OLED shows the concentration large with a graph of the
// last ten minutes, and a traffic light says when to open a window (green under 800 ppm, amber to
// 1400, red above, blinking past 2000). The sketch (firmware/) uses Sensirion's own SCD4x library
// and Adafruit's SSD1306. Power: the Nano's USB.

use ./parts/ARDUINO_NANO as ARDUINO_NANO
use ./parts/SSD1306_OLED_I2C as SSD1306_OLED_I2C
use ./parts/SCD40 as SCD40

net V5 { voltage = 5V }
net GND { voltage = 0V }
net SDA, SCL, GREEN, AMBER, RED, GREEN_K, AMBER_K, RED_K

board = Board {
  name = "co2-monitor"
  description = "Arduino Nano · Sensirion SCD40 · 0.96in I2C OLED · traffic light"
  outline = rect(90mm, 56mm, radius = 3mm)
}

NANO = ARDUINO_NANO.ARDUINO_NANO with {
  simulation = ARDUINO_NANO.ARDUINO_NANO.simulation with {
    behavior = ARDUINO_NANO.ARDUINO_NANO.simulation.behavior with { firmware = "firmware" }
  }
} {
  // Lengthwise along the bottom, its USB at the board's left edge.
  at = (24mm, 12mm)
  rotation = 90deg
  P5V -- V5
  GND -- GND
  A4 -- SDA
  A5 -- SCL
  D5 -- GREEN
  D6 -- AMBER
  D7 -- RED
}

DS1 = SSD1306_OLED_I2C.SSD1306_OLED_I2C {
  at = (68mm, 51.4mm)
  GND -- GND
  VCC -- V5
  SCL -- SCL
  SDA -- SDA
}

// The sensor where air moves past it, with its bulk and ceramic capacitors and the bus's pull-ups.
U1 = SCD40.SCD40 {
  at = (84mm, 12mm)
  VDD -- V5
  VDDH -- V5
  GND -- GND
  SDA -- SDA
  SCL -- SCL
}
U1Support = SCD40.Support { chip = U1 }

// The traffic light: each LED from its pin through 1 kΩ to ground (3 mA).
fn light(color: LedColor, index: Number) -> Part = led(package = "0805", color = color) with {
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "indicator"
      ports = { input = ["2"] }
      parameters = { color = index, milliamps = 3 }
    }
  }
}
D1 = light(.green, 0) {
  at = (8mm, 40mm)
  A -- GREEN
  K -- GREEN_K
}
D2 = light(.orange, 1) {
  at = (8mm, 34mm)
  A -- AMBER
  K -- AMBER_K
}
D3 = light(.red, 2) {
  at = (8mm, 28mm)
  A -- RED
  K -- RED_K
}
R1 = res(1kohm, package = "0603") {
  place = [soft(near(D1, max = 4mm))]
  a -- GREEN_K
  b -- GND
}
R2 = res(1kohm, package = "0603") {
  place = [soft(near(D2, max = 4mm))]
  a -- AMBER_K
  b -- GND
}
R3 = res(1kohm, package = "0603") {
  place = [soft(near(D3, max = 4mm))]
  a -- RED_K
  b -- GND
}
lightLabel = Text {
  text = "OPEN A WINDOW"
  at = (24mm, 46mm)
  size = 1.2mm
}
title = Text {
  text = "CO2 MONITOR"
  at = (24mm, 30mm)
  size = 1.5mm
}

H1 = hole("M3") { at = (4mm, 52mm) }
H2 = hole("M3") { at = (50mm, 4mm) }
H3 = hole("M3") { at = (86mm, 30mm) }
H4 = hole("M3") { at = (50mm, 30mm) }

gndPour = pour(net = GND, layers = [Cu.top, Cu.bottom]) {}
