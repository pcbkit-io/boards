pcbkit 1

// SSD1306 0.96in 128x64 I2C OLED module (generic (Solomon Systech SSD1306 controller)): 0.96" 128
// x 64 OLED display module (SSD1306, I2C address 0x3C) on a 1x4 female header: GND VCC SCL SDA;
// courtyard the 27.3 x 27.8 mm module lying over the board
// Compiled from the part sheet `parts/SSD1306_OLED_I2C.json` (`parts.create`); status: checked.
// Datasheet: https://cdn-shop.adafruit.com/datasheets/SSD1306.pdf (Solomon Systech SSD1306
// datasheet rev 1.1 (the controller; address 0x3C/0x3D); the 4-pin I2C module as its makers print
// it)
// Pins: the module's silkscreen as its makers print it (GND VCC SCL SDA); controller facts from
// Solomon Systech's SSD1306 datasheet
// Footprint: as given
// This file may be used, changed and shared without conditions, with the board or alone.

// Note: Two pin orders are sold: GND VCC SCL SDA (this part) and VCC GND SCL SDA
// (`SSD1306_OLED_I2C_VCC_FIRST`). Read the module's silkscreen before choosing: the wrong one puts
// the supply on ground.
// Note: I2C address 0x3C (0x3D with the module's address jumper moved). The bus needs pull-ups
// once: most modules have them; add `I2cPullups` when the bus has none.

/// SSD1306 0.96in 128x64 I2C OLED module — 0.96" 128 x 64 OLED display module (SSD1306, I2C
/// address 0x3C) on a 1x4 female header: GND VCC SCL SDA; courtyard the 27.3 x 27.8 mm module lying
/// over the board
part Part = device(
  footprint = moduleSocket(
    "OLED_0.96in_I2C_Socket_1x04_P2.54mm",
    socketRow(1, 4, (-3.81mm, 0mm), (2.54mm, 0mm)),
    box((-13.65mm, -26.3mm), (13.65mm, 1.5mm)),
    description = "0.96 inch I2C OLED module on a 1x4 female header along its top edge, the display facing up over -Y: GND, VCC, SCL, SDA left to right",
    parts = 1.5mm,
    color = "#1d3f8c",
    board = 1.6mm,
    spacer = 2.5mm,
    pins = true,
    module = modules.oled096(["GND", "VCC", "SCL", "SDA"], edge = 1.5mm),
  ),
  prefix = "U",
  mpn = "SSD1306 0.96in 128x64 I2C OLED module",
  manufacturer = "generic (Solomon Systech SSD1306 controller)",
  pinout = { GND: "1", VCC: "2", SCL: "3", SDA: "4" },
  pinTypes = {
    GND: .ground,
    VCC: io.powerIn(min = 3.3V, max = 5.5V),
    SCL: io.input(pull = .up),
    SDA: io.bidirectional(),
  },
) with {
  fields {
    Status: "checked",
    PinoutSource: "the module's silkscreen as its makers print it (GND VCC SCL SDA); controller facts from Solomon Systech's SSD1306 datasheet",
    Datasheet: "https://cdn-shop.adafruit.com/datasheets/SSD1306.pdf",
    I2cAddress: "0x3C",
  }
  simulation = SimulationParameters {
    behavior = Behavior {
      model = "ssd1306-i2c"
      ports = { "i2c": ["4", "3"], "power": ["2", "1"] }
      parameters = {
        "address": 60,
        "height_mm": 10.86,
        "offset_x_mm": 0,
        "offset_y_mm": -13.4,
        "width_mm": 21.74,
      }
      height = 14mm
    }
    parameters = []
  }
}
